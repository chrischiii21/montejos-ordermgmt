	}

	.custom-checkbox-container .checkmark:after {
		left: 5px;
		top: 2px;
		width: 4px;
		height: 8px;
		border: solid white;
		border-width: 0 2px 2px 0;
		transform: rotate(45deg);
	}

	/* Inputs */
	.form-row {
		display: flex;
		gap: 16px;
