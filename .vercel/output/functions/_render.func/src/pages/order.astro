		color: var(--text-muted);
		text-transform: uppercase;
		font-weight: 600;
	}

	.payment-box-body .val {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 6px;
	}

	.payment-box-body .val:last-child {
		margin-bottom: 0;
	}

	.payment-box-body .val.monospace {
		font-family: monospace;
		color: var(--accent-primary);
		font-size: 0.9rem;
	}

	.receipt-note {
		display: flex;
		gap: 12px;
		align-items: flex-start;
		background: rgba(16, 185, 129, 0.04);
		border: 1px solid rgba(16, 185, 129, 0.15);
		padding: 12px 16px;
		border-radius: 10px;
		font-size: 0.8rem;
		color: #10b981;
		line-height: 1.5;
		text-align: left;
	}

	.receipt-note .note-icon {
		flex-shrink: 0;
		margin-top: 2px;
	}
</style>

<script>
	import { createClient } from '@supabase/supabase-js';

	const supabase = createClient(
		import.meta.env.PUBLIC_SUPABASE_URL,
		import.meta.env.PUBLIC_SUPABASE_ANON_KEY
	);

	// 1. Script State
	interface OrderItem {
		name: string;
		quantity: number;
		price: number;
		total: number;
		customInclusions?: string[];
	}

	interface Order {
		id: string;
		date: string;
		customer: string;
		address: string;
		contact: string;
		deliveryDateTime: string;
		items: OrderItem[];
		total: number;
		downpayment: number;
		balance: number;
		status: 'Pending' | 'Preparing' | 'Completed' | 'Cancelled';
		fulfillmentType?: 'Pickup' | 'Meetup' | 'Delivery';
		deliveryFee?: number;
	}

	let currentOrder: Order | null = null;
	let currentStep = 1;

	const PACKAGE_INCLUSIONS: Record<string, string[]> = {
		"Set A Lechon Package": [
			"1 whole Lechon Baboy",
			"1 tray Buttered Shrimps",
			"100 pieces Lumpia Shanghai",
			"1 tray Chicken Cordon Bleu",
			"1 tray Special Bam-e",
			"1 tray Diniguan",
			"1 tray Spicy Buffalo Chicken"
		],
		"Set B Lechon Package": [
			"1 whole Lechon Baboy",
			"1 tray Buttered Shrimps",
			"150 pieces Lumpia Shanghai",
			"1 tray Chicken Cordon Bleu",
			"1 tray Special Bam-e",
			"1 tray Diniguan",
			"1 tray Spicy Buffalo Chicken",
			"1 tray Calamares"
		],
		"Set C Lechon Package": [
			"1 whole Lechon Baboy",
			"1 tray Buttered Shrimps",
			"200 pieces Lumpia Shanghai",
			"1 tray Chicken Cordon Bleu",
			"1 tray Special Bam-e",
			"1 tray Diniguan",
			"1 tray Spicy Buffalo Chicken",
			"1 tray Calamares",
			"1 tray Chicken Guisado"
		],
		"P1 Package": [
			"1 whole Lechon Manok",
			"30 pieces Pork Lumpia",
			"10 pieces Battered Chicken",
			"1/2 kilo Buttered Shrimps",
			"25 pieces Calamares",
			"Half tray Special Bam-i",
			"1 tray Chosen Dessert"
		],
		"P2 Package": [
			"3 kilos Lechon Belly",
			"30 pieces Pork Lumpia",
			"10 pieces Battered Chicken",
			"1/2 kilo Buttered Shrimps",
			"25 pieces Calamares",
			"Half tray Special Bam-i",
			"1 tray Chosen Dessert"
		],
		"P3 Package": [
			"4 kilos Lechon Belly",
			"40 pieces Pork Lumpia",
			"15 pieces Battered Chicken",
			"10 pieces Buffalo / Teriyaki Chicken",
			"3/4 kilo Buttered Shrimps",
			"40 pieces Calamares",
			"1 tray Special Bam-i",
			"1 tray Chosen Dessert"
		],
		"P4 Package": [
			"5 kilos Lechon Belly",
			"50 pieces Pork Lumpia",
			"20 pieces Battered Chicken",
			"15 pieces Buffalo / Teriyaki Chicken",
			"3/4 kilo Buttered Shrimps",
			"50 pieces Calamares",
			"1 tray Special Bam-i",
			"1 tray Chosen Dessert"
		],
		"P5 Package": [
			"6 kilos Lechon Belly",
			"70 pieces Pork Lumpia",
			"25 pieces Battered Chicken",
			"20 pieces Buffalo / Teriyaki Chicken",
			"1 kilo Buttered Shrimps",
			"60 pieces Calamares",
			"1 tray Special Bam-i",
			"1 tray Chosen Dessert"
		],
		"P6 Package": [
			"7 kilos Lechon Belly",
			"80 pieces Pork Lumpia",
			"30 pieces Battered Chicken",
			"25 pieces Buffalo / Teriyaki Chicken",
			"1 kilo Buttered Shrimps",
			"70 pieces Calamares",
			"1 tray Special Bam-i",
			"1 tray Chosen Dessert"
		]
	};

	function getInclusions(it: OrderItem): string[] | null {
		if (it.customInclusions && it.customInclusions.length > 0) {
			return it.customInclusions;
		}
		for (const key in PACKAGE_INCLUSIONS) {
			if (it.name.toLowerCase().includes(key.toLowerCase()) || 
				(key.startsWith('P') && it.name.toLowerCase().includes(key.toLowerCase().split(' ')[0] + ' package'))) {
				return PACKAGE_INCLUSIONS[key];
			}
		}
	}

	function checkAndTransitionOrderStatus(order: { id: string; status: string; delivery_date_time?: string; total?: any; downpayment?: any; balance?: any }) {
		if (order.status === 'Completed' || order.status === 'Cancelled') {
			return order.status;
		}
		const deliveryStr = order.delivery_date_time;
		if (!deliveryStr) return order.status;

		const deliveryTime = new Date(deliveryStr.replace(' ', 'T'));
		if (isNaN(deliveryTime.getTime())) return order.status;

		const now = new Date();
		const diffMs = deliveryTime.getTime() - now.getTime();
		const diffHours = diffMs / (1000 * 60 * 60);

		let newStatus = order.status;
		if (now >= deliveryTime) {
			newStatus = 'Completed';
		} else if (diffHours <= 4) {
			newStatus = 'Preparing';
		}

		if (newStatus !== order.status) {
			order.status = newStatus;
			
			supabase
				.from('orders')
				.update({ status: newStatus })
				.eq('id', order.id)
				.then(({ error }) => {
					if (error) {
						console.error(`Error auto-updating order status for ${order.id}:`, error.message);
					}
				});
		}

		return newStatus;
	}

	// Elements
	const errorScreen = document.getElementById('error-screen');
	const errorTitle = document.getElementById('error-title');
	const errorDesc = document.getElementById('error-desc');
	const portalWizard = document.getElementById('portal-wizard');

	// Step elements
	const step1Content = document.getElementById('step-1-content');
	const step2Content = document.getElementById('step-content-card'); // wait let's use the actual step 2 id
	const step2Section = document.getElementById('step-2-content');
	const step3Section = document.getElementById('step-3-content');

	// Indicator elements
	const step1Indicator = document.getElementById('step-1-indicator');
	const step2Indicator = document.getElementById('step-2-indicator');
	const step3Indicator = document.getElementById('step-3-indicator');
	const line1Indicator = document.getElementById('line-1-indicator');
	const line2Indicator = document.getElementById('line-2-indicator');

	// Checkbox & Navigation Step 1
	const verifyCheckbox = document.getElementById('verify-order-checkbox') as HTMLInputElement;
	const btnGotoStep2 = document.getElementById('btn-goto-step-2') as HTMLButtonElement;

	// Form & Navigation Step 2
	const customerInfoForm = document.getElementById('customer-info-form') as HTMLFormElement;
	const btnBacktoStep1 = document.getElementById('btn-backto-step-1');
	const custInputName = document.getElementById('cust-input-name') as HTMLInputElement;
	const custInputContact = document.getElementById('cust-input-contact') as HTMLInputElement;
	const custInputAddress = document.getElementById('cust-input-address') as HTMLTextAreaElement;
	const custInputDatetime = document.getElementById('cust-input-datetime') as HTMLInputElement;

	// Step 3 copy details
	const custOrderIdDisplay = document.getElementById('cust-order-id-display');

	// Load Order
	document.addEventListener('DOMContentLoaded', async () => {
		const urlParams = new URLSearchParams(window.location.search);
		const id = urlParams.get('id');

		if (!id) {
			showError('Invalid Link', 'No order identifier was found in the link. Please ask the food service owner for a correct link.');
			return;
		}

		// Fetch order + items from Supabase
		const { data, error } = await supabase
			.from('orders')
			.select('*, order_items(*)')
			.eq('id', id)
			.single();

		if (error || !data) {
			showError('Order Not Found', `We could not find any order ticket matching ID: #${id.replace('ORD-', '')}.`);
			return;
		}

		const currentStatus = checkAndTransitionOrderStatus(data);

		// Validate if expired
		if (currentStatus === 'Completed' || currentStatus === 'Cancelled') {
			showError('Order Link Expired', `This link has expired because Order #${id.replace('ORD-', '')} has already been marked as ${currentStatus.toUpperCase()}.`);
			return;
		}

		currentOrder = {
			id: data.id,
			date: data.date,
			customer: data.customer,
			address: data.address,
			contact: data.contact,
			deliveryDateTime: data.delivery_date_time ?? '',
			fulfillmentType: data.fulfillment_type ?? 'Delivery',
			status: currentStatus,
			total: parseFloat(data.total),
			downpayment: parseFloat(data.downpayment),
			balance: parseFloat(data.balance),
			deliveryFee: parseFloat(data.delivery_fee ?? 0),
			items: (data.order_items ?? []).map((it: any) => ({
				name: it.name,
				quantity: it.quantity,
				price: parseFloat(it.price),
				total: parseFloat(it.total),
				customInclusions: it.custom_inclusions ?? []
			}))
		};
		initializeWizard();
	});

	function showError(title: string, description: string) {
		if (errorScreen && errorTitle && errorDesc && portalWizard) {
			errorTitle.textContent = title;
			errorDesc.textContent = description;
			errorScreen.style.display = 'flex';
			portalWizard.style.display = 'none';
		}
	}

	function initializeWizard() {
		if (!currentOrder || !portalWizard) return;
		portalWizard.style.display = 'block';

		// Step 1: Render Items & Inclusions
		const itemsContainer = document.getElementById('customer-items-list');
		if (itemsContainer) {
			itemsContainer.innerHTML = currentOrder.items.map(it => {
				const inclusions = getInclusions(it);
				const inclusionsHtml = inclusions ? `
					<div class="item-inclusions">
						<div class="inclusions-title">Inclusions:</div>
						<ul class="inclusions-list">
							${inclusions.map(inc => `<li>${inc}</li>`).join('')}
						</ul>
					</div>
				` : '';
				return `
					<div class="summary-item-row">
						<div class="summary-item-content">
							<div style="display: flex; align-items: center; gap: 8px;">
								<span class="summary-item-qty">${it.quantity}x</span>
								<span class="summary-item-name">${it.name}</span>
							</div>
							<span class="summary-item-right">₱${it.total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
						</div>
						${inclusionsHtml}
					</div>
				`;
			}).join('');
		}

		// Render totals
		const custFulfillmentRow = document.getElementById('cust-fulfillment-row');
		const custFulfillmentType = document.getElementById('cust-fulfillment-type');
		const custSubtotalRow = document.getElementById('cust-subtotal-row');
		const custSubtotal = document.getElementById('cust-subtotal');
		const custDeliveryRow = document.getElementById('cust-delivery-row');
		const custDeliveryFee = document.getElementById('cust-delivery-fee');
		const custTotalBill = document.getElementById('cust-total-bill');
		const custDownpayment = document.getElementById('cust-downpayment');
		const custBalanceLabel = document.getElementById('cust-balance-label');
		const custBalance = document.getElementById('cust-balance');

		const deliveryFee = currentOrder.deliveryFee || 0;
		const subtotal = currentOrder.total - deliveryFee;
		const fulfillmentType = currentOrder.fulfillmentType || 'Delivery';

		if (custFulfillmentRow && custFulfillmentType) {
			custFulfillmentRow.style.display = 'flex';
			custFulfillmentType.textContent = fulfillmentType;
		}

		if (custSubtotalRow && custSubtotal) {
			custSubtotalRow.style.display = 'flex';
			custSubtotal.textContent = `₱${subtotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		}

		if (custDeliveryRow && custDeliveryFee) {
			custDeliveryRow.style.display = 'flex';
			custDeliveryFee.textContent = `₱${deliveryFee.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		}

		if (custTotalBill) custTotalBill.textContent = `₱${currentOrder.total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		if (custDownpayment) custDownpayment.textContent = `₱${currentOrder.downpayment.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		if (custBalance) custBalance.textContent = `₱${currentOrder.balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

		if (custBalanceLabel) {
			const type = currentOrder.fulfillmentType || 'Delivery';
			if (type === 'Pickup') {
				custBalanceLabel.textContent = 'Remaining Balance Upon Pickup';
			} else if (type === 'Meetup') {
				custBalanceLabel.textContent = 'Remaining Balance Upon Meetup';
			} else {
				custBalanceLabel.textContent = 'Remaining Balance Upon Delivery';
			}
		}

		// Configure address/delivery fields based on fulfillment type
		const addressGroup = document.getElementById('cust-address-group');
		const datetimeLabel = document.getElementById('cust-datetime-label');
		const isPickup = currentOrder.fulfillmentType === 'Pickup';

		if (addressGroup) {
			addressGroup.style.display = isPickup ? 'none' : 'block';
		}
		if (custInputAddress) {
			if (isPickup) {
				custInputAddress.removeAttribute('required');
			} else {
				custInputAddress.setAttribute('required', 'required');
			}
		}
		if (datetimeLabel) {
			datetimeLabel.textContent = isPickup ? 'Pickup Date & Time' : 'Delivery/Meetup Date & Time';
		}

		// Checkbox controller
		verifyCheckbox?.addEventListener('change', () => {
			if (btnGotoStep2) {
				btnGotoStep2.disabled = !verifyCheckbox.checked;
			}
		});

		// Navigation Step 1 -> 2
		btnGotoStep2?.addEventListener('click', () => {
			goToStep(2);
		});

		// Navigation Step 2 -> 1
		btnBacktoStep1?.addEventListener('click', () => {
			goToStep(1);
		});

		// Form Step 2 Submission
		customerInfoForm?.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!validateStep2Form()) return;

			// Save to currentOrder
			if (currentOrder) {
				currentOrder.customer = custInputName.value.trim();
				currentOrder.contact = custInputContact.value.trim();
				currentOrder.address = custInputAddress.value.trim();
				
				const rawDate = custInputDatetime.value;
				currentOrder.deliveryDateTime = rawDate.replace('T', ' ');

				// Save updated order to Supabase
				const { error: updateErr } = await supabase
					.from('orders')
					.update({
						customer: currentOrder.customer,
						contact: currentOrder.contact,
						address: currentOrder.address,
						delivery_date_time: currentOrder.deliveryDateTime
					})
					.eq('id', currentOrder.id);
				if (updateErr) {
					console.error('Failed to save customer details:', updateErr.message);
				}

				if (custOrderIdDisplay) {
					custOrderIdDisplay.textContent = currentOrder.id;
				}

				goToStep(3);
			}
		});

		// Setup Click to Copy for MoPs
		document.querySelectorAll('.btn-copy-mini').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const text = (e.currentTarget as HTMLButtonElement).getAttribute('data-copy');
				if (text) {
					navigator.clipboard.writeText(text).then(() => {
						const oldText = btn.textContent;
						btn.textContent = 'Copied!';
						btn.classList.add('copied');
						
						// Trigger premium browser notification if function exists
						setTimeout(() => {
							btn.textContent = oldText;
							btn.classList.remove('copied');
						}, 2000);
					});
				}
			});
		});
	}

	function goToStep(step: number) {
		currentStep = step;

		// Toggle sections visibility
		if (step1Content) step1Content.style.display = step === 1 ? 'flex' : 'none';
		if (step2Section) step2Section.style.display = step === 2 ? 'flex' : 'none';
		if (step3Section) step3Section.style.display = step === 3 ? 'flex' : 'none';

		// Toggle indicators
		if (step === 1) {
			step1Indicator?.classList.add('active');
			step1Indicator?.classList.remove('completed');
			step2Indicator?.classList.remove('active', 'completed');
			step3Indicator?.classList.remove('active', 'completed');
			line1Indicator?.classList.remove('completed');
			line2Indicator?.classList.remove('completed');
		} else if (step === 2) {
			step1Indicator?.classList.remove('active');
			step1Indicator?.classList.add('completed');
			step2Indicator?.classList.add('active');
			step2Indicator?.classList.remove('completed');
			step3Indicator?.classList.remove('active', 'completed');
			line1Indicator?.classList.add('completed');
			line2Indicator?.classList.remove('completed');
		} else if (step === 3) {
			step1Indicator?.classList.remove('active');
			step1Indicator?.classList.add('completed');
			step2Indicator?.classList.remove('active');
			step2Indicator?.classList.add('completed');
			step3Indicator?.classList.add('active');
			line1Indicator?.classList.add('completed');
			line2Indicator?.classList.add('completed');
		}
	}

	function validateStep2Form(): boolean {
		let isValid = true;

		// Receiver Name
		const nameGroup = custInputName.parentElement?.parentElement;
		if (!custInputName.value.trim()) {
			nameGroup?.classList.add('invalid');
			isValid = false;
		} else {
			nameGroup?.classList.remove('invalid');
		}

		// Contact Number
		const contactGroup = custInputContact.parentElement?.parentElement;
		if (!custInputContact.value.trim()) {
			contactGroup?.classList.add('invalid');
			isValid = false;
		} else {
			contactGroup?.classList.remove('invalid');
		}

		// Address (Only validate if not Pickup)
		const addressGroup = custInputAddress.parentElement?.parentElement;
		const isPickup = currentOrder?.fulfillmentType === 'Pickup';
		if (!isPickup && !custInputAddress.value.trim()) {
			addressGroup?.classList.add('invalid');
			isValid = false;
		} else {
			addressGroup?.classList.remove('invalid');
		}

		// Datetime
		const datetimeGroup = custInputDatetime.parentElement?.parentElement;
		if (!custInputDatetime.value) {
			datetimeGroup?.classList.add('invalid');
			isValid = false;
		} else {
			datetimeGroup?.classList.remove('invalid');
		}

		return isValid;
	}

	// Theme Toggle Logic
	const themeToggleBtn = document.getElementById('theme-toggle-btn');
	const sunIcon = document.querySelector('.sun-icon') as HTMLElement;
	const moonIcon = document.querySelector('.moon-icon') as HTMLElement;

	function updateThemeIcons(theme: string) {
		if (theme === 'light') {
			if (sunIcon) sunIcon.style.display = 'none';
			if (moonIcon) moonIcon.style.display = 'block';
		} else {
			if (sunIcon) sunIcon.style.display = 'block';
			if (moonIcon) moonIcon.style.display = 'none';
		}
	}

	// Initialize theme icon display
	const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
	updateThemeIcons(currentTheme);

	themeToggleBtn?.addEventListener('click', () => {
		const current = document.documentElement.getAttribute('data-theme') || 'dark';
		const nextTheme = current === 'dark' ? 'light' : 'dark';
		document.documentElement.setAttribute('data-theme', nextTheme);
		localStorage.setItem('theme', nextTheme);
		updateThemeIcons(nextTheme);
	});
</script>
