		border: 1px solid var(--border-color);
		color: var(--text-secondary);
		padding: 3px 8px;
		border-radius: 4px;
		font-size: 0.7rem;
		cursor: pointer;
		font-weight: 700;
		transition: var(--transition-smooth);
	}

	.btn-copy-mini:hover {
		color: #ffffff;
		background: var(--accent-primary);
		border-color: var(--accent-primary);
	}

	.btn-copy-mini.copied {
		color: #ffffff;
		background: #10b981;
		border-color: #10b981;
