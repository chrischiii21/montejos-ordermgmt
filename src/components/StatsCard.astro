---
interface Props {
	id: string;
	title: string;
	initialValue: string;
	trendId?: string;
	initialTrend?: string;
	isTrendPositive?: boolean;
}

const { id, title, initialValue, trendId, initialTrend = "+0%", isTrendPositive = true } = Astro.props;
---

<div class="glass-panel stats-card animate-fade-in">
	<div class="card-content">
		<span class="card-title">{title}</span>
		<span class="card-value" id={id}>{initialValue}</span>
		<div class="card-footer">
			{trendId && (
				<span class={`trend-badge ${isTrendPositive ? 'trend-up' : 'trend-down'}`} id={trendId}>
					<span class="trend-icon">
						{isTrendPositive ? (
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 5v14"/></svg>
						) : (
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
						)}
					</span>
					<span class="trend-text">{initialTrend}</span>
				</span>
			)}
			<span class="footer-label">vs last 7 days</span>
		</div>
	</div>
	<div class="card-icon-container">
		<slot name="icon" />
		<div class="icon-glow"></div>
	</div>
</div>

<style>
	.stats-card {
		padding: 24px;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		position: relative;
		overflow: hidden;
	}

	.card-content {
		display: flex;
		flex-direction: column;
		gap: 8px;
		z-index: 2;
	}

	.card-title {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--text-secondary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.card-value {
		font-size: 2rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: -0.02em;
		line-height: 1.2;
		transition: var(--transition-smooth);
	}

	.card-footer {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-top: 4px;
		font-size: 0.75rem;
	}

	.trend-badge {
		display: flex;
		align-items: center;
		gap: 2px;
		padding: 2px 6px;
		border-radius: 6px;
		font-weight: 600;
	}

	.trend-up {
		background-color: var(--status-completed-light);
		color: var(--status-completed);
	}

	.trend-down {
		background-color: var(--status-cancelled-light);
		color: var(--status-cancelled);
	}

	.trend-icon {
		display: flex;
		align-items: center;
	}

	.footer-label {
		color: var(--text-muted);
	}

	.card-icon-container {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--border-color);
		color: var(--accent-primary);
		z-index: 2;
		transition: var(--transition-smooth);
	}

	.stats-card:hover .card-icon-container {
		color: var(--text-primary);
		background: var(--accent-primary);
		border-color: var(--accent-primary);
		transform: translateY(-2px);
	}

	.icon-glow {
		position: absolute;
		width: 100%;
		height: 100%;
		border-radius: 12px;
		background: var(--accent-primary);
		opacity: 0;
		filter: blur(10px);
		z-index: -1;
		transition: var(--transition-smooth);
	}

	.stats-card:hover .icon-glow {
		opacity: 0.4;
	}
</style>
