---
// Shared page shell. Pages pass `title` / `description` for the browser tab and link previews.
// The preview image is /og-image.png (1200×630). Previews never include customer details.
interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}
const SITE_NAME = "Montejo's Lechon & Food Trays";
const {
	title,
	description = "Whole lechon, lechon belly packages and food trays from Montejo's in Argao, Cebu. Order for pickup, meetup or delivery.",
	image = '/og-image.png',
	noindex = true
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} - Argao`;
const pageDescription = description;
// Previews need absolute URLs.
const pageUrl = new URL(Astro.url.pathname + Astro.url.search, Astro.url.origin).href;
const imageUrl = new URL(image, Astro.url.origin).href;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/jpeg" href="/logo.jpg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<!-- Link previews (Messenger/Facebook, Telegram, Viber, WhatsApp, X…): title, text and image instead of a bare link -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:secure_url" content={imageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${SITE_NAME} logo`} />
		<meta property="og:locale" content="en_PH" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={imageUrl} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<!-- Google Fonts: Poppins everywhere -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
		<slot name="head" />
		<script is:inline>
			(function() {
				const savedTheme = localStorage.getItem('theme') || 'light';
				document.documentElement.setAttribute('data-theme', savedTheme);
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>

	:root {
		color-scheme: light;
		/* Colors - LIGHT MODE (Default) — warm cream surface, charred chrome, ember red + flame amber from the logo */
		--bg-primary: #f6efe9;
		--bg-secondary: #ecdfd6;
		--bg-card: #ffffff;
		--bg-card-hover: #fffbf8;
		--border-color: rgba(74, 13, 10, 0.1);
		--border-color-hover: rgba(214, 54, 31, 0.45);

		--text-primary: #2a1510;
		--text-secondary: #5c3b32;
		--text-muted: #9a7d74;

		--accent-primary: #d6361f;
		--accent-primary-hover: #b52a16;
		--accent-primary-light: rgba(214, 54, 31, 0.1);
		--accent-deep: #4a0d0a;
		--accent-soft: #f5a524;
		/* Flame amber from the logo's sparks, for icons and small highlights */
		--accent-gold: #f5a524;
		/* Ember-to-flame fill for primary buttons */
		--accent-gradient: linear-gradient(135deg, #d6361f 0%, #f0602a 100%);

		--status-pending: #b45309;
		--status-pending-light: rgba(180, 83, 9, 0.12);
		--status-preparing: #d6361f;
		--status-preparing-light: rgba(214, 54, 31, 0.1);
		--status-completed: #047857;
		--status-completed-light: rgba(4, 120, 87, 0.12);
		--status-cancelled: #7f1d1d;
		--status-cancelled-light: rgba(127, 29, 29, 0.1);

		--bg-sidebar: #4a0d0a;
		--bg-modal: #ffffff;
		--bg-elevated: #ffffff;
		/* Surface tints: --tint-rgb lifts a surface, --hairline-rgb draws on it */
		--tint-rgb: 255, 255, 255;
		--hairline-rgb: 74, 13, 10;
		--input-bg: #f8f2ee;
		--bg-well: rgba(74, 13, 10, 0.05);
		--ambient-light-1: rgba(214, 54, 31, 0.08);
		--ambient-light-2: rgba(245, 165, 36, 0.12);

		--scrollbar-track: #ecdfd6;
		--scrollbar-thumb: rgba(74, 13, 10, 0.22);
		--scrollbar-thumb-hover: rgba(214, 54, 31, 0.55);

		/* Shadow & Glow */
		--glow-effect: 0 4px 20px rgba(214, 54, 31, 0.18);
		--card-shadow: 0 10px 30px -14px rgba(80, 20, 24, 0.22);
		--shadow-strong: rgba(80, 20, 24, 0.35);

		/* Page glow, shared with anything that must blend into the page (sidebar's active tab) */
		--page-glow:
			radial-gradient(circle at 10% 20%, var(--ambient-light-1) 0%, transparent 40%),
			radial-gradient(circle at 90% 80%, var(--ambient-light-2) 0%, transparent 40%);

		/* Shape: soft corners everywhere, larger on panels, pills on controls */
		--radius: 14px;
		--radius-lg: 24px;
		--radius-pill: 999px;

		/* Typography: Poppins for everything, its geometric weight echoes the "M" mark */
		--font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		--font-display: var(--font-family);

		/* Transitions */
		--transition-smooth: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	:root[data-theme="dark"] {
		color-scheme: dark;
		/* Colors - DARK MODE — neutral charcoal content, ember lives in the sidebar and accents */
		--bg-primary: #121113;
		--bg-secondary: #19181b;
		--bg-card: #1d1c1f;
		--bg-card-hover: #252327;
		--border-color: rgba(255, 255, 255, 0.06);
		--border-color-hover: rgba(240, 80, 46, 0.45);

		--text-primary: #f5f1ef;
		--text-secondary: #cfc8c5;
		--text-muted: #8f8885;

		--accent-primary: #f0502e;
		--accent-primary-hover: #d6361f;
		--accent-primary-light: rgba(240, 80, 46, 0.15);
		--accent-deep: #4a0d0a;
		--accent-soft: #f7b23b;
		--accent-gold: #f7b23b;
		--accent-gradient: linear-gradient(135deg, #e0401f 0%, #f7702e 100%);

		--status-pending: #f59e0b;
		--status-pending-light: rgba(245, 158, 11, 0.12);
		--status-preparing: #f0502e;
		--status-preparing-light: rgba(240, 80, 46, 0.14);
		--status-completed: #10b981;
		--status-completed-light: rgba(16, 185, 129, 0.12);
		--status-cancelled: #f87171;
		--status-cancelled-light: rgba(248, 113, 113, 0.12);

		--bg-sidebar: linear-gradient(165deg, #5a120b 0%, #2e0907 100%);
		--bg-modal: #1d1c1f;
		--bg-elevated: rgba(37, 35, 39, 0.9);
		/* Surface tints: --tint-rgb lifts a surface, --hairline-rgb draws on it */
		--tint-rgb: 255, 255, 255;
		--hairline-rgb: 255, 255, 255;
		--input-bg: rgba(0, 0, 0, 0.25);
		--bg-well: rgba(0, 0, 0, 0.22);
		--ambient-light-1: rgba(214, 54, 31, 0.06);
		--ambient-light-2: rgba(245, 165, 36, 0.03);

		--scrollbar-track: #121113;
		--scrollbar-thumb: rgba(255, 255, 255, 0.12);
		--scrollbar-thumb-hover: rgba(240, 80, 46, 0.5);

		/* Shadow & Glow */
		--glow-effect: 0 0 20px rgba(240, 80, 46, 0.25);
		--card-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.7);
		--shadow-strong: rgba(0, 0, 0, 0.75);
	}

	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	/* Long unbroken strings (order IDs, emails, share links) must never widen a container */
	h1, h2, h3, h4, p, span, td, th, li, label, div {
		overflow-wrap: break-word;
	}

	img, video, canvas {
		max-width: 100%;
		height: auto;
	}

	html,
	body {
		font-family: var(--font-family);
		background-color: var(--bg-primary);
		color: var(--text-primary);
		min-height: 100vh;
		overflow-x: hidden;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		/* Background ambient lights */
		background-image: var(--page-glow);
		background-attachment: fixed;
		transition: background-color 0.3s ease, color 0.3s ease;
	}

	/* Display typography — the serif carries headings, the sans carries data */
	.font-display {
		font-family: var(--font-display);
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	/* Small uppercase label, used for eyebrows and column headers */
	.eyebrow {
		font-family: var(--font-family);
		text-transform: uppercase;
		letter-spacing: 0.18em;
		font-size: 0.68rem;
		font-weight: 500;
		color: var(--text-muted);
	}

	/* Scrollbars */
	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}

	::-webkit-scrollbar-track {
		background: var(--scrollbar-track);
	}

	::-webkit-scrollbar-thumb {
		background: var(--scrollbar-thumb);
		border-radius: var(--radius);
	}

	::-webkit-scrollbar-thumb:hover {
		background: var(--scrollbar-thumb-hover);
	}

	/* Common glassmorphism class */
	.glass-panel {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: var(--card-shadow);
		transition: var(--transition-smooth);
		border-radius: var(--radius-lg);
	}

	.glass-panel:hover {
		border-color: var(--border-color-hover);
		box-shadow: var(--card-shadow), 0 0 20px rgba(214, 54, 31, 0.08);
	}

	/* Keyframe Animations */
	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes pulseGlow {
		0%, 100% {
			opacity: 0.6;
		}
		50% {
			opacity: 1;
		}
	}

	.animate-fade-in {
		animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
</style>
