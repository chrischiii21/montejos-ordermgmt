				<div class="receipt-divider"></div>

				<div style="font-weight: bold; font-size: 0.8rem; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em; text-align: left;">Items Ordered</div>
				${itemsHtml}

				<div class="receipt-divider"></div>

				<div class="receipt-totals">
					<div class="receipt-total-row">
						<span>Subtotal:</span>
						<span>₱${(order.total - (order.deliveryFee || 0)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
					</div>
					${order.deliveryFee ? `
						<div class="receipt-total-row">
							<span>Delivery/Meetup Fee:</span>
							<span>₱${order.deliveryFee.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
						</div>
					` : ''}
					<div class="receipt-total-row" style="font-weight: bold;">
						<span>Total Bill:</span>
						<span>₱${order.total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
					</div>
					<div class="receipt-total-row" style="color: #d92b3a !important; font-weight: bold;">
						<span>Downpayment Selected:</span>
						<span>₱${order.downpayment.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
					</div>
					<div class="receipt-total-row grand-total">
						<span>Remaining Balance:</span>
						<span>₱${order.balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
					</div>
				</div>

				<div class="receipt-footer">
					<div style="font-weight: bold; margin-bottom: 4px;">THANK YOU FOR YOUR PATRONAGE!</div>
					<div>Please send a screenshot of this receipt and proof of downpayment to confirm your slot.</div>
				</div>
			</div>
		`;
	}

	function downloadReceiptImage(orderId: string) {
		const receiptCard = document.getElementById('receipt-card-element');
		if (!receiptCard) return;

		// @ts-ignore
		if (typeof html2canvas !== 'undefined') {
			// @ts-ignore
			html2canvas(receiptCard, {
				scale: 2,
				backgroundColor: '#ffffff',
				useCORS: true
			}).then(canvas => {
				canvas.toBlob(blob => {
					if (!blob) {
						console.error('Failed to create blob from canvas');
						return;
					}
					const url = URL.createObjectURL(blob);
					const link = document.createElement('a');
					link.download = `Receipt-${orderId}.png`;
					link.href = url;
					document.body.appendChild(link);
					link.click();
					document.body.removeChild(link);
					URL.revokeObjectURL(url);
				}, 'image/png');
			}).catch(err => {
				console.error('Error rendering receipt image:', err);
			});
		} else {
			alert('Receipt rendering library is still loading. Please try again in a second.');
		}
	}

	function showAlreadyVerifiedScreen(order: Order) {
		const verifiedScreen = document.getElementById('verified-screen');
		const receiptContainer = document.getElementById('receipt-container-verified');
		const portalWizard = document.getElementById('portal-wizard');
		const errorScreen = document.getElementById('error-screen');

		if (verifiedScreen && receiptContainer && portalWizard && errorScreen) {
			receiptContainer.innerHTML = generateReceiptHtml(order);
			verifiedScreen.style.display = 'flex';
			portalWizard.style.display = 'none';
			errorScreen.style.display = 'none';

			// Bind verified download button
			const btnDownloadVerified = document.getElementById('btn-download-receipt-verified');
			btnDownloadVerified?.addEventListener('click', () => {
				downloadReceiptImage(order.id);
			});
		}
	}

	// Load Order
	document.addEventListener('DOMContentLoaded', async () => {
		const urlParams = new URLSearchParams(window.location.search);
		const id = urlParams.get('id');

		if (!id) {
			showError('Invalid Link', 'No order identifier was found in the link. Please ask the food service owner for a correct link.');
			return;
		}

		// Validate secure URL signature to prevent link tampering / enumeration
		const sig = urlParams.get('t');
		if (!sig || sig !== getOrderSignature(id)) {
			showError('Access Denied', 'This order link is invalid, corrupted, or has expired. Please request a new link from the food service owner.');
			return;
		}

		// Fetch order + items from Supabase
		const { data, error } = await supabase
			.from('orders')
			.select('*, order_items(*)')
			.eq('id', id)
			.single();

		if (error || !data) {
			showError('Order Not Found', `We could not find any order ticket matching ID: #${id.replace('ORD-', '')}.`);
			return;
		}

		const currentStatus = checkAndTransitionOrderStatus(data);

		// Validate if expired
		if (currentStatus === 'Completed' || currentStatus === 'Cancelled') {
			showError('Order Link Expired', `This link has expired because Order #${id.replace('ORD-', '')} has already been marked as ${currentStatus.toUpperCase()}.`);
			return;
		}

		currentOrder = {
			id: data.id,
			date: data.date,
			customer: data.customer,
			address: data.address,
			contact: data.contact,
			deliveryDateTime: data.delivery_date_time ?? '',
			fulfillmentType: data.fulfillment_type ?? 'Delivery',
			status: currentStatus,
			total: parseFloat(data.total),
			downpayment: parseFloat(data.downpayment),
			balance: parseFloat(data.balance),
			deliveryFee: parseFloat(data.delivery_fee ?? 0),
			facebookName: data.facebook_name ?? '',
			items: (data.order_items ?? []).map((it: any) => ({
				name: it.name,
				quantity: it.quantity,
				price: parseFloat(it.price),
				total: parseFloat(it.total),
				customInclusions: it.custom_inclusions ?? []
			}))
		};

		// Check if already filled up/verified (either locally in localStorage, or in the database details)
		// We consider it verified in database only if customer is not 'Pending Customer Details' AND deliveryDateTime is already filled
		const isVerifiedInDb = currentOrder.customer && 
							   currentOrder.customer !== 'Pending Customer Details' && 
							   currentOrder.deliveryDateTime && 
							   currentOrder.deliveryDateTime.trim() !== '';

		if (localStorage.getItem('verified_order_' + id) === 'true' || isVerifiedInDb) {
			showAlreadyVerifiedScreen(currentOrder);
			applySharedSettingsFromUrl();
			return;
		}

		initializeWizard();
		// Apply any shared settings passed in the URL
		applySharedSettingsFromUrl();
	});

	function showError(title: string, description: string) {
		if (errorScreen && errorTitle && errorDesc && portalWizard) {
			errorTitle.textContent = title;
			errorDesc.textContent = description;
			errorScreen.style.display = 'flex';
			portalWizard.style.display = 'none';
		}
	}

	function initializeWizard() {
		if (!currentOrder || !portalWizard) return;
		portalWizard.style.display = 'block';

		// Step 1: Render Items & Inclusions
		const itemsContainer = document.getElementById('customer-items-list');
		if (itemsContainer) {
			itemsContainer.innerHTML = currentOrder.items.map(it => {
				const inclusions = getInclusions(it);
				const inclusionsHtml = inclusions ? `
					<div class="item-inclusions">
						<div class="inclusions-title">Inclusions:</div>
						<ul class="inclusions-list">
							${inclusions.map(inc => `<li>${inc}</li>`).join('')}
						</ul>
					</div>
				` : '';
				return `
					<div class="summary-item-row">
						<div class="summary-item-content">
							<div style="display: flex; align-items: center; gap: 8px;">
								<span class="summary-item-qty">${it.quantity}x</span>
								<span class="summary-item-name">${it.name}</span>
							</div>
							<span class="summary-item-right">₱${it.total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
						</div>
						${inclusionsHtml}
					</div>
				`;
			}).join('');
		}

		// Render totals
		const custFulfillmentRow = document.getElementById('cust-fulfillment-row');
		const custFulfillmentType = document.getElementById('cust-fulfillment-type');
		const custSubtotalRow = document.getElementById('cust-subtotal-row');
		const custSubtotal = document.getElementById('cust-subtotal');
		const custDeliveryRow = document.getElementById('cust-delivery-row');
		const custDeliveryFee = document.getElementById('cust-delivery-fee');
		const custTotalBill = document.getElementById('cust-total-bill');
		const custDownpayment = document.getElementById('cust-downpayment');
		const custBalanceLabel = document.getElementById('cust-balance-label');
		const custBalance = document.getElementById('cust-balance');

		const deliveryFee = currentOrder.deliveryFee || 0;
		const subtotal = currentOrder.total - deliveryFee;
		const fulfillmentType = currentOrder.fulfillmentType || 'Delivery';

		if (custFulfillmentRow && custFulfillmentType) {
			custFulfillmentRow.style.display = 'flex';
			custFulfillmentType.textContent = fulfillmentType;
		}

		if (custSubtotalRow && custSubtotal) {
			custSubtotalRow.style.display = 'flex';
			custSubtotal.textContent = `₱${subtotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		}

		if (custDeliveryRow && custDeliveryFee) {
			custDeliveryRow.style.display = 'flex';
			custDeliveryFee.textContent = `₱${deliveryFee.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		}

		if (custTotalBill) custTotalBill.textContent = `₱${currentOrder.total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		if (custDownpayment) custDownpayment.textContent = `₱${currentOrder.downpayment.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		if (custBalance) custBalance.textContent = `₱${currentOrder.balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

		if (custBalanceLabel) {
			const type = currentOrder.fulfillmentType || 'Delivery';
			if (type === 'Pickup') {
				custBalanceLabel.textContent = 'Remaining Balance Upon Pickup';
			} else if (type === 'Meetup') {
				custBalanceLabel.textContent = 'Remaining Balance Upon Meetup';
			} else {
				custBalanceLabel.textContent = 'Remaining Balance Upon Delivery';
			}
		}

		// Configure address/delivery fields based on fulfillment type
		const addressGroup = document.getElementById('cust-address-group');
		const datetimeLabel = document.getElementById('cust-datetime-label');
		const isPickup = currentOrder.fulfillmentType === 'Pickup';

		if (addressGroup) {
			addressGroup.style.display = isPickup ? 'none' : 'block';
		}
		if (custInputAddress) {
			if (isPickup) {
				custInputAddress.removeAttribute('required');
			} else {
				custInputAddress.setAttribute('required', 'required');
			}
		}
		if (datetimeLabel) {
			datetimeLabel.textContent = isPickup ? 'Pickup Date & Time' : 'Delivery/Meetup Date & Time';
		}

		// Prefill fields from currentOrder — treat the special placeholder marker as empty
		if (custInputName && currentOrder.customer && currentOrder.customer !== 'Pending Customer Details') custInputName.value = currentOrder.customer;
		if (custInputContact && currentOrder.contact) custInputContact.value = currentOrder.contact;
		if (custInputFb && currentOrder.facebookName) custInputFb.value = currentOrder.facebookName;
		if (custInputAddress && currentOrder.address) custInputAddress.value = currentOrder.address;
		if (custInputDatetime && currentOrder.deliveryDateTime) {
			custInputDatetime.value = currentOrder.deliveryDateTime.replace(' ', 'T');
		}
		if (custInputDownpayment && currentOrder.downpayment) {
			custInputDownpayment.value = currentOrder.downpayment.toString();
		}

		// Show notice if Receiver Name or Contact were prefilled by owner
		const prefillNotice = document.getElementById('prefill-notice');
		const namePrefillSubtext = document.getElementById('name-prefill-subtext');
		const contactPrefillSubtext = document.getElementById('contact-prefill-subtext');
		const hasPrefilledName = currentOrder.customer && currentOrder.customer !== 'Pending Customer Details' && currentOrder.customer.trim() !== '';
		const hasPrefilledContact = currentOrder.contact && currentOrder.contact.trim() !== '';
		if (prefillNotice) {
			if (hasPrefilledName || hasPrefilledContact) {
				prefillNotice.style.display = 'block';
			} else {
				prefillNotice.style.display = 'none';
			}
		}
		if (namePrefillSubtext) {
			namePrefillSubtext.style.display = hasPrefilledName ? 'block' : 'none';
		}
		if (contactPrefillSubtext) {
			contactPrefillSubtext.style.display = hasPrefilledContact ? 'block' : 'none';
		}

		// Update calculation view
		updateLiveCalculation();

		custInputDownpayment?.addEventListener('input', () => {
			updateLiveCalculation();
		});

		// Add input restrictions on custInputContact
		custInputContact?.addEventListener('keydown', (e) => {
			// Allow control keys (Backspace, Delete, Tab, Escape, Enter, Arrow keys) and Select All (Ctrl+A / Cmd+A) etc.
			const isControlKey = e.key === 'Backspace' || e.key === 'Delete' || e.key === 'Tab' || 
				e.key === 'Escape' || e.key === 'Enter' || e.key.startsWith('Arrow') ||
				((e.ctrlKey || e.metaKey) && (e.key === 'a' || e.key === 'c' || e.key === 'v' || e.key === 'x'));

			if (isControlKey) return;

			// If it's a character and not a digit 0-9, prevent it
			if (e.key.length === 1 && !/^[0-9]$/.test(e.key)) {
				e.preventDefault();
				showContactWarning();
			}
		});

		custInputContact?.addEventListener('input', () => {
			const rawVal = custInputContact.value;
			const cleanVal = rawVal.replace(/[^0-9]/g, '');
			if (rawVal !== cleanVal) {
				custInputContact.value = cleanVal;
				showContactWarning();
			}
		});

		custInputContact?.addEventListener('paste', (e) => {
			const pastedData = e.clipboardData?.getData('text') || '';
			if (/[^0-9]/.test(pastedData)) {
				e.preventDefault();
				const cleanPasted = pastedData.replace(/[^0-9]/g, '');
				
				const start = custInputContact.selectionStart || 0;
				const end = custInputContact.selectionEnd || 0;
				const val = custInputContact.value;
				custInputContact.value = val.substring(0, start) + cleanPasted + val.substring(end);
				custInputContact.setSelectionRange(start + cleanPasted.length, start + cleanPasted.length);
				
				showContactWarning();
			}
		});

		let warningTimeout: any = null;
		function showContactWarning() {
			if (contactWarningSubtext) {
				contactWarningSubtext.style.display = 'block';
				if (warningTimeout) clearTimeout(warningTimeout);
				warningTimeout = setTimeout(() => {
					contactWarningSubtext.style.display = 'none';
				}, 2000);
			}
		}

		// Checkbox controller
		verifyCheckbox?.addEventListener('change', () => {
			if (btnGotoStep2) {
				btnGotoStep2.disabled = !verifyCheckbox.checked;
			}
		});

		// Navigation Step 1 -> 2
		btnGotoStep2?.addEventListener('click', () => {
			goToStep(2);
		});

		// Navigation Step 2 -> 1
		btnBacktoStep1?.addEventListener('click', () => {
			goToStep(1);
		});

		// Form Step 2 Submission (Goes to Step 3 Review instead of saving directly to DB)
		customerInfoForm?.addEventListener('submit', (e) => {
			e.preventDefault();
			if (!validateStep2Form()) return;

			if (currentOrder) {
				currentOrder.customer = custInputName.value.trim();
				currentOrder.contact = custInputContact.value.trim();
				currentOrder.facebookName = custInputFb.value.trim();
				currentOrder.address = custInputAddress.value.trim();
				
				const rawDate = custInputDatetime.value;
				currentOrder.deliveryDateTime = rawDate.replace('T', ' ');

				const downpaymentVal = custInputDownpayment.value.trim();
				const customDownpayment = downpaymentVal ? Math.max(0, parseFloat(downpaymentVal)) : 0;
				currentOrder.downpayment = customDownpayment;
				currentOrder.balance = Math.max(0, currentOrder.total - customDownpayment);

				// Update Review Details Content
				if (reviewCustomerName) reviewCustomerName.textContent = currentOrder.customer;
				if (reviewCustomerContact) reviewCustomerContact.textContent = currentOrder.contact;
				if (reviewCustomerFb) reviewCustomerFb.textContent = currentOrder.facebookName || 'N/A';
				
				const isPickup = currentOrder.fulfillmentType === 'Pickup';
				if (reviewFulfillmentType) reviewFulfillmentType.textContent = currentOrder.fulfillmentType || 'Delivery';
				
				if (reviewDatetimeLabel) reviewDatetimeLabel.textContent = isPickup ? 'Pickup Date & Time' : 'Delivery Date & Time';
				if (reviewDeliveryDatetime) {
					reviewDeliveryDatetime.textContent = currentOrder.deliveryDateTime ? new Date(currentOrder.deliveryDateTime.replace(' ', 'T')).toLocaleString('en-US', {
						year: 'numeric',
						month: 'long',
						day: 'numeric',
						hour: 'numeric',
						minute: '2-digit',
						hour12: true
					}) : 'Not set';
				}
				
				if (reviewAddressContainer) reviewAddressContainer.style.display = isPickup ? 'none' : 'flex';
				if (reviewDeliveryAddress) reviewDeliveryAddress.textContent = currentOrder.address || '-';

				// Items review table list
				if (reviewItemsList) {
					reviewItemsList.innerHTML = currentOrder.items.map(it => `
						<div style="display: flex; justify-content: space-between; font-size: 0.85rem; padding: 4px 0;">
							<span style="color: var(--text-primary); font-weight: 500;">${it.quantity}x ${it.name}</span>
							<span style="color: var(--text-secondary);">₱${it.total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
						</div>
					`).join('');
				}

				const deliveryFee = currentOrder.deliveryFee || 0;
				const subtotal = currentOrder.total - deliveryFee;

				if (reviewSubtotal) reviewSubtotal.textContent = `₱${subtotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
				if (reviewDeliveryFeeRow) reviewDeliveryFeeRow.style.display = isPickup ? 'none' : 'flex';
				if (reviewDeliveryFee) reviewDeliveryFee.textContent = `₱${deliveryFee.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
				if (reviewTotalBill) reviewTotalBill.textContent = `₱${currentOrder.total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
				if (reviewDownpayment) reviewDownpayment.textContent = `₱${currentOrder.downpayment.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
				if (reviewBalance) reviewBalance.textContent = `₱${currentOrder.balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
				
				if (reviewBalanceLabel) {
					if (isPickup) {
						reviewBalanceLabel.textContent = 'Remaining Balance Upon Pickup:';
					} else if (currentOrder.fulfillmentType === 'Meetup') {
						reviewBalanceLabel.textContent = 'Remaining Balance Upon Meetup:';
					} else {
						reviewBalanceLabel.textContent = 'Remaining Balance Upon Delivery:';
					}
				}

				goToStep(3);
			}
		});

		// Navigation Step 3 -> 2
		btnBacktoStep2?.addEventListener('click', () => {
			goToStep(2);
		});

		// Navigation Step 3 Submission (Saves to DB and goes to Step 4 Payment)
		btnSubmitOrder?.addEventListener('click', async () => {
			if (!currentOrder) return;

			// Add visual loading state
			const oldBtnHtml = btnSubmitOrder.innerHTML;
			btnSubmitOrder.setAttribute('disabled', 'disabled');
			btnSubmitOrder.innerHTML = `
				<svg class="animate-spin" style="animation: spin 1s linear infinite; margin-right: 8px; display: inline-block; vertical-align: middle;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" style="opacity: 0.25;"></circle><path class="opacity-75" fill="currentColor" style="opacity: 0.75;" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
				<span>Submitting...</span>
			`;

			try {
				// Update Step 1 totals summary in case they go back
				const custDownpayment = document.getElementById('cust-downpayment');
				const custBalance = document.getElementById('cust-balance');
				if (custDownpayment) custDownpayment.textContent = `₱${currentOrder.downpayment.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
				if (custBalance) custBalance.textContent = `₱${currentOrder.balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

				// Update Step 4 summary values
				if (custStep4Fulfillment) custStep4Fulfillment.textContent = currentOrder.fulfillmentType || 'Delivery';
				if (custStep4Total) custStep4Total.textContent = `₱${currentOrder.total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
				if (custStep4Downpayment) custStep4Downpayment.textContent = `₱${currentOrder.downpayment.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
				if (custStep4Balance) custStep4Balance.textContent = `₱${currentOrder.balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
				if (custStep4BalanceLabel) {
					const type = currentOrder.fulfillmentType || 'Delivery';
					if (type === 'Pickup') {
						custStep4BalanceLabel.textContent = 'Remaining Balance Upon Pickup:';
					} else if (type === 'Meetup') {
						custStep4BalanceLabel.textContent = 'Remaining Balance Upon Meetup:';
					} else {
						custStep4BalanceLabel.textContent = 'Remaining Balance Upon Delivery:';
					}
				}

				// Render Step 4 Receipt Card
				const receiptContainerStep4 = document.getElementById('receipt-container-step4');
				if (receiptContainerStep4) {
					receiptContainerStep4.innerHTML = generateReceiptHtml(currentOrder);
				}

				// Save verified flag to localStorage
				localStorage.setItem('verified_order_' + currentOrder.id, 'true');

				// Save updated order via serverless function to bypass RLS
				const resp = await fetch('/api/update-order', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						id: currentOrder.id,
						isCustomerVerification: true,
						orderUpdates: {
							customer: currentOrder.customer,
							contact: currentOrder.contact,
							facebook_name: currentOrder.facebookName || null,
							address: currentOrder.address,
							delivery_date_time: currentOrder.deliveryDateTime,
							downpayment: currentOrder.downpayment,
							balance: currentOrder.balance
						}
					})
				});

				const result = await resp.json().catch(() => ({}));
				if (!resp.ok) {
					console.error('Failed to save customer details (server):', result);
					alert('Failed to save your details. Please try again.');
					btnSubmitOrder.removeAttribute('disabled');
					btnSubmitOrder.innerHTML = oldBtnHtml;
					return;
				}

				if (custOrderIdDisplay) {
					custOrderIdDisplay.textContent = currentOrder.id;
				}

				goToStep(4);
			} catch (e) {
				console.error('Failed to save customer details:', e);
				alert('Failed to save your details. Please try again.');
				btnSubmitOrder.removeAttribute('disabled');
				btnSubmitOrder.innerHTML = oldBtnHtml;
			}
		});

		// Bind Step 4 download button
		const btnDownloadStep4 = document.getElementById('btn-download-receipt-step4');
		btnDownloadStep4?.addEventListener('click', () => {
			if (currentOrder) {
				downloadReceiptImage(currentOrder.id);
			}
		});

		// Setup Click to Copy for MoPs
		document.querySelectorAll('.btn-copy-mini').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const text = (e.currentTarget as HTMLButtonElement).getAttribute('data-copy');
				if (text) {
					navigator.clipboard.writeText(text).then(() => {
						const oldText = btn.textContent;
						btn.textContent = 'Copied!';
						btn.classList.add('copied');
						
						// Trigger premium browser notification if function exists
						setTimeout(() => {
							btn.textContent = oldText;
							btn.classList.remove('copied');
						}, 2000);
					});
				}
			});
		});
	}

	function goToStep(step: number) {
		currentStep = step;

		// Toggle sections visibility
		if (step1Content) step1Content.style.display = step === 1 ? 'flex' : 'none';
		if (step2Section) step2Section.style.display = step === 2 ? 'flex' : 'none';
		if (step3Section) step3Section.style.display = step === 3 ? 'flex' : 'none';
		if (step4Section) step4Section.style.display = step === 4 ? 'flex' : 'none';

		// Toggle indicators
		if (step === 1) {
			step1Indicator?.classList.add('active');
			step1Indicator?.classList.remove('completed');
			step2Indicator?.classList.remove('active', 'completed');
			step3Indicator?.classList.remove('active', 'completed');
			step4Indicator?.classList.remove('active', 'completed');
			line1Indicator?.classList.remove('completed');
			line2Indicator?.classList.remove('completed');
			line3Indicator?.classList.remove('completed');
		} else if (step === 2) {
			step1Indicator?.classList.remove('active');
			step1Indicator?.classList.add('completed');
			step2Indicator?.classList.add('active');
			step2Indicator?.classList.remove('completed');
			step3Indicator?.classList.remove('active', 'completed');
			step4Indicator?.classList.remove('active', 'completed');
			line1Indicator?.classList.add('completed');
			line2Indicator?.classList.remove('completed');
			line3Indicator?.classList.remove('completed');
		} else if (step === 3) {
			step1Indicator?.classList.remove('active');
			step1Indicator?.classList.add('completed');
			step2Indicator?.classList.remove('active');
			step2Indicator?.classList.add('completed');
			step3Indicator?.classList.add('active');
			step3Indicator?.classList.remove('completed');
			step4Indicator?.classList.remove('active', 'completed');
			line1Indicator?.classList.add('completed');
			line2Indicator?.classList.add('completed');
			line3Indicator?.classList.remove('completed');
		} else if (step === 4) {
			step1Indicator?.classList.remove('active');
			step1Indicator?.classList.add('completed');
			step2Indicator?.classList.remove('active');
			step2Indicator?.classList.add('completed');
			step3Indicator?.classList.remove('active');
			step3Indicator?.classList.add('completed');
			step4Indicator?.classList.add('active');
			line1Indicator?.classList.add('completed');
			line2Indicator?.classList.add('completed');
			line3Indicator?.classList.add('completed');
		}
	}

	function validateStep2Form(): boolean {
		let isValid = true;

		// Receiver Name
		const nameGroup = custInputName.parentElement?.parentElement;
		if (!custInputName.value.trim()) {
			nameGroup?.classList.add('invalid');
			isValid = false;
		} else {
			nameGroup?.classList.remove('invalid');
		}

		// Contact Number
		const contactGroup = custInputContact.parentElement?.parentElement;
		if (!custInputContact.value.trim()) {
			contactGroup?.classList.add('invalid');
			isValid = false;
		} else {
			contactGroup?.classList.remove('invalid');
		}

		// Address (Only validate if not Pickup)
		const addressGroup = custInputAddress.parentElement?.parentElement;
		const isPickup = currentOrder?.fulfillmentType === 'Pickup';
		if (!isPickup && !custInputAddress.value.trim()) {
			addressGroup?.classList.add('invalid');
			isValid = false;
		} else {
			addressGroup?.classList.remove('invalid');
		}

		// Datetime
		const datetimeGroup = custInputDatetime.parentElement?.parentElement;
		if (!custInputDatetime.value) {
			datetimeGroup?.classList.add('invalid');
			isValid = false;
		} else {
			datetimeGroup?.classList.remove('invalid');
		}

		// Downpayment validation
		const downpaymentGroup = custInputDownpayment.parentElement?.parentElement;
		const dpVal = parseFloat(custInputDownpayment.value.trim());
		if (isNaN(dpVal) || dpVal < 0) {
			downpaymentGroup?.classList.add('invalid');
			isValid = false;
		} else {
			downpaymentGroup?.classList.remove('invalid');
		}

		return isValid;
	}

	// Theme Toggle Logic
	const themeToggleBtn = document.getElementById('theme-toggle-btn');
	const sunIcon = document.querySelector('.sun-icon') as HTMLElement;
	const moonIcon = document.querySelector('.moon-icon') as HTMLElement;

	function updateThemeIcons(theme: string) {
		if (theme === 'light') {
			if (sunIcon) sunIcon.style.display = 'none';
			if (moonIcon) moonIcon.style.display = 'block';
		} else {
			if (sunIcon) sunIcon.style.display = 'block';
			if (moonIcon) moonIcon.style.display = 'none';
		}
	}

	// Initialize theme icon display
	const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
	updateThemeIcons(currentTheme);

	themeToggleBtn?.addEventListener('click', () => {
		const current = document.documentElement.getAttribute('data-theme') || 'dark';
		const nextTheme = current === 'dark' ? 'light' : 'dark';
		document.documentElement.setAttribute('data-theme', nextTheme);
		localStorage.setItem('theme', nextTheme);
		updateThemeIcons(nextTheme);
	});
</script>
