---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<!-- html2canvas CDN for downloading receipt images -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" defer></script>

	<!-- Floating Theme Toggle Button -->
	<button class="theme-toggle-btn" id="theme-toggle-btn" aria-label="Toggle Theme" style="position: fixed; top: 16px; right: 16px; z-index: 1000; background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); padding: 10px; border-radius: 10px; cursor: pointer; transition: var(--transition-smooth); box-shadow: var(--card-shadow); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);">
		<svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
		<svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
	</button>

	<div class="customer-portal-container">
		<header class="portal-header animate-fade-in">
			<div class="logo-glow"></div>
			<div class="logo-group" style="display: flex; align-items: center; justify-content: center; gap: 12px;">
				<img src="/logo.jpg" alt="Montejo's Logo" class="logo-img" style="width: 42px; height: 42px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 15px rgba(99, 102, 241, 0.4); border: 1.5px solid rgba(255, 255, 255, 0.15);" />
				<h2 style="font-size: 1.35rem; line-height: 1.2; font-weight: 800; background: linear-gradient(135deg, var(--text-primary) 30%, var(--accent-primary) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin: 0;">Montejo's Lechon & Food Trays - Argao</h2>
			</div>
			<p class="portal-subtitle" style="margin-top: 6px;">Customer Order Verification Portal</p>
		</header>

		<!-- Error Screens -->
		<div id="error-screen" class="glass-panel error-panel animate-fade-in" style="display: none;">
			<div class="error-icon-wrapper">
				<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
			</div>
			<h3 id="error-title">Order Link Expired</h3>
			<p id="error-desc">This order link is no longer valid. The order may have already been completed, cancelled, or does not exist.</p>
			<a href="https://www.facebook.com/profile.php?id=100064148257945" target="_blank" class="btn btn-primary" style="text-decoration: none; margin-top: 16px; display: inline-flex; align-items: center; gap: 8px;">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
				<span>Visit Facebook Page</span>
			</a>
		</div>

		<!-- Already Verified Screen -->
		<div id="verified-screen" class="glass-panel animate-fade-in" style="display: none; flex-direction: column; gap: 20px; padding: 32px 24px; text-align: center;">
			<div class="success-checkmark-wrapper" style="margin: 0 auto;">
				<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
			</div>
			<h3 style="font-size: 1.4rem; font-weight: 800;">Order Verification Completed</h3>
			<p style="font-size: 0.95rem; color: var(--text-secondary); max-width: 440px; margin: 0 auto; line-height: 1.5;">
				You have already verified this order and submitted your details. Below is your official receipt.
			</p>

			<!-- Mode of Payments Card -->
			<div class="mode-of-payments-card">
				<h4>M O D E   O F   P A Y M E N T S</h4>
				
				<div class="payment-methods-grid">
					<div class="payment-box">
						<div class="payment-box-header">
							<span class="payment-brand">MARIBANK</span>
							<button class="btn-copy-mini" data-copy="11953471393">Copy</button>
						</div>
						<div class="payment-box-body maribank-box">
							<span class="label">Account Name:</span>
							<span class="val maribank-name">Christy Montejo</span>
							<span class="label">Account Number:</span>
							<span class="val monospace maribank-num">11953471393</span>
						</div>
					</div>

					<div class="payment-box">
						<div class="payment-box-header">
							<span class="payment-brand font-gcash">GCASH</span>
							<button class="btn-copy-mini" data-copy="09760721404">Copy</button>
						</div>
						<div class="payment-box-body gcash-box">
							<span class="label">Account Name:</span>
							<span class="val gcash-name">Christy Montejo</span>
							<span class="label">Mobile Number:</span>
							<span class="val monospace gcash-num">09760721404</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Receipt Preview -->
			<div id="receipt-container-verified" style="width: 100%; display: flex; justify-content: center; padding: 12px 0;">
				<!-- Dynamic Receipt HTML -->
			</div>

			<div style="display: flex; flex-direction: column; gap: 12px; max-width: 420px; margin: 12px auto 0; width: 100%;">
				<button id="btn-download-receipt-verified" class="btn btn-primary" style="padding: 14px; width: 100%; border-radius: 12px; font-weight: 700;">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
					<span>Download Receipt Image</span>
				</button>
				<a href="https://m.me/100064148257945" target="_blank" class="btn btn-secondary" style="padding: 14px; width: 100%; border-radius: 12px; font-weight: 700; text-decoration: none;">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
					<span>Message Us on Facebook</span>
				</a>
			</div>
		</div>

		<!-- Wizard Portal -->
		<main id="portal-wizard" class="animate-fade-in" style="display: none;">
			<!-- Step Indicator -->
			<div class="step-indicator">
				<div class="step active" id="step-1-indicator">
					<span class="step-num">1</span>
					<span class="step-text">Verify Items</span>
				</div>
				<div class="step-line" id="line-1-indicator"></div>
				<div class="step" id="step-2-indicator">
					<span class="step-num">2</span>
					<span class="step-text">Delivery Info</span>
				</div>
				<div class="step-line" id="line-2-indicator"></div>
				<div class="step" id="step-3-indicator">
					<span class="step-num">3</span>
					<span class="step-text">Review Details</span>
				</div>
				<div class="step-line" id="line-3-indicator"></div>
				<div class="step" id="step-4-indicator">
					<span class="step-num">4</span>
					<span class="step-text">Secure Payment</span>
				</div>
			</div>

			<!-- Step 1 Content: Order Verification -->
			<section id="step-1-content" class="glass-panel step-content-card">
				<div class="card-header-group">
					<h3>Review Your Food Order</h3>
					<p>Please review the list of dishes ordered by the organizer for accuracy.</p>
				</div>

				<!-- Payment Location Notice Banner -->
				<div class="payment-notice-banner animate-fade-in" style="background: rgba(99, 102, 241, 0.08); border: 1.5px solid rgba(99, 102, 241, 0.2); border-radius: 12px; padding: 14px 16px; margin-bottom: 20px; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; text-align: left; display: flex; align-items: flex-start; gap: 10px;">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-top: 1px; flex-shrink: 0;"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="16" y2="12"/><line x1="12" x2="12.01" y1="8" y2="8"/></svg>
					<span><strong>Notice:</strong> The payment details (GCash/Maribank mode of payment options) will be displayed on-screen at the end of the form once you submit your details.</span>
				</div>

				<div class="order-items-summary" id="customer-items-list">
					<!-- Dynamic items list -->
				</div>

				<div class="order-totals-summary">
					<div class="summary-row font-medium" id="cust-fulfillment-row" style="display: none; opacity: 0.85;">
						<span>Fulfillment Method</span>
						<span id="cust-fulfillment-type">-</span>
					</div>
					<div class="summary-row font-medium" id="cust-subtotal-row" style="display: none; opacity: 0.85;">
						<span>Subtotal</span>
						<span id="cust-subtotal">₱0.00</span>
					</div>
					<div class="summary-row font-medium" id="cust-delivery-row" style="display: none; opacity: 0.85;">
						<span>Delivery/Meetup Fee</span>
						<span id="cust-delivery-fee">₱0.00</span>
					</div>
					<div class="summary-row font-medium">
						<span>Total Bill</span>
						<span id="cust-total-bill">₱0.00</span>
					</div>
					<div class="summary-row accent">
						<span id="required-downpayment-label">Required Downpayment (50%)</span>
						<span id="cust-downpayment">₱0.00</span>
					</div>
					<div class="summary-row font-medium">
						<span id="cust-balance-label">Remaining Balance Upon Delivery</span>
						<span id="cust-balance">₱0.00</span>
					</div>
				</div>

				<div class="terms-note">
					<p id="required-downpayment-note"><strong>Note:</strong> To confirm your order, we request a 50% downpayment of the total bill. The rest will be paid upon pickup/delivery of orders.</p>
				</div>

				<div class="verification-agreement">
					<label class="custom-checkbox-container">
						<input type="checkbox" id="verify-order-checkbox" />
						<span class="checkmark"></span>
						<span class="checkbox-label">I verify that the food items and pricing listed above are correct.</span>
					</label>
				</div>

				<div class="form-actions-right">
					<button type="button" class="btn btn-primary" id="btn-goto-step-2" disabled>
						<span>Verify & Continue</span>
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</button>
				</div>
			</section>

			<!-- Step 2 Content: Customer Details -->
			<section id="step-2-content" class="glass-panel step-content-card" style="display: none;">
				<div class="card-header-group">
					<h3>Complete Contact & Delivery Details</h3>
					<p>Please enter the delivery information so we can coordinate your food prep and drop-off.</p>
				</div>

				<form id="customer-info-form" novalidate style="display: flex; flex-direction: column; gap: 16px; text-align: left;">
					<!-- Prefill Notice Banner -->
					<div id="prefill-notice" style="display: none; background: rgba(99, 102, 241, 0.08); border: 1.5px solid rgba(99, 102, 241, 0.2); border-radius: 10px; padding: 12px 14px; margin-bottom: 4px; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.45; text-align: left;">
						<div style="display: flex; align-items: flex-start; gap: 8px;">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-top: 2px; flex-shrink: 0;"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="16" y2="12"/><line x1="12" x2="12.01" y1="8" y2="8"/></svg>
							<span>Some details were pre-filled based on the information we have, but please feel free to edit them if there are changes.</span>
						</div>
					</div>

					<div class="form-row">
						<div class="form-group flex-1">
							<label for="cust-input-name">Receiver Name</label>
							<div class="input-wrapper">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="input-icon"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
								<input type="text" id="cust-input-name" placeholder="Name of receiver/s" required />
							</div>
							<span id="name-prefill-subtext" style="display: none; font-size: 0.725rem; color: var(--text-muted); margin-top: 1px; font-style: italic;">
								Pre-filled based on details we have. You can still change it.
							</span>
							<span class="error-message">Name is required</span>
						</div>

						<div class="form-group flex-1">
							<label for="cust-input-contact">Contact Number</label>
							<div class="input-wrapper">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="input-icon"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
								<input type="text" inputmode="numeric" pattern="[0-9]*" id="cust-input-contact" placeholder="Receiver contact number" required />
							</div>
							<span id="contact-warning-subtext" style="display: none; font-size: 0.725rem; color: #ef4444; margin-top: 2px; font-weight: 500;">
								Only numbers are allowed.
							</span>
							<span id="contact-prefill-subtext" style="display: none; font-size: 0.725rem; color: var(--text-muted); margin-top: 1px; font-style: italic;">
								Pre-filled based on details we have. You can still change it.
							</span>
							<span class="error-message">Contact number is required</span>
						</div>
					</div>

					<div class="form-group">
						<label for="cust-input-fb">Facebook Name (Optional)</label>
						<div class="input-wrapper">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="input-icon"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
							<input type="text" id="cust-input-fb" placeholder="Facebook Profile Name (optional)" style="background: transparent; border: none; outline: none; width: 100%; color: var(--text-primary); font-family: var(--font-family); font-size: 0.875rem;" />
						</div>
					</div>

					<div class="form-group" id="cust-address-group">
						<label for="cust-input-address">Exact Address (for Delivery/Meetup)</label>
						<div class="input-wrapper" style="align-items: flex-start; padding-top: 8px;">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="input-icon" style="margin-top: 4px;"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
							<textarea id="cust-input-address" rows="3" placeholder="Enter complete address, landmark, block/lot, etc." style="width: 100%; background: transparent; border: none; outline: none; color: var(--text-primary); font-family: var(--font-family); font-size: 0.875rem; resize: vertical;" required></textarea>
						</div>
						<span class="error-message">Delivery address is required</span>
					</div>

					<div class="form-group">
						<label for="cust-input-datetime" id="cust-datetime-label">Delivery/Meetup Date & Time</label>
						<div class="input-wrapper">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="input-icon"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
							<input type="datetime-local" id="cust-input-datetime" required />
						</div>
						<span class="error-message">Delivery date and time are required</span>
					</div>

					<div class="form-group">
						<label for="cust-input-downpayment">Downpayment Amount to Send (₱)</label>
							<div class="input-wrapper">
								<span class="input-prefix" style="color: var(--text-secondary); font-weight: 600; margin-right: 8px;">₱</span>
								<input type="number" id="cust-input-downpayment" min="0" step="any" placeholder="Enter downpayment amount" required style="background: transparent; border: none; outline: none; width: 100%; color: var(--text-primary);" />
							</div>
						<span id="required-downpayment-subtext" style="font-size: 0.725rem; color: var(--text-muted); margin-top: 1px;">
							Pre-filled with the requested 50% downpayment. Feel free to adjust if paying more or less.
						</span>
						<span class="error-message">Please enter a valid downpayment amount</span>
					</div>

					<div class="downpayment-calculation-preview" style="background: rgba(255, 255, 255, 0.02); padding: 14px; border-radius: 10px; border: 1px dashed var(--border-color); font-size: 0.85rem; color: var(--text-secondary); display: flex; flex-direction: column; gap: 6px;">
						<div style="display: flex; justify-content: space-between;">
							<span>Total Order Value:</span>
							<span id="cust-calc-total" style="font-weight: 700;">₱0.00</span>
						</div>
						<div style="display: flex; justify-content: space-between; color: var(--accent-primary);">
							<span>Custom Downpayment:</span>
							<span id="cust-calc-downpayment" style="font-weight: 700;">₱0.00</span>
						</div>
						<div style="display: flex; justify-content: space-between; border-top: 1px dashed var(--border-color); padding-top: 6px; margin-top: 2px;">
							<span id="cust-calc-balance-label">Remaining Balance:</span>
							<span id="cust-calc-balance" style="font-weight: 700; color: var(--text-primary);">₱0.00</span>
						</div>
					</div>

					<div class="form-actions-right" style="margin-top: 10px; display: flex; gap: 12px; justify-content: flex-end;">
						<button type="button" class="btn btn-secondary" id="btn-backto-step-1">
							Back
						</button>
						<button type="submit" class="btn btn-primary" id="btn-submit-step-2">
							<span>Confirm & Next</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</button>
					</div>
				</form>
			</section>

			<!-- Step 3 Content: Review Details -->
			<section id="step-3-content" class="glass-panel step-content-card" style="display: none;">
				<div class="card-header-group">
					<h3>Review & Confirm Order Details</h3>
					<p>Please double-check all details below. You can go back and make changes if needed.</p>
				</div>

				<div class="review-details-summary" style="display: flex; flex-direction: column; gap: 20px; text-align: left;">
					<!-- Customer details card -->
					<div class="review-card" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 12px;">
						<h4 style="margin: 0; font-size: 0.95rem; font-weight: 800; color: var(--accent-primary); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 8px;">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
							<span>Customer & Fulfillment Info</span>
						</h4>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; font-size: 0.9rem;">
							<div style="display: flex; flex-direction: column; gap: 2px;">
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Receiver Name</span>
								<strong id="review-customer-name" style="color: var(--text-primary);">-</strong>
							</div>
							<div style="display: flex; flex-direction: column; gap: 2px;">
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Contact Number</span>
								<strong id="review-customer-contact" style="color: var(--text-primary);">-</strong>
							</div>
							<div style="display: flex; flex-direction: column; gap: 2px;">
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Facebook Name</span>
								<strong id="review-customer-fb" style="color: var(--text-primary);">-</strong>
							</div>
							<div style="display: flex; flex-direction: column; gap: 2px;">
