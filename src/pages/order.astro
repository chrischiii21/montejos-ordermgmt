	function updateLiveCalculation() {
		if (!currentOrder) return;
		const total = currentOrder.total;
		const val = custInputDownpayment.value.trim();
		const downpayment = val ? Math.max(0, parseFloat(val)) : 0;
		const balance = Math.max(0, total - downpayment);

		if (custCalcTotal) custCalcTotal.textContent = `₱${total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		if (custCalcDownpayment) custCalcDownpayment.textContent = `₱${downpayment.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		if (custCalcBalance) custCalcBalance.textContent = `₱${balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

		if (custCalcBalanceLabel) {
			const type = currentOrder.fulfillmentType || 'Delivery';
			if (type === 'Pickup') {
				custCalcBalanceLabel.textContent = 'Remaining Balance Upon Pickup:';
			} else if (type === 'Meetup') {
				custCalcBalanceLabel.textContent = 'Remaining Balance Upon Meetup:';
			} else {
				custCalcBalanceLabel.textContent = 'Remaining Balance Upon Delivery:';
			}
		}
	}

	// Apply settings passed via shareable link (encoded in 's' query param) or fallback to localStorage
	function applySharedSettingsFromUrl() {
		try {
			const params = new URLSearchParams(window.location.search);
			let s = params.get('s');
			
			let decoded: any = null;
			if (s) {
				// Decode UTF-8 Base64, replace spaces back to + in case browser URL decoded it
				const decodedStr = decodeURIComponent(escape(atob(s.replace(/ /g, '+'))));
				if (decodedStr.startsWith('{')) {
					// Fallback for old JSON links
					decoded = JSON.parse(decodedStr);
				} else {
					// New compact pipe-separated format
					const [maribankName, maribankNum, gcashName, gcashNum, dpPct] = decodedStr.split('|');
					decoded = { maribankName, maribankNum, gcashName, gcashNum, dpPct: dpPct ? parseFloat(dpPct) : 50 };
				}
			} else {
				// Fallback to localStorage if available (useful for local admin tests)
				const localSettingsStr = localStorage.getItem('flavorflow_settings');
				if (localSettingsStr) {
					decoded = JSON.parse(localSettingsStr);
				}
			}

			if (!decoded) return;

			if (decoded.maribankName) {
				document.querySelectorAll('.maribank-name').forEach(el => el.textContent = decoded.maribankName);
			}
			if (decoded.maribankNum) {
				document.querySelectorAll('.maribank-num').forEach(el => el.textContent = decoded.maribankNum);
				// Find copy button in Maribank header(s)
				document.querySelectorAll('.payment-box').forEach(box => {
					const brand = box.querySelector('.payment-brand');
					if (brand && brand.textContent?.includes('MARIBANK')) {
						const copyBtn = box.querySelector('.btn-copy-mini');
						if (copyBtn) copyBtn.setAttribute('data-copy', decoded.maribankNum);
					}
				});
			}
			if (decoded.gcashName) {
				document.querySelectorAll('.gcash-name').forEach(el => el.textContent = decoded.gcashName);
			}
			if (decoded.gcashNum) {
				document.querySelectorAll('.gcash-num').forEach(el => el.textContent = decoded.gcashNum);
				// Find copy button in GCash header(s)
				document.querySelectorAll('.payment-box').forEach(box => {
					const brand = box.querySelector('.payment-brand');
					if (brand && brand.textContent?.includes('GCASH')) {
						const copyBtn = box.querySelector('.btn-copy-mini');
						if (copyBtn) copyBtn.setAttribute('data-copy', decoded.gcashNum);
					}
				});
			}

			// Update downpayment percentages in text label/notes
			const pct = decoded.dpPct !== undefined ? decoded.dpPct : 50;
			const labelEl = document.getElementById('required-downpayment-label');
			if (labelEl) labelEl.textContent = `Required Downpayment (${pct}%)`;
			const noteEl = document.getElementById('required-downpayment-note');
			if (noteEl) {
				noteEl.innerHTML = `<strong>Note:</strong> To confirm your order, we request a ${pct}% downpayment of the total bill. The rest will be paid upon pickup/delivery of orders.`;
			}
			const subtextEl = document.getElementById('required-downpayment-subtext');
			if (subtextEl) {
				subtextEl.textContent = `Pre-filled with the requested ${pct}% downpayment. Feel free to adjust if paying more or less.`;
			}
		} catch (e) { /* ignore */ }
	}

