<script>
	import { createClient } from '@supabase/supabase-js';
	import { MENU_ITEMS, PACKAGE_INCLUSIONS, getInclusionsForForm, getInclusionOptions, resolveChosenDessert } from '../lib/menu';
	import { SERVICE_AREA_TOWNS, areaDistance } from '../lib/service-areas';
	import { normalizePhMobile, isValidPhMobile } from '../lib/phone';

	const supabase = createClient(
		import.meta.env.PUBLIC_SUPABASE_URL,
		import.meta.env.PUBLIC_SUPABASE_ANON_KEY
	);

// showConfirm: displays the custom confirmation modal and resolves true/false
function showConfirm(message) {
	return new Promise((resolve) => {
		const overlay = document.getElementById('confirm-modal-overlay');
		const msg = document.getElementById('confirm-modal-message');
		const okBtn = document.getElementById('confirm-ok-btn');
		const cancelBtn = document.getElementById('confirm-cancel-btn');
		const closeBtn = document.getElementById('close-confirm-modal-btn');
		if (!overlay || !msg || !okBtn || !cancelBtn) return resolve(false);
		msg.textContent = message || 'Are you sure?';
		overlay.classList.add('active');

		// Accessibility: focus and keyboard handlers
		const prevActive = document.activeElement;
		okBtn.focus();

		const onKey = (e) => {
			if (e.key === 'Escape') { e.preventDefault(); doCancel(); }
			if (e.key === 'Enter') { e.preventDefault(); doOk(); }
		};

		const onOverlayClick = (e) => {
			if (e.target === overlay) doCancel();
		};

		const cleanup = () => {
			overlay.classList.remove('active');
			okBtn.removeEventListener('click', doOk);
			cancelBtn.removeEventListener('click', doCancel);
			closeBtn?.removeEventListener('click', doCancel);
			overlay.removeEventListener('click', onOverlayClick);
			document.removeEventListener('keydown', onKey);
			try { prevActive?.focus(); } catch (e) {}
		};

		const doOk = () => { cleanup(); resolve(true); };
		const doCancel = () => { cleanup(); resolve(false); };

		okBtn.addEventListener('click', doOk);
		cancelBtn.addEventListener('click', doCancel);
		closeBtn?.addEventListener('click', doCancel);
		overlay.addEventListener('click', onOverlayClick);
		document.addEventListener('keydown', onKey);
	});
}

	// Type definition for Order
	interface OrderItem {
		name: string;
		quantity: number;
		price: number;
		total: number;
		customInclusions?: string[];
	}

	interface Order {
		id: string;
		date: string;
		customer: string;
		address: string;
		contact: string;
		deliveryDateTime: string;
		items: OrderItem[];
		total: number;
		downpayment: number;
		balance: number;
		status: 'Pending' | 'Preparing' | 'Completed' | 'Cancelled';
		fulfillmentType?: 'Pickup' | 'Meetup' | 'Delivery';
		deliveryFee?: number;
		facebookName?: string;
	}

	// Constants (Settings still use localStorage — it's UI config only)
	// MENU_ITEMS, PACKAGE_INCLUSIONS, getInclusionsForForm are imported from ../lib/menu

	function getInclusions(it: OrderItem): string[] | null {
		if (it.customInclusions && it.customInclusions.length > 0) {
			return resolveChosenDessert(it.name, it.customInclusions);
		}
		return getInclusionsForForm(it.name);
	}

	function isPackageOrTrayOrLechon(name: string): boolean {
		const n = name.toLowerCase();
		
		// 1. Packages & Combos
		if (
			n.includes('package') || 
			n.includes('set ') || 
			n.includes('combo') || 
			n.includes('meal') || 
			n.includes('bilao') || 
			n.startsWith('p1') || 
			n.startsWith('p2') || 
			n.startsWith('p3') || 
			n.startsWith('p4') || 
			n.startsWith('p5') || 
			n.startsWith('p6') ||
			n.includes('seapork') ||
			n.includes('all-in-one') ||
			n.includes('bam-i + lumpia')
		) {
			return true;
		}
		
		// 2. Trays
		if (n.includes('tray')) {
			return true;
		}
		
		// 3. Whole Lechon or Lechon Belly
		if (
			n.includes('whole lechon') || 
			n.includes('lechon belly') || 
			n.includes('lechon baboy') ||
			n.includes('family lechon') ||
			n.includes('barkada lechon') ||
			n.includes('jumbo lechon') ||
			n.includes('fiesta lechon') ||
			n.includes('grande lechon')
		) {
			return true;
		}
		
		return false;
	}

	function normalizeItemName(name: string): string {
		let n = name.trim();
		// Replace multiple spaces
		n = n.replace(/\s+/g, ' ');
		// Convert "Kilos" to "kilos", etc.
		n = n.replace(/\bKilos\b/gi, 'kilos');
		n = n.replace(/\bKls\b/gi, 'kilos');
		n = n.replace(/\bKilo\b/gi, 'kilo');
		
		// Normalize casing of words
		n = n.split(' ').map(w => {
			const lower = w.toLowerCase();
			if (lower === 'kilos' || lower === 'kilo') {
				return 'kilos'; // unify to "kilos"
			}
			return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase();
		}).join(' ');
		
		// Fix minor differences like "Lechonbelly" to "Lechon Belly"
		n = n.replace(/Lechonbelly/gi, 'Lechon Belly');
		n = n.replace(/Lechon Belly (\d+) kilos/gi, 'Lechon Belly ($1 kilos)');
		n = n.replace(/Lechon Belly (\d+) Kilos/gi, 'Lechon Belly ($1 kilos)');
		
		return n;
	}

	function getItemCategory(name: string): string | null {
		const n = name.toLowerCase();
		
		// 1. Lechon Packages
		if (n.includes('1 whole lechon baboy') || (n.includes('set ') && n.includes('package'))) {
			return 'Lechon Packages';
		}
		
		// 2. Lechon Belly Packages
		if (
			(n.startsWith('p1') || n.startsWith('p2') || n.startsWith('p3') || n.startsWith('p4') || n.startsWith('p5') || n.startsWith('p6')) && 
			(n.includes('package') || n.includes('bilao'))
		) {
			return 'Lechon Belly Packages';
		}
		
		// 3. Combo Meals
		if (
			n.includes('seapork') || 
			n.includes('chixseapork') || 
			n.includes('bam-i + lumpia') || 
			n.includes('all-in-one') || 
			n.includes('family meal')
		) {
			return 'Combo Meals';
		}

		// 4. Whole Lechon alone
		if (
			n.includes('whole lechon') || 
			n.includes('lechon baboy') ||
			n.includes('family lechon') ||
			n.includes('barkada lechon') ||
			n.includes('jumbo lechon') ||
			n.includes('fiesta lechon') ||
			n.includes('grande lechon') ||
			n.includes('el\' grande lechon')
		) {
			return 'Whole Lechon';
		}
		
		// 5. Lechon Belly alone
		if (n.includes('lechon belly')) {
			return 'Lechon Belly';
		}
		
		// 6. Food Trays
		// A. Chicken
		if (
			n.includes('chicken') || 
			n.includes('cordon') || 
			n.includes('teriyaki') || 
			n.includes('buffalo') || 
			n.includes('adobo') || 
			n.includes('ala king')
		) {
			return 'Food Trays (Chicken)';
		}
		
		// B. Seafood
		if (
			n.includes('shrimp') || 
			n.includes('calamares') || 
			n.includes('tempura') || 
			n.includes('escabeche') || 
			n.includes('fish fillet')
		) {
			return 'Food Trays (Seafood)';
		}
		
		// C. Pork
		if (
			n.includes('lumpia') || 
			n.includes('shanghai') || 
			n.includes('pork chop') || 
			n.includes('tonkatsu') || 
			n.includes('menudo') || 
			n.includes('sweet & sour pork') ||
			n.includes('sweet and sour pork')
		) {
			return 'Food Trays (Pork)';
		}
		
		// D. Pasta/Noodles
		if (n.includes('bam-i') || n.includes('bam-e') || n.includes('spaghetti') || n.includes('carbonara')) {
			return 'Food Trays (Noodles/Pasta)';
		}
		
		// E. Veggie/Dessert
		if (
			n.includes('salad') || 
			n.includes('pandan') || 
			n.includes('float') || 
			n.includes('maja') || 
			n.includes('jelly') || 
			n.includes('fruta') || 
			n.includes('chopseuy')
		) {
			return 'Food Trays (Veggie/Desserts)';
		}
		
		return null;
	}

	function formatDateTime12h(dateTimeStr: string): string {
		if (!dateTimeStr) return '';
		const d = new Date(dateTimeStr.replace(' ', 'T'));
		if (isNaN(d.getTime())) return dateTimeStr;
		return d.toLocaleString('en-US', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
			hour: 'numeric',
			minute: '2-digit',
			hour12: true
		});
	}

	function escapeHtml(unsafe: string) {
		if (!unsafe) return '';
		return unsafe
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#039;');
	}

	function formatTime12h(dateTimeStr: string): string {
		if (!dateTimeStr) return '';
		const d = new Date(dateTimeStr.replace(' ', 'T'));
		if (isNaN(d.getTime())) return dateTimeStr;
		return d.toLocaleString('en-US', {
			hour: 'numeric',
			minute: '2-digit',
			hour12: true
		});
	}

	// Application State
	let orders: Order[] = [];
	let currentFilter = 'All';
	let searchQuery = '';
	let tempOrderItems: OrderItem[] = [];
	let slipFiller: 'Owner' | 'Customer' = 'Owner';
	let selectedFulfillment: 'Pickup' | 'Meetup' | 'Delivery' = 'Pickup';
	// 'customer' = the customer picks Pickup/Meetup/Delivery on their order link (saved as null); 'owner' = set here.
	let fulfillmentChooser: 'customer' | 'owner' = 'customer';

	// ── Supabase helpers ──────────────────────────────────────
	function mapRow(row: any): Order {
		return {
			id: row.id,
			date: row.date,
			customer: row.customer,
			note: row.note ?? '',
			address: row.address,
			contact: row.contact,
			deliveryDateTime: row.delivery_date_time ?? '',
			fulfillmentType: row.fulfillment_type ?? undefined, // empty = customer chooses on their link
			status: row.status,
			total: parseFloat(row.total),
			downpayment: parseFloat(row.downpayment),
			balance: parseFloat(row.balance),
			deliveryFee: parseFloat(row.delivery_fee ?? 0),
			facebookName: row.facebook_name ?? '',
			items: (row.order_items ?? []).map((it: any) => ({
				name: it.name,
				quantity: it.quantity,
				price: parseFloat(it.price),
				total: parseFloat(it.total),
				customInclusions: it.custom_inclusions ?? []
			}))
		};
	}

	function checkAndTransitionOrderStatus(order: Order): string {
		if (order.status === 'Completed' || order.status === 'Cancelled') {
			return order.status;
		}
		const deliveryStr = order.deliveryDateTime;
		if (!deliveryStr) return order.status;

		const deliveryTime = new Date(deliveryStr.replace(' ', 'T'));
		if (isNaN(deliveryTime.getTime())) return order.status;

		const now = new Date();
		const diffMs = deliveryTime.getTime() - now.getTime();
		const diffHours = diffMs / (1000 * 60 * 60);

		let newStatus = order.status;
		if (now >= deliveryTime) {
			newStatus = 'Completed';
		} else if (diffHours <= 4) {
			newStatus = 'Preparing';
		}

		if (newStatus !== order.status) {
			order.status = newStatus as 'Pending' | 'Preparing' | 'Completed' | 'Cancelled';
			
			// Fire-and-forget update to Supabase
			supabase
				.from('orders')
				.update({ status: newStatus })
				.eq('id', order.id)
				.then(({ error }) => {
					if (error) {
						console.error(`Error auto-updating status for ${order.id}:`, error.message);
					} else {
						console.log(`Auto-updated order ${order.id} status to ${newStatus} based on schedule.`);
					}
				});
		}

		return newStatus;
	}

	async function loadOrders(): Promise<void> {
		const { data, error } = await supabase
			.from('orders')
			.select('*, order_items(*)')
			.order('created_at', { ascending: false });
		if (error) { console.error('Error loading orders:', error.message); return; }
		orders = (data ?? []).map(mapRow);

		// Auto-transition statuses based on schedule
		orders.forEach(checkAndTransitionOrderStatus);
	}

	async function saveState(): Promise<void> {
		// No-op: individual mutations now go directly to Supabase.
		// Kept for call-site compatibility — callers simply await this.
	}

	// Initialize the Dashboard
	document.addEventListener('DOMContentLoaded', async () => {
		// Set current date
		updateDateDisplay();

		// Set default payment and downpayment details in the order form from settings
		updateFormPaymentDetails();

		// Load orders from Supabase
		await loadOrders();

		// Initial render and calculations
		updateDashboard();

		// Set up event listeners
		setupEventListeners();
		setupGlanceAndPrep();
		loadCustomerDrafts();
		setInterval(loadCustomerDrafts, 60 * 1000); // keep "Customer filling in" current
		setupFormListeners();
		setupFormDraft();
		setupNavigation();
		setupFamilyLink();

		// Mobile Sidebar Toggle
		const mobileMenuBtn = document.getElementById('mobile-menu-btn');
		const sidebar = document.querySelector('.sidebar');
		const sidebarOverlay = document.getElementById('sidebar-overlay');

		if (mobileMenuBtn && sidebar && sidebarOverlay) {
			mobileMenuBtn.addEventListener('click', () => {
				sidebar.classList.add('active');
				sidebarOverlay.classList.add('active');
			});

			sidebarOverlay.addEventListener('click', () => {
				sidebar.classList.remove('active');
				sidebarOverlay.classList.remove('active');
			});

			sidebar.querySelectorAll('.nav-item').forEach(link => {
				link.addEventListener('click', () => {
					sidebar.classList.remove('active');
					sidebarOverlay.classList.remove('active');
				});
			});
		}

		// Initial view routing based on URL hash to preserve view state on refresh
		const initialView = window.location.hash.slice(1) || 'dashboard';
		const validViews = ['dashboard', 'order-history', 'analytics', 'live-kitchen', 'calendar', 'settings'];
		if (validViews.includes(initialView)) {
			navigateTo(initialView);
		} else {
			navigateTo('dashboard');
		}
	});

	function updateDateDisplay() {
		const dateEl = document.getElementById('current-date');
		if (dateEl) {
			const options: Intl.DateTimeFormatOptions = { 
				weekday: 'long', 
				year: 'numeric', 
				month: 'long', 
				day: 'numeric' 
			};
			dateEl.textContent = new Date().toLocaleDateString('en-US', options);
		}
	}

	function updateDashboard() {
		renderGlance();
		renderPrepList();
		renderOrdersTable();
		updateTabCounts();
		if (document.getElementById('view-order-history')?.style.display !== 'none') {
			renderHistoryView();
		}
		if (document.getElementById('view-calendar')?.style.display !== 'none') {
			renderCalendarView();
		}
	}

	// ---------- Customer link progress (drafts saved from the order link, see src/lib/order-drafts.ts) ----------
	let customerDrafts: Record<string, { step: number; filled: number; openedAt: string; updatedAt: string }> = {};
	function timeAgo(iso: string): string {
		const mins = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
		if (mins < 1) return 'just now';
		if (mins < 60) return `${mins} min ago`;
		const hrs = Math.round(mins / 60);
		if (hrs < 24) return `${hrs} hr${hrs === 1 ? '' : 's'} ago`;
		const days = Math.round(hrs / 24);
		return `${days} day${days === 1 ? '' : 's'} ago`;
	}
	/** Badge next to "Awaiting customer details": link opened / customer filling in (step, last activity). */
	function draftBadge(orderId: string): string {
		const d = customerDrafts[orderId];
		if (!d) return '';
		const ago = timeAgo(d.updatedAt);
		const title = `Link first opened ${new Date(d.openedAt).toLocaleString('en-US')}`;
		return d.filled > 0
			? `<span class="draft-badge is-filling" title="${title}">Customer filling in · step ${d.step} of 3 · ${ago}</span>`
			: `<span class="draft-badge" title="${title}">Link opened · ${ago}</span>`;
	}
	async function loadCustomerDrafts() {
		try {
			const res = await fetch('/api/order-draft', { cache: 'no-store' });
			if (!res.ok) return;
			customerDrafts = (await res.json()).drafts ?? {};
			updateDashboard();
		} catch { /* badges are optional */ }
	}

	// Helper: return active orders excluding placeholder customer rows
	function getActiveOrders() {
		return orders.filter(o => (o.status === 'Pending' || o.status === 'Preparing') && ((o.customer || '').toString().trim() !== 'Pending Customer Details' && (o.customer || '').toString().trim() !== '' && !!o.deliveryDateTime));
	}


	// 2. At a glance + Prep list (dashboard)
	// Local 'YYYY-MM-DD' for a Date, matching the first 10 chars of deliveryDateTime.
	function localDayKey(d: Date): string {
		return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
	}
	function pesoAmt(n: number): string {
		return '₱' + (n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
	}
	function orderWhen(o: Order): Date | null {
		if (!o.deliveryDateTime) return null;
		const d = new Date(o.deliveryDateTime.replace(' ', 'T'));
		return isNaN(d.getTime()) ? null : d;
	}
	function ordersOnDay(key: string): Order[] {
		return orders
			.filter(o => o.status !== 'Cancelled' && (o.deliveryDateTime || '').slice(0, 10) === key)
			.sort((a, b) => (a.deliveryDateTime || '').localeCompare(b.deliveryDateTime || ''));
	}
	function displayCustomer(o: Order): string {
		const c = (o.customer || '').trim();
		return c && c !== 'Pending Customer Details' ? c : 'Pending customer details';
	}

	// Which day the prep list shows: 'today', 'tomorrow' or a 'YYYY-MM-DD' picked in the date box.
	let prepDay: string = 'today';
	function prepDayKey(): string {
		if (prepDay === 'today') return localDayKey(new Date());
		if (prepDay === 'tomorrow') return localDayKey(new Date(Date.now() + 864e5));
		return prepDay;
	}

	function renderGlance() {
		const now = new Date();
		const days: [string, Date][] = [['today', now], ['tomorrow', new Date(now.getTime() + 864e5)]];
		for (const [id, date] of days) {
			const key = localDayKey(date);
			const list = ordersOnDay(key);
			const pickups = list.filter(o => o.fulfillmentType === 'Pickup' || o.fulfillmentType === 'Meetup').length;
			const deliveries = list.length - pickups;
			const set = (suffix: string, text: string) => { const el = document.getElementById(`glance-${id}-${suffix}`); if (el) el.textContent = text; };
			set('date', date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }));
			set('count', `${list.length} order${list.length === 1 ? '' : 's'}`);
			set('split', list.length ? `${deliveries} delivery · ${pickups} pickup` : 'Nothing scheduled');
			let next = '';
			if (list.length) {
				const upcoming = list.find(o => o.status !== 'Completed' && (orderWhen(o)?.getTime() ?? 0) > now.getTime());
				if (upcoming) next = `Next: ${formatTime12h(upcoming.deliveryDateTime)} · ${displayCustomer(upcoming)}`;
				else if (id === 'today') next = 'All of today’s orders are done';
			}
			set('next', next);
			document.getElementById(`glance-${id}`)?.classList.toggle('is-selected', prepDay === id);
		}

		// Balance still owed on orders due from today through the next 7 days.
		const start = new Date(now); start.setHours(0, 0, 0, 0);
		const end = new Date(start.getTime() + 8 * 864e5);
		const owing = orders
			.filter(o => {
				if (o.status === 'Cancelled' || o.status === 'Completed' || !(o.balance > 0)) return false;
				const w = orderWhen(o);
				return !!w && w >= start && w < end;
			})
			.sort((a, b) => (a.deliveryDateTime || '').localeCompare(b.deliveryDateTime || ''));
		const total = owing.reduce((s, o) => s + o.balance, 0);
		const totalEl = document.getElementById('glance-collect-total');
		const countEl = document.getElementById('glance-collect-count');
		const listEl = document.getElementById('glance-collect-list');
		if (totalEl) totalEl.textContent = pesoAmt(total);
		if (countEl) countEl.textContent = owing.length ? `from ${owing.length} order${owing.length === 1 ? '' : 's'}` : 'Nothing left to collect';
		if (listEl) {
			const SHOW = 4;
			listEl.innerHTML = owing.slice(0, SHOW).map(o => {
				const w = orderWhen(o)!;
				const when = localDayKey(w) === localDayKey(now) ? 'Today' : localDayKey(w) === localDayKey(new Date(now.getTime() + 864e5)) ? 'Tomorrow' : w.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
				return `<li><button type="button" class="glance-collect-row" data-id="${escapeHtml(o.id)}" title="View order">
					<span class="glance-collect-name">${escapeHtml(displayCustomer(o))}</span>
					<span class="glance-collect-when">${escapeHtml(when)}</span>
					<span class="glance-collect-amt">${pesoAmt(o.balance)}</span>
				</button></li>`;
			}).join('') + (owing.length > SHOW ? `<li class="glance-collect-more">+ ${owing.length - SHOW} more</li>` : '');
		}
	}

	// Package name for an item; old orders stored Set A/B/C packages as "1 Whole Lechon Baboy" at the set price.
	function prepItemName(item: OrderItem): string {
		const name = normalizeItemName(item.name);
		if (name === '1 Whole Lechon Baboy') {
			if (item.price === 15999) return 'Set A Lechon Package';
			if (item.price === 18675) return 'Set B Lechon Package';
			if (item.price === 19999) return 'Set C Lechon Package';
		}
		return name;
	}

	// "1 tray Buttered Shrimps" × 3 → "3 tray Buttered Shrimps"
	function multiplyInclusion(line: string, qty: number): string {
		const m = line.trim().match(/^(\d+(?:\.\d+)?)\s+(.*)$/);
		if (m) return `${Number(m[1]) * qty} ${m[2]}`;
		return qty > 1 ? `${qty}× ${line}` : line;
	}

	function renderPrepList() {
		const listEl = document.getElementById('prep-list');
		if (!listEl) return;
		const key = prepDayKey();
		const dayOrders = ordersOnDay(key);

		// Controls reflect the current choice.
		document.querySelectorAll<HTMLElement>('.prep-seg-btn').forEach(b => b.classList.toggle('active', b.dataset.prepDay === prepDay));
		const dateInput = document.getElementById('prep-date') as HTMLInputElement | null;
		if (dateInput) {
			dateInput.value = key;
			dateInput.classList.toggle('active', prepDay !== 'today' && prepDay !== 'tomorrow');
		}
		const label = document.getElementById('prep-day-label');
		if (label) {
			const d = new Date(key + 'T00:00:00');
			const prefix = prepDay === 'today' ? 'Today, ' : prepDay === 'tomorrow' ? 'Tomorrow, ' : '';
			label.textContent = prefix + d.toLocaleDateString('en-US', { weekday: prefix ? undefined : 'long', month: 'long', day: 'numeric', year: prefix ? undefined : 'numeric' });
		}

		// Add up identical items (same name + same inclusions) across the day's orders.
		const groups = new Map<string, { name: string; qty: number; orderIds: Set<string>; incl: string[] }>();
		for (const o of dayOrders) {
			for (const item of o.items || []) {
				const name = prepItemName(item);
				const incl = (item.customInclusions && item.customInclusions.length ? resolveChosenDessert(item.name, item.customInclusions) : getInclusionsForForm(item.name) || getInclusionsForForm(name)) || [];
				const gKey = name + '|' + incl.join(';');
				const g = groups.get(gKey) ?? { name, qty: 0, orderIds: new Set<string>(), incl };
				g.qty += Number(item.quantity) || 0;
				g.orderIds.add(o.id);
				groups.set(gKey, g);
			}
		}

		const CATEGORY_ORDER = ['Whole Lechon', 'Lechon Packages', 'Lechon Belly', 'Lechon Belly Packages', 'Combo Meals', 'Food Trays (Pork)', 'Food Trays (Chicken)', 'Food Trays (Seafood)', 'Food Trays (Noodles/Pasta)', 'Food Trays (Veggie/Desserts)'];
		const rank = (n: string) => { const i = CATEGORY_ORDER.indexOf(getItemCategory(n) || ''); return i < 0 ? 99 : i; };
		const items = [...groups.values()].sort((a, b) => rank(a.name) - rank(b.name) || a.name.localeCompare(b.name));

		const summary = document.getElementById('prep-summary');
		const totalQty = items.reduce((s, g) => s + g.qty, 0);
		if (summary) summary.textContent = dayOrders.length
			? `${totalQty} item${totalQty === 1 ? '' : 's'} from ${dayOrders.length} order${dayOrders.length === 1 ? '' : 's'}`
			: 'Everything to prepare, added up';

		if (!items.length) {
			listEl.innerHTML = `<li class="prep-empty">No orders on this day.</li>`;
			return;
		}
		listEl.innerHTML = items.map(g => `<li class="prep-item">
			<div class="prep-item-main">
				<span class="prep-qty">${g.qty}×</span>
				<span class="prep-name">${escapeHtml(g.name)}</span>
				<span class="prep-orders">${g.orderIds.size} order${g.orderIds.size === 1 ? '' : 's'}</span>
			</div>
			${g.incl.length ? `<ul class="prep-incl">${g.incl.map(l => `<li>${escapeHtml(multiplyInclusion(l, g.qty))}</li>`).join('')}</ul>` : ''}
		</li>`).join('');
	}

	function setPrepDay(day: string) {
		prepDay = day;
		renderPrepList();
		renderGlance();
	}

	function setupGlanceAndPrep() {
		document.querySelectorAll<HTMLElement>('[data-prep-day]').forEach(el => {
			el.addEventListener('click', () => {
				setPrepDay(el.dataset.prepDay!);
				// On narrow screens the prep list is below the order list, so bring it into view.
				if (el.classList.contains('glance-card') && window.innerWidth < 1200) {
					document.querySelector('.prep-container')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}
			});
		});
		document.getElementById('prep-date')?.addEventListener('change', e => {
			const v = (e.target as HTMLInputElement).value;
			if (!v) return;
			const today = localDayKey(new Date());
			const tomorrow = localDayKey(new Date(Date.now() + 864e5));
			setPrepDay(v === today ? 'today' : v === tomorrow ? 'tomorrow' : v);
		});
		document.getElementById('glance-collect-list')?.addEventListener('click', e => {
			const row = (e.target as HTMLElement).closest<HTMLElement>('.glance-collect-row[data-id]');
			if (row) openDetailsModal(row.dataset.id!);
		});
		// Keep "Next:" and the day rollover current without a reload.
		setInterval(() => { renderGlance(); renderPrepList(); }, 60 * 1000);
	}

	// 3. Render Orders Table (dashboard preview)
	function renderOrdersTable() {
		const tableBody = document.getElementById('order-table-body');
		const emptyState = document.getElementById('table-empty-state');
		if (!tableBody || !emptyState) return;

		// Filter orders
		let filteredOrders = orders;

		// 1. Status Filter
		if (currentFilter !== 'All') {
			if (currentFilter === 'PendingCustomer') {
				// show orders that still have placeholder customer details or no delivery details
				filteredOrders = filteredOrders.filter(o => ((o.customer || '').trim() === 'Pending Customer Details' || (o.customer || '').trim() === '' || !o.deliveryDateTime) && o.status !== 'Completed' && o.status !== 'Cancelled');
			} else if (currentFilter === 'Pending') {
				// Pending tab should only show pending orders that already have customer details and delivery details
				filteredOrders = filteredOrders.filter(o => o.status === 'Pending' && ((o.customer || '').trim() !== 'Pending Customer Details' && (o.customer || '').trim() !== '' && !!o.deliveryDateTime));
			} else {
				filteredOrders = filteredOrders.filter(o => o.status === currentFilter);
			}
		}

		// 2. Search query filter
		const isSearching = searchQuery.trim() !== '';
		if (isSearching) {
			const query = searchQuery.toLowerCase().trim();
			filteredOrders = filteredOrders.filter(o => {
				try {
					const idMatch = (o.id || '').toString().toLowerCase().includes(query);
					const custMatch = ((o.customer || '')).toString().toLowerCase().includes(query);
					const itemsMatch = Array.isArray(o.items) && o.items.some(item => ((item.name || '')).toString().toLowerCase().includes(query));
					return idMatch || custMatch || itemsMatch;
				} catch (e) {
					console.error('Search filter error for order', o && o.id, e);
					return false;
				}
			});
		}

		// 3. Sort: upcoming (future delivery) first by soonest, then past orders newest-first
		const now = new Date();
		const upcoming = filteredOrders
			.filter(o => {
				const dt = new Date((o.deliveryDateTime || o.date).replace(' ', 'T'));
				return !isNaN(dt.getTime()) && dt > now;
			})
			.sort((a, b) => {
				const da = new Date((a.deliveryDateTime || a.date).replace(' ', 'T')).getTime();
				const db = new Date((b.deliveryDateTime || b.date).replace(' ', 'T')).getTime();
				return da - db; // soonest first
			});

		const past = filteredOrders
			.filter(o => {
				const dt = new Date((o.deliveryDateTime || o.date).replace(' ', 'T'));
				return isNaN(dt.getTime()) || dt <= now;
			})
			.sort((a, b) => {
				const da = new Date((a.deliveryDateTime || a.date).replace(' ', 'T')).getTime();
				const db = new Date((b.deliveryDateTime || b.date).replace(' ', 'T')).getTime();
				return db - da; // newest first
			});

		const sorted = [...upcoming, ...past];

		// 4. Limit to 5 rows in default (no search, no active status filter)
		const PREVIEW_LIMIT = 5;
		const isLimited = !isSearching && currentFilter === 'All' && sorted.length > PREVIEW_LIMIT;
		const displayed = isLimited ? sorted.slice(0, PREVIEW_LIMIT) : sorted;

		// Show/hide empty state
		try {
			if (displayed.length === 0) {
				tableBody.innerHTML = '';
				emptyState.style.display = 'flex';
				return;
			} else {
				emptyState.style.display = 'none';
			}
		} catch (err) {
			console.error('Error rendering orders table empty state:', err);
		}

		// Render rows
		tableBody.innerHTML = displayed.map(order => {
			// owner note for pending-customer orders (from DB `note` field)
			let noteHtml = '';
			try {
				const note = (order.note || '').toString();
				if (note && (order.customer === 'Pending Customer Details' || (order.customer || '').trim() === '')) {
					noteHtml = `<div class="owner-note" style="font-size:0.75rem;color:var(--text-secondary);margin-top:4px;">FB: ${escapeHtml(note)}</div>`;
				}
			} catch (e) { }
			const statusClass = `badge-${order.status.toLowerCase()}`;
			const isUpcoming = upcoming.includes(order);

			return `
				<tr data-order-id="${order.id}"${isUpcoming ? ' class="row-upcoming"' : ''}>
					<td>
						<button class="action-btn btn-view-details" data-id="${order.id}" title="View Details">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0z"/><circle cx="12" cy="12" r="3"/></svg>
						</button>
					</td>
					<td class="order-id-cell">#${order.id.replace('ORD-', '')}</td>
					<td class="customer-cell">
						<div class="customer-cell-inner">
							<span class="customer-name">${(order.customer && order.customer !== 'Pending Customer Details') ? escapeHtml(order.customer) : '<span class="text-muted">Pending Customer Details</span>'}</span>
							${(order.customer === 'Pending Customer Details' || !order.customer || !order.deliveryDateTime) ? `<span class="awaiting-badge">Awaiting customer details</span>${draftBadge(order.id)}` : ''}
						</div>
						${(order.contact && order.contact.trim()) ? `<div class="customer-contact" style="font-size:0.75rem;color:var(--text-muted);margin-top:2px;">${escapeHtml(order.contact)}</div>` : ''}
						${noteHtml}
					</td>
					<td class="date-cell">${order.deliveryDateTime ? formatDateTime12h(order.deliveryDateTime) : '<span class="text-muted">Pending Customer Input</span>'}</td>
					<td class="amount-cell">
						<div class="amt-total">${pesoAmt(order.total)}</div>
						<div class="amt-sub">DP ${pesoAmt(order.downpayment)} · ${order.balance > 0 ? `<span class="is-due">Bal ${pesoAmt(order.balance)}</span>` : '<span class="is-paid">Paid</span>'}</div>
						${(!(order.downpayment > 0) && order.total > 0 && order.status !== 'Completed' && order.status !== 'Cancelled') ? '<span class="unpaid-dp-badge">No DP yet</span>' : ''}
					</td>
					<td><span class="status-badge ${statusClass}">${order.status}</span></td>
				</tr>
			`;
		}).join('');

		// Re-bind click event listeners to table action buttons
		bindTableActionButtons();
	}

	// 4. Counts in Tabs
	function updateTabCounts() {
		const countAll = document.getElementById('hcount-all');
		const countPending = document.getElementById('hcount-pending');
		const countPendingCustomer = document.getElementById('hcount-pending-customer');
		const countPreparing = document.getElementById('hcount-preparing');
		const countCompleted = document.getElementById('hcount-completed');
		const countCancelled = document.getElementById('hcount-cancelled');

		if (countAll) countAll.textContent = orders.length.toString();
		if (countPending) countPending.textContent = orders.filter(o => o.status === 'Pending' && ((o.customer || '').trim() !== 'Pending Customer Details' && (o.customer || '').trim() !== '' && !!o.deliveryDateTime)).length.toString();
		if (countPendingCustomer) countPendingCustomer.textContent = orders.filter(o => ((o.customer || '').trim() === 'Pending Customer Details' || (o.customer || '').trim() === '' || !o.deliveryDateTime) && o.status !== 'Completed' && o.status !== 'Cancelled').length.toString();
		if (countPreparing) countPreparing.textContent = orders.filter(o => o.status === 'Preparing').length.toString();
		if (countCompleted) countCompleted.textContent = orders.filter(o => o.status === 'Completed').length.toString();
		if (countCancelled) countCancelled.textContent = orders.filter(o => o.status === 'Cancelled').length.toString();

		// Dashboard OrderTable counts (IDs used in the dashboard component)
		const d_countAll = document.getElementById('count-all');
		const d_countPending = document.getElementById('count-pending');
		const d_countPreparing = document.getElementById('count-preparing');
		const d_countCompleted = document.getElementById('count-completed');
		const d_countCancelled = document.getElementById('count-cancelled');

		if (d_countAll) d_countAll.textContent = orders.length.toString();
		if (d_countPending) d_countPending.textContent = orders.filter(o => o.status === 'Pending' && ((o.customer || '').trim() !== 'Pending Customer Details' && (o.customer || '').trim() !== '' && !!o.deliveryDateTime)).length.toString();
		if (d_countPreparing) d_countPreparing.textContent = orders.filter(o => o.status === 'Preparing').length.toString();
		if (d_countCompleted) d_countCompleted.textContent = orders.filter(o => o.status === 'Completed').length.toString();
		if (d_countCancelled) d_countCancelled.textContent = orders.filter(o => o.status === 'Cancelled').length.toString();
	}

	// 5. Actions / Event Listeners
	function setupEventListeners() {
		// Modal Toggle
		const openBtn = document.getElementById('open-order-modal-btn');
		const closeBtn = document.getElementById('close-order-modal-btn');
		const cancelBtn = document.getElementById('cancel-order-btn');
		const overlay = document.getElementById('order-modal-overlay');

		const openModal = () => {
			overlay?.classList.add('active');
			populatePastCustomersDatalists();
		};
		const closeModal = () => {
			overlay?.classList.remove('active');
			resetForm();
		};

		openBtn?.addEventListener('click', openModal);
		closeBtn?.addEventListener('click', closeModal);
		cancelBtn?.addEventListener('click', closeModal);
		overlay?.addEventListener('click', (e) => {
			if (e.target === overlay) closeModal();
		});

		// Search Input
		const searchInput = document.getElementById('order-search');
		searchInput?.addEventListener('input', (e) => {
			searchQuery = (e.target as HTMLInputElement).value;
			renderOrdersTable();
		});

		// Tab view-all button
		const tabViewAllBtn = document.getElementById('tab-view-all-btn');
		if (tabViewAllBtn && !tabViewAllBtn.dataset.bound) {
			tabViewAllBtn.dataset.bound = '1';
			tabViewAllBtn.addEventListener('click', () => navigateTo('order-history'));
		}

		// Filter Tabs
		const tabContainer = document.getElementById('order-status-tabs');
		const tabs = tabContainer?.querySelectorAll('.filter-tab');
		tabs?.forEach(tab => {
			tab.addEventListener('click', () => {
				tabs.forEach(t => t.classList.remove('active'));
				tab.classList.add('active');
				currentFilter = tab.getAttribute('data-status') || 'All';
				renderOrdersTable();
			});
		});

		// Link Modal Toggle Handlers
		const linkModalOverlay = document.getElementById('link-modal-overlay');
		const closeLinkModalBtn = document.getElementById('close-link-modal-btn');
		const closeLinkModalActionBtn = document.getElementById('close-link-modal-action-btn');
		
		const closeLinkModal = () => {
			linkModalOverlay?.classList.remove('active');
		};
		closeLinkModalBtn?.addEventListener('click', closeLinkModal);
		closeLinkModalActionBtn?.addEventListener('click', closeLinkModal);
		linkModalOverlay?.addEventListener('click', (e) => {
			if (e.target === linkModalOverlay) closeLinkModal();
		});

		// Details Modal Toggle Handlers
		const detailsModalOverlay = document.getElementById('details-modal-overlay');
		const closeDetailsModalBtn = document.getElementById('close-details-modal-btn');
		
		const closeDetailsModal = () => {
			detailsModalOverlay?.classList.remove('active');
		};
		closeDetailsModalBtn?.addEventListener('click', closeDetailsModal);
		detailsModalOverlay?.addEventListener('click', (e) => {
			if (e.target === detailsModalOverlay) closeDetailsModal();
		});

		// Copy link button handler
		const copyShareableLinkBtn = document.getElementById('copy-shareable-link-btn');
		const shareableLinkInput = document.getElementById('shareable-link-input') as HTMLInputElement;
		copyShareableLinkBtn?.addEventListener('click', () => {
			if (shareableLinkInput && shareableLinkInput.value) {
				const messageText = getCustomerCopyMessage(shareableLinkInput.value);
				navigator.clipboard.writeText(messageText).then(() => {
					showToast('Shareable link message copied to clipboard!');
					const oldText = copyShareableLinkBtn.textContent;
					copyShareableLinkBtn.textContent = 'Copied!';
					// persist copied state for this order and update table button if present
					try {
						const u = new URL(shareableLinkInput.value);
						const id = u.searchParams.get('id');
						if (id) {
							localStorage.setItem('copied_link_' + id, '1');
							const tableBtn = document.querySelector('.btn-get-link[data-id="' + id + '"]') as HTMLButtonElement;
							if (tableBtn) {
								const old = tableBtn.innerHTML;
								tableBtn.classList.add('copied');
								tableBtn.innerHTML = `\n\t\t\t\t<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>\n\t\t\t\t<span>Copied!</span>\n\t\t\t`;
								setTimeout(() => {
									tableBtn.classList.remove('copied');
									tableBtn.innerHTML = old;
								}, 2000);
							}
						}
					} catch (e) {}
					setTimeout(() => {
						copyShareableLinkBtn.textContent = oldText;
					}, 2000);
				});
			}
		});
	}

	// Settings → Family Calendar Link: show the full URL for this site and copy it on tap.
	function setupFamilyLink() {
		const input = document.getElementById('s-family-link') as HTMLInputElement | null;
		const btn = document.getElementById('copy-family-link-btn') as HTMLButtonElement | null;
		if (!input || !btn) return;
		const openLink = document.getElementById('open-family-link') as HTMLAnchorElement | null;
		const genBtn = document.getElementById('generate-family-link-btn') as HTMLButtonElement | null;
		input.value = window.location.origin + (input.dataset.path || '');
		genBtn?.addEventListener('click', async () => {
			const ok = await showConfirm('Generate a new family link? The current link will stop working, so you will need to send the new one to your family.');
			if (!ok) return;
			genBtn.disabled = true;
			genBtn.textContent = 'Generating…';
			try {
				const res = await fetch('/api/family-link', { method: 'POST' });
				const body = await res.json().catch(() => ({}));
				if (!res.ok || !body.path) throw new Error(body.error || `Request failed (${res.status})`);
				input.dataset.path = body.path;
				input.value = window.location.origin + body.path;
				if (openLink) openLink.href = body.path;
				showToast('New family link generated. Copy it and send it again.');
			} catch (err) {
				showToast('Could not generate a new link: ' + (err instanceof Error ? err.message : String(err)));
			} finally {
				genBtn.disabled = false;
				genBtn.textContent = 'Generate New Link';
			}
		});
		input.addEventListener('focus', () => input.select());
		btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(input.value);
			} catch {
				input.select();
				document.execCommand('copy');
			}
			showToast('Family calendar link copied!');
			btn.textContent = 'Copied!';
			setTimeout(() => { btn.textContent = 'Copy Link'; }, 2000);
		});
		setupFamilyVisits();
		setupDeliveryZones();
		setupTelegramTest();
		setupGoogleCalendarSync();
	}

	// Settings → Live Google Calendar: copy every order to the calendar now (first setup, or after a problem).
	function setupGoogleCalendarSync() {
		const btn = document.getElementById('gcal-sync-btn') as HTMLButtonElement | null;
		const resultEl = document.getElementById('gcal-result');
		if (!btn || !resultEl || btn.dataset.bound) return;
		btn.dataset.bound = '1';
		btn.addEventListener('click', async () => {
			btn.disabled = true;
			btn.textContent = 'Syncing…';
			resultEl.hidden = false;
			try {
				const res = await fetch('/api/google-calendar-sync', { method: 'POST' });
				const body = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error(body.error || `Request failed (${res.status})`);
				resultEl.textContent = `✓ Done. ${body.orders} order${body.orders === 1 ? '' : 's'} on the calendar: ${body.saved} added or updated, ${body.removed} removed.`;
			} catch (err) {
				resultEl.textContent = '✗ Sync failed: ' + (err instanceof Error ? err.message : String(err));
			} finally {
				btn.disabled = false;
				btn.textContent = 'Sync all orders now';
			}
		});
	}

	// Settings → Telegram Alerts: what this server can see + a test message.
	function setupTelegramTest() {
		const statusEl = document.getElementById('tg-status');
		const resultEl = document.getElementById('tg-result');
		const btn = document.getElementById('tg-test-btn') as HTMLButtonElement | null;
		if (!statusEl || !resultEl || !btn) return;
		const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
		const chip = (ok: boolean, text: string) => `<span class="tg-chip ${ok ? 'is-ok' : 'is-bad'}">${ok ? '✓' : '✗'} ${esc(text)}</span>`;

		function showStatus(s: any) {
			statusEl!.innerHTML = [
				`<span class="tg-chip">Server: ${esc(s.host)}${s.vercelEnv ? ` (${esc(s.vercelEnv)})` : ''}</span>`,
				chip(s.hasTelegramToken && s.tokenLooksValid, s.hasTelegramToken ? (s.tokenLooksValid ? 'Bot token set' : 'Bot token looks wrong') : 'Bot token missing'),
				chip(s.chatIdCount > 0, s.chatIdCount ? `${s.chatIdCount} chat ID${s.chatIdCount === 1 ? '' : 's'}` : 'Chat ID missing'),
				chip(s.hasServiceRoleKey, s.hasServiceRoleKey ? 'Supabase service key set' : 'Supabase service key missing'),
				chip(s.hasCronSecret || s.host !== 'Vercel', s.hasCronSecret ? 'Cron secret set' : 'No cron secret (optional)')
			].join('');
		}

		fetch('/api/telegram-test', { cache: 'no-store' })
			.then(r => r.json())
			.then(s => { if (s.error) statusEl.textContent = s.error; else showStatus(s); })
			.catch(() => { statusEl.textContent = 'Could not check the Telegram settings.'; });

		btn.addEventListener('click', async () => {
			btn.disabled = true;
			btn.textContent = 'Sending…';
			try {
				const res = await fetch('/api/telegram-test', { method: 'POST' });
				const body = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error(body.error || `Request failed (${res.status})`);
				showStatus(body);
				const lines = (body.sent ?? []).map((r: any) => r.ok
					? `✓ Chat ${esc(r.chat)}: sent`
					: `✗ Chat ${esc(r.chat)}: ${esc(r.error)}${/chat not found/i.test(r.error) ? ' (the chat ID is wrong, or the bot was never started / added to that group)' : /unauthorized/i.test(r.error) ? ' (the bot token is wrong)' : ''}`);
				resultEl.hidden = false;
				resultEl.innerHTML = body.error
					? `✗ ${esc(body.error)} Add it in your host's environment variables (on Vercel: Project → Settings → Environment Variables, for Production), then redeploy.`
					: lines.join('<br>') || 'Nothing was sent.';
			} catch (err) {
				resultEl.hidden = false;
				resultEl.textContent = 'Test failed: ' + (err instanceof Error ? err.message : String(err));
			} finally {
				btn.disabled = false;
				btn.textContent = 'Send test message';
			}
		});
	}

	// Settings → Pickup & Delivery Fees (saved to the server; the customer order link reads it).
	// Every barangay of Argao, Sibonga and Dalaguete is listed (src/lib/service-areas.ts); the owner
	// only types fees. Blank fee = area not offered. Custom areas cover places outside those lists.
	function setupDeliveryZones() {
		const groupsEl = document.getElementById('area-groups');
		const customList = document.getElementById('zone-list');
		const addBtn = document.getElementById('add-zone-btn');
		const saveBtn = document.getElementById('save-zones-btn') as HTMLButtonElement | null;
		const searchEl = document.getElementById('area-search') as HTMLInputElement | null;
		const onlyPricedEl = document.getElementById('area-only-priced') as HTMLInputElement | null;
		const countEl = document.getElementById('area-count');
		if (!groupsEl || !customList || !addBtn || !saveBtn) return;

		let townFilter = '';
		const escAttr = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');

		// 1. Preset barangays, one group per town
		groupsEl.innerHTML = SERVICE_AREA_TOWNS.map(t => `
			<div class="area-group" data-town="${escAttr(t.town)}">
				<h4 class="area-group-title">${escAttr(t.town)} <span class="area-group-sub" data-count-for="${escAttr(t.town)}"></span></h4>
				<div class="area-grid">
					${t.barangays.map(b => {
						const dist = areaDistance(b, t.town);
						return `
						<label class="area-row" data-name="${escAttr(b)}" data-town="${escAttr(t.town)}" data-km="${dist ? dist.km : ''}" data-min="${dist ? dist.min : ''}">
							<span class="area-label">
								<span class="area-name">${escAttr(b)}</span>
								<span class="area-km">${dist ? `${dist.km} km · ~${dist.min} min` : 'distance unknown'}</span>
							</span>
							<span class="zone-fee-wrap"><input type="number" class="area-fee" min="0" step="1" placeholder="—" aria-label="Delivery fee for ${escAttr(b)}, ${escAttr(t.town)}" /></span>
						</label>`;
					}).join('')}
				</div>
			</div>`).join('');

		const presetRows = () => [...groupsEl.querySelectorAll<HTMLElement>('.area-row')];
		const feeInput = (row: HTMLElement) => row.querySelector('.area-fee') as HTMLInputElement;

		// 2. Custom areas (name + fee + remove)
		function addCustomRow(name = '', fee: number | '' = '') {
			const row = document.createElement('div');
			row.className = 'zone-row';
			row.innerHTML = `
				<input type="text" class="zone-name" placeholder="Area name (e.g. Carcar City)" maxlength="80" aria-label="Area name" />
				<div class="zone-fee-wrap"><input type="number" class="zone-fee" min="0" step="1" placeholder="Fee" aria-label="Delivery fee" /></div>
				<button type="button" class="zone-remove" aria-label="Remove" title="Remove">×</button>`;
			(row.querySelector('.zone-name') as HTMLInputElement).value = name;
			(row.querySelector('.zone-fee') as HTMLInputElement).value = fee === '' ? '' : String(fee);
			row.querySelector('.zone-remove')!.addEventListener('click', () => { row.remove(); refresh(); });
			row.addEventListener('input', refresh);
			customList!.appendChild(row);
			return row;
		}

		// 3. Filtering + counts
		function refresh() {
			const q = (searchEl?.value || '').trim().toLowerCase();
			const onlyPriced = !!onlyPricedEl?.checked;
			let priced = 0;
			for (const row of presetRows()) {
				const hasFee = feeInput(row).value.trim() !== '';
				if (hasFee) priced++;
				row.classList.toggle('has-fee', hasFee);
				const matches = (!townFilter || row.dataset.town === townFilter)
					&& (!q || row.dataset.name!.toLowerCase().includes(q) || row.dataset.town!.toLowerCase().includes(q))
					&& (!onlyPriced || hasFee);
				row.hidden = !matches;
			}
			for (const group of groupsEl!.querySelectorAll<HTMLElement>('.area-group')) {
				const rows = [...group.querySelectorAll<HTMLElement>('.area-row')];
				group.hidden = rows.every(r => r.hidden);
				const withFee = rows.filter(r => feeInput(r).value.trim() !== '').length;
				const sub = group.querySelector('[data-count-for]');
				if (sub) sub.textContent = `${withFee} of ${rows.length} with a fee`;
			}
			const customGroup = document.getElementById('area-custom-group');
			if (customGroup) customGroup.hidden = !!townFilter && townFilter !== '__custom';
			const customCount = [...customList!.querySelectorAll('.zone-row')].filter(r => (r.querySelector('.zone-name') as HTMLInputElement).value.trim()).length;
			const total = presetRows().length;
			if (countEl) countEl.textContent = `${priced} of ${total} listed areas have a fee${customCount ? ` · ${customCount} other area${customCount === 1 ? '' : 's'}` : ''}. Customers only see areas with a fee.`;
		}

		// Typing in a fee box accepts it as your own (drops the AI mark).
		groupsEl.addEventListener('input', e => {
			(e.target as HTMLElement).closest('.area-row')?.classList.remove('is-suggested');
			syncAiClear();
			refresh();
		});
		searchEl?.addEventListener('input', refresh);
		onlyPricedEl?.addEventListener('change', refresh);

		// Nearest first: reorder each town's rows by road distance (unknown distance last); otherwise A–Z.
		const sortKmEl = document.getElementById('area-sort-km') as HTMLInputElement | null;
		sortKmEl?.addEventListener('change', () => {
			for (const grid of groupsEl.querySelectorAll<HTMLElement>('.area-grid')) {
				const rows = [...grid.querySelectorAll<HTMLElement>('.area-row')];
				rows.sort((a, b) => sortKmEl.checked
					? (parseFloat(a.dataset.km || '') || 9999) - (parseFloat(b.dataset.km || '') || 9999)
					: a.dataset.name!.localeCompare(b.dataset.name!));
				rows.forEach(r => grid.appendChild(r));
			}
		});

		// ---------- AI fee suggestions (Groq, via /api/suggest-fees) ----------
		const aiBtn = document.getElementById('ai-suggest-btn') as HTMLButtonElement | null;
		const aiClearBtn = document.getElementById('ai-clear-btn') as HTMLButtonElement | null;
		const aiNote = document.getElementById('area-ai-note');
		const rowLabel = (r: HTMLElement) => `${r.dataset.name}, ${r.dataset.town}`;
		function syncAiClear() {
			if (aiClearBtn) aiClearBtn.hidden = !groupsEl!.querySelector('.area-row.is-suggested');
		}

		aiBtn?.addEventListener('click', async () => {
			const rows = presetRows();
			const priced = rows
				.filter(r => feeInput(r).value.trim() !== '' && !r.classList.contains('is-suggested') && r.dataset.km)
				.map(r => ({ label: rowLabel(r), km: parseFloat(r.dataset.km!), min: parseFloat(r.dataset.min || ''), fee: parseFloat(feeInput(r).value) || 0 }));
			// Only the areas you can currently see (use the town filter / search to choose), with a known distance.
			const targets = rows.filter(r => !r.hidden && feeInput(r).value.trim() === '' && r.dataset.km);
			if (priced.length < 2) { showToast('Type fees for at least 2 areas first, so the AI can follow your pricing.'); return; }
			if (!targets.length) { showToast('No areas shown without a fee. Use the town filter or search to pick which areas to fill.'); return; }

			aiBtn.disabled = true;
			aiBtn.textContent = 'Thinking…';
			try {
				const res = await fetch('/api/suggest-fees', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ priced, unpriced: targets.map(r => ({ label: rowLabel(r), km: parseFloat(r.dataset.km!), min: parseFloat(r.dataset.min || '') })) })
				});
				const body = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error(body.error || `Request failed (${res.status})`);
				let filled = 0;
				for (const s of body.suggestions ?? []) {
					const row = targets.find(r => rowLabel(r) === s.label);
					if (!row || feeInput(row).value.trim() !== '') continue;
					feeInput(row).value = String(s.fee);
					row.classList.add('is-suggested');
					filled++;
				}
				if (aiNote) {
					aiNote.hidden = false;
					aiNote.textContent = `AI filled ${filled} fee${filled === 1 ? '' : 's'} (marked "AI"). ${body.rule ? `Pattern used: ${body.rule} ` : ''}Check them, change any you like, remove the ones you don't deliver to, then tap Save.`;
				}
				syncAiClear();
				refresh();
			} catch (err) {
				showToast('Could not get suggestions: ' + (err instanceof Error ? err.message : String(err)));
			} finally {
				aiBtn.disabled = false;
				aiBtn.textContent = '✨ Suggest prices (AI)';
			}
		});

		aiClearBtn?.addEventListener('click', () => {
			groupsEl.querySelectorAll<HTMLElement>('.area-row.is-suggested').forEach(r => {
				feeInput(r).value = '';
				r.classList.remove('is-suggested');
			});
			if (aiNote) aiNote.hidden = true;
			syncAiClear();
			refresh();
		});
		document.querySelectorAll<HTMLButtonElement>('.area-filter').forEach(btn => {
			btn.addEventListener('click', () => {
				townFilter = btn.dataset.town || '';
				document.querySelectorAll('.area-filter').forEach(b => b.classList.toggle('active', b === btn));
				refresh();
			});
		});
		addBtn.addEventListener('click', () => {
			(addCustomRow().querySelector('.zone-name') as HTMLInputElement).focus();
			refresh();
		});

		// 4. Fill from saved data
		function applySaved(zones: { name: string; town?: string; fee: number }[]) {
			presetRows().forEach(r => { feeInput(r).value = ''; r.classList.remove('is-suggested'); });
			const note = document.getElementById('area-ai-note');
			if (note) note.hidden = true;
			const clearBtn = document.getElementById('ai-clear-btn');
			if (clearBtn) clearBtn.hidden = true;
			customList!.innerHTML = '';
			for (const z of zones) {
				const row = z.town
					? presetRows().find(r => r.dataset.town === z.town && r.dataset.name!.toLowerCase() === z.name.toLowerCase())
					: undefined;
				if (row) feeInput(row).value = String(z.fee);
				else addCustomRow(z.town ? `${z.name}, ${z.town}` : z.name, z.fee);
			}
			refresh();
		}

		// 5. Save
		saveBtn.addEventListener('click', async () => {
			const zones = [
				...presetRows()
					.filter(r => feeInput(r).value.trim() !== '')
					.map(r => ({ name: r.dataset.name!, town: r.dataset.town!, fee: parseFloat(feeInput(r).value) || 0 })),
				...[...customList.querySelectorAll('.zone-row')].map(r => ({
					name: (r.querySelector('.zone-name') as HTMLInputElement).value.trim(),
					fee: parseFloat((r.querySelector('.zone-fee') as HTMLInputElement).value) || 0
				})).filter(z => z.name)
			];
			const pickup = {
				address: (document.getElementById('s-pickup-address') as HTMLInputElement | null)?.value.trim() || '',
				mapUrl: (document.getElementById('s-pickup-map') as HTMLInputElement | null)?.value.trim() || ''
			};
			saveBtn.disabled = true;
			saveBtn.textContent = 'Saving…';
			try {
				const res = await fetch('/api/delivery-zones', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ zones, pickup })
				});
				const body = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error(body.error || `Request failed (${res.status})`);
				applySaved(body.zones ?? []);
				const n = (body.zones ?? []).length;
				showToast(`Pickup & delivery saved (${n} service area${n === 1 ? '' : 's'} with a fee).`);
			} catch (err) {
				showToast('Could not save: ' + (err instanceof Error ? err.message : String(err)));
			} finally {
				saveBtn.disabled = false;
				saveBtn.textContent = 'Save Pickup & Delivery';
			}
		});

		refresh();
		fetch('/api/delivery-zones', { cache: 'no-store' })
			.then(r => r.json())
			.then(body => {
				applySaved(body.zones ?? []);
				const addr = document.getElementById('s-pickup-address') as HTMLInputElement | null;
				const map = document.getElementById('s-pickup-map') as HTMLInputElement | null;
				if (addr && body.pickup?.address) addr.value = body.pickup.address;
				if (map && body.pickup?.mapUrl) map.value = body.pickup.mapUrl;
			})
			.catch(() => refresh());
	}

	// Settings → Family Link Visits: one row per phone that opened the family link.
	function setupFamilyVisits() {
		const summary = document.getElementById('family-visits-summary');
		const list = document.getElementById('family-visits-list');
		const refreshBtn = document.getElementById('refresh-family-visits-btn') as HTMLButtonElement | null;
		if (!summary || !list) return;

		const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
		const ago = (iso: string) => {
			const mins = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
			if (mins < 1) return 'just now';
			if (mins < 60) return `${mins} min ago`;
			const hrs = Math.round(mins / 60);
			if (hrs < 24) return `${hrs} hr${hrs === 1 ? '' : 's'} ago`;
			const days = Math.round(hrs / 24);
			if (days < 7) return `${days} day${days === 1 ? '' : 's'} ago`;
			return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
		};

		async function load() {
			if (refreshBtn) { refreshBtn.disabled = true; refreshBtn.textContent = 'Loading…'; }
			try {
				const res = await fetch('/api/family-visits', { cache: 'no-store' });
				const body = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error(body.error || `Request failed (${res.status})`);
				if (!body.ready) {
					summary!.textContent = body.error || 'Visit log is not set up yet.';
					list!.innerHTML = '';
					return;
				}
				const devices: any[] = body.devices ?? [];
				if (!devices.length) {
					summary!.textContent = 'No visits yet. Phones will show up here after they open the family link.';
					list!.innerHTML = '';
					return;
				}
				summary!.textContent = `${devices.length} device${devices.length === 1 ? '' : 's'} · ${body.totalVisits} visit${body.totalVisits === 1 ? '' : 's'}`;
				list!.innerHTML =
					`<div class="visit-row is-head"><span>Phone</span><span>System · Browser</span><span>Visits</span><span>Last seen</span><span>Opened from</span></div>` +
					devices.map(d => `<div class="visit-row" title="First seen ${esc(new Date(d.firstSeen).toLocaleString())}">
						<span class="visit-model">${esc(d.model)}</span>
						<span class="visit-meta">${esc(d.os)} · ${esc(d.browser)}</span>
						<span class="visit-count">${d.visits}×</span>
						<span class="visit-meta visit-seen">${esc(ago(d.lastSeen))}</span>
						<span class="visit-badge${d.homeScreen ? '' : ' is-browser'}">${d.homeScreen ? 'Home screen' : 'Browser'}</span>
					</div>`).join('');
			} catch (err) {
				summary!.textContent = 'Could not load visits: ' + (err instanceof Error ? err.message : String(err));
			} finally {
				if (refreshBtn) { refreshBtn.disabled = false; refreshBtn.textContent = 'Refresh'; }
			}
		}

		refreshBtn?.addEventListener('click', load);
		load();
	}

	function bindTableActionButtons() {
		// View Details Button
		document.querySelectorAll('.btn-view-details').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (id) {
					openDetailsModal(id);
				}
			});
		});

		// Table Copy Link Button (same behavior as copy-slip)
		document.querySelectorAll('.btn-get-link').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (!id) return;
				// Embed current admin settings into the shareable link so the customer view matches
				const sig = getOrderSignature(id);
				const settingsParam = getSettingsParam();
				const uniqueLink = window.location.origin + '/order?id=' + id + '&t=' + sig + settingsParam;
				const messageText = getCustomerCopyMessage(uniqueLink);
				navigator.clipboard.writeText(messageText).then(() => {
					const target = e.currentTarget as HTMLButtonElement;
					target.classList.add('copied');
					const oldHTML = target.innerHTML;
					target.innerHTML = `
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
						<span>Copied!</span>
					`;
					try { localStorage.setItem('copied_link_' + id, '1'); } catch (e) {}
					showToast('Customer share link copied to clipboard!');
					setTimeout(() => {
						target.classList.remove('copied');
						target.innerHTML = oldHTML;
					}, 2000);
				}).catch(err => {
					console.error('Could not copy link to clipboard: ', err);
				});
			});
		});
	}

	let currentEditingOrderId: string | null = null;
	let activeEditSection: 'items' | 'customer' | 'payment' | null = null;
	let editItemsStaged: OrderItem[] = [];

	function openDetailsModal(id: string) {
		currentEditingOrderId = id;
		activeEditSection = null;
		editItemsStaged = [];
		const detailsModalOverlay = document.getElementById('details-modal-overlay');
		detailsModalOverlay?.classList.add('active');
		renderDetailsModalContent();
	}

	function renderDetailsModalContent() {
		const id = currentEditingOrderId;
		if (!id) return;
		const order = orders.find(o => o.id === id);
		if (!order) return;

		const detailsTitle = document.getElementById('details-title');
		if (detailsTitle) detailsTitle.textContent = `Order #${id.replace('ORD-', '')}`;

		const existingOwnerNote = (() => { try { const o = orders.find(x => x.id === id); return (o && o.note) ? o.note : ''; } catch (e) { return ''; } })();

		// 1. ITEMS BREAKDOWN SECTION
		let itemsHTML = '';
		if (activeEditSection === 'items') {
			// Built once and reused by every item's inclusion picker and by the
			// shared datalist that makes the free-text rows auto-complete too.
			const inclusionGroups = getInclusionOptions();
			const inclusionOptionsHTML = inclusionGroups.map(g => `
				<optgroup label="${escapeHtml(g.group)}">
					${g.options.map(o => `<option value="${escapeHtml(o)}">${escapeHtml(o)}</option>`).join('')}
				</optgroup>`).join('');
			const inclusionDatalistHTML = `<datalist id="inclusion-suggestions">${
				[...new Set(inclusionGroups.flatMap(g => g.options))].map(o => `<option value="${escapeHtml(o)}"></option>`).join('')
			}</datalist>`;

			itemsHTML = `
				<form id="edit-items-form" style="display: flex; flex-direction: column; gap: 12px; margin-top: 4px;">
					<div id="edit-items-list-container" style="display: flex; flex-direction: column; gap: 10px; max-height: min(52vh, 520px); overflow-y: auto; padding-right: 4px;">
						${editItemsStaged.map((it, idx) => {
							// Determine if it matches any standard menu item
							let matchedStandardName = "";
							for (const cat of MENU_ITEMS) {
								for (const m of cat.items) {
									if (it.name === m.name || it.name.startsWith(m.name + " [") || it.name.startsWith(m.name + " (")) {
										matchedStandardName = m.name;
										break;
									}
								}
								if (matchedStandardName) break;
							}
							const isCustom = !matchedStandardName;

							return `
