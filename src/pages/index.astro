---
import Layout from '../layouts/Layout.astro';
import StatsCard from '../components/StatsCard.astro';
import BestSellers from '../components/BestSellers.astro';
import OrderForm from '../components/OrderForm.astro';
import OrderTable from '../components/OrderTable.astro';
---

<Layout>
	<!-- html2canvas CDN for downloading receipt images -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" defer></script>

	<div class="dashboard-layout">
		<!-- Sidebar Navigation -->
		<aside class="sidebar">
			<div class="sidebar-logo" style="display: flex; align-items: center; gap: 12px; margin-bottom: 40px; position: relative;">
				<div class="logo-glow"></div>
				<img src="/logo.jpg" alt="Montejo's Logo" class="logo-img" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 12px rgba(99, 102, 241, 0.4); border: 1.5px solid rgba(255, 255, 255, 0.15);" />
				<h2 style="font-size: 0.9rem; line-height: 1.3; font-weight: 800; background: linear-gradient(135deg, var(--text-primary) 30%, var(--accent-primary) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Montejo's Lechon & Food Trays - Argao</h2>
			</div>

			<nav class="sidebar-nav">
				<a href="#" class="nav-item active" data-view="dashboard">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
					<span>Dashboard</span>
				</a>
				<a href="#" class="nav-item" data-view="order-history">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 17h6"/><path d="M9 12h6"/><path d="M9 7h4"/></svg>
					<span>Order History</span>
				</a>
				<a href="#" class="nav-item" data-view="analytics">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
					<span>Analytics</span>
				</a>
				<a href="#" class="nav-item" data-view="live-kitchen">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"/><path d="M12 7v5l3 3"/></svg>
					<span>Live Kitchen</span>
				</a>
				<a href="#" class="nav-item" data-view="calendar">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
					<span>Calendar</span>
				</a>
				<div class="nav-divider"></div>
				<a href="#" class="nav-item" data-view="settings">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.1a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
					<span>Settings</span>
				</a>
			</nav>

			<div class="sidebar-user">
				<div class="user-avatar">AD</div>
				<div class="user-info">
					<span class="user-name">Admin Chef</span>
					<span class="user-role">Owner</span>
				</div>
			</div>
		</aside>
		<div class="sidebar-overlay" id="sidebar-overlay"></div>

		<!-- Main Dashboard Content -->
		<main class="main-content">
			<!-- Shared Dynamic Header -->
			<header class="dashboard-header animate-fade-in">
				<div class="header-left" style="display: flex; align-items: center; gap: 14px;">
					<button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open Menu" style="background: rgba(15, 22, 38, 0.7); border: 1px solid var(--border-color); color: var(--text-primary); padding: 10px; border-radius: 10px; cursor: pointer; transition: var(--transition-smooth); box-shadow: var(--card-shadow); flex-shrink: 0;">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
					</button>
					<div>
						<span class="date-display" id="current-date">Sunday, June 7, 2026</span>
						<h1 id="page-title">Order Dashboard</h1>
					</div>
				</div>
				<div class="header-right" id="header-actions" style="display: flex; align-items: center; gap: 12px;">
					<!-- Theme Toggle Switcher -->
					<button class="theme-toggle-btn" id="theme-toggle-btn" aria-label="Toggle Theme" style="background: rgba(15, 22, 38, 0.7); border: 1px solid var(--border-color); color: var(--text-primary); padding: 10px; border-radius: 10px; cursor: pointer; transition: var(--transition-smooth); box-shadow: var(--card-shadow); display: flex; align-items: center; justify-content: center;">
						<!-- Sun icon (shows in dark mode to switch to light) -->
						<svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
						<!-- Moon icon (shows in light mode to switch to dark) -->
						<svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
					</button>

					<button class="btn-primary-dashboard" id="open-order-modal-btn">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
						<span>Add New Order</span>
					</button>
				</div>
			</header>

			<!-- DASHBOARD VIEW -->
			<div id="view-dashboard" class="view-container">
				<!-- Statistics Cards Row -->
				<section class="stats-grid">
					<StatsCard id="revenue-val" title="Total Revenue" initialValue="₱0.00" trendId="revenue-trend" initialTrend="+0.0%" isTrendPositive={true}>
						<svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
					</StatsCard>
					<StatsCard id="active-orders-val" title="Active Orders" initialValue="0" trendId="active-trend" initialTrend="+0%" isTrendPositive={true}>
						<svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/><circle cx="12" cy="12" r="10" stroke-dasharray="4 4"/></svg>
					</StatsCard>
					<StatsCard id="avg-order-val" title="Avg Order Value" initialValue="₱0.00" trendId="avg-trend" initialTrend="+0.0%" isTrendPositive={true}>
						<svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8H8"/><path d="M16 12H8"/><path d="M13 16H8"/></svg>
					</StatsCard>
					<StatsCard id="items-sold-val" title="Total Items Sold" initialValue="0" trendId="items-trend" initialTrend="+0%" isTrendPositive={true}>
						<svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 4 3 12h14l3-12H2Z"/><path d="M6.5 16H17.5M10 20a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm6 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"/></svg>
					</StatsCard>
				</section>
				<!-- Main Content Grid -->
				<section class="dashboard-grid">
					<div class="grid-table-area">
						<OrderTable />
					</div>
					<div class="grid-analytics-area">
						<BestSellers />
					</div>
				</section>
			</div>

			<!-- ORDER HISTORY VIEW -->
			<div id="view-order-history" class="view-container" style="display:none">
				<div class="view-toolbar">
					<div class="toolbar-left">
						<div class="search-box">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
							<input type="text" id="history-search" placeholder="Search by name or order ID..." />
						</div>
						<div class="date-range-group">
							<input type="date" id="history-from" />
							<span>to</span>
							<input type="date" id="history-to" />
						</div>
					</div>
					<button class="btn-export" id="export-csv-btn">Export CSV</button>
				</div>
				<div class="history-tabs" id="history-tabs">
					<button class="filter-tab active" data-status="All">All <span class="tab-count" id="hcount-all">0</span></button>
					<button class="filter-tab" data-status="Pending">Pending <span class="tab-count" id="hcount-pending">0</span></button>
					<button class="filter-tab" data-status="PendingCustomer">Pending (Customer) <span class="tab-count" id="hcount-pending-customer">0</span></button>
					<button class="filter-tab" data-status="Preparing">Preparing <span class="tab-count" id="hcount-preparing">0</span></button>
					<button class="filter-tab" data-status="Completed">Completed <span class="tab-count" id="hcount-completed">0</span></button>
					<button class="filter-tab" data-status="Cancelled">Cancelled <span class="tab-count" id="hcount-cancelled">0</span></button>
				</div>
				<div class="glass-panel history-table-wrap">
					<table class="history-table">
						<thead><tr>
							<th>Order #</th><th>Customer</th><th>Total</th><th>Downpayment</th><th>Balance</th><th>Delivery Date</th><th>Status</th><th></th>
						</tr></thead>
						<tbody id="history-body"></tbody>
					</table>
					<div class="table-empty-state" id="history-empty" style="display:none">
						<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 17h6"/><path d="M9 12h6"/><path d="M9 7h4"/></svg>
						<p>No orders match your filters.</p>
					</div>
				</div>
			</div>

			<!-- ANALYTICS VIEW -->
			<div id="view-analytics" class="view-container" style="display:none">
				<div class="analytics-summary" id="analytics-summary"></div>
				<div class="analytics-charts-row">
					<div class="glass-panel chart-card">
						<div class="chart-label">Daily Revenue Trend</div>
						<div id="revenue-bar-chart" class="bar-chart-container"></div>
					</div>
					<div class="glass-panel chart-card chart-card-sm">
						<div class="chart-label">Orders by Status</div>
						<div id="status-donut" class="donut-container"></div>
						<div id="donut-legend" class="donut-legend"></div>
					</div>
				</div>
				<div class="glass-panel chart-card" style="margin-top:20px;">
					<div class="chart-label">Top Selling Items</div>
					<div id="analytics-top-items"></div>
				</div>
			</div>

			<!-- LIVE KITCHEN VIEW -->
			<div id="view-live-kitchen" class="view-container" style="display:none">
				<!-- KDS Top Bar -->
				<div class="kds-top-bar">
					<div class="kds-live-indicator">
						<span class="live-pulse"></span>
						<span class="live-label">LIVE KITCHEN</span>
					</div>
					<div class="kds-counts">
						<span class="kitchen-badge badge-pending" id="kitchen-pending-count">0 Pending</span>
						<span class="kitchen-badge badge-preparing" id="kitchen-preparing-count">0 Preparing</span>
					</div>
					<button class="btn-refresh" id="kitchen-refresh-btn">
						<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
						Refresh
					</button>
				</div>

				<!-- KDS Two-Column Board -->
				<div class="kds-board">
					<!-- PENDING Column -->
					<div class="kds-column">
						<div class="kds-col-header kds-col-pending">
							<div class="kds-col-header-left">
								<span class="kds-col-icon">⏳</span>
								<span class="kds-col-title">PENDING</span>
							</div>
							<span class="kds-col-count" id="kcol-pending-count">0</span>
						</div>
						<div class="kds-col-body" id="kds-pending-body"></div>
						<div class="kds-col-empty" id="kds-pending-empty">
							<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z"/><path d="M12 8v4l3 3"/></svg>
							<span>No pending orders</span>
						</div>
					</div>

					<!-- PREPARING Column -->
					<div class="kds-column">
						<div class="kds-col-header kds-col-preparing">
							<div class="kds-col-header-left">
								<span class="kds-col-icon">🔥</span>
								<span class="kds-col-title">PREPARING</span>
							</div>
							<span class="kds-col-count" id="kcol-preparing-count">0</span>
						</div>
						<div class="kds-col-body" id="kds-preparing-body"></div>
						<div class="kds-col-empty" id="kds-preparing-empty">
							<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z"/><path d="M12 8v4l3 3"/></svg>
							<span>No orders being prepared</span>
						</div>
					</div>
				</div>

				<!-- Overall empty state -->
				<div class="kds-all-empty" id="kitchen-empty" style="display:none">
					<div class="kds-all-empty-icon">🍽️</div>
					<p class="kds-all-empty-title">Kitchen is clear!</p>
					<p class="kds-all-empty-sub">No active orders right now. New orders will appear here automatically.</p>
				</div>
			</div>

			<!-- CALENDAR VIEW -->
			<div id="view-calendar" class="view-container" style="display:none">
				<div class="cal-layout">
					<!-- Calendar Panel -->
					<div class="glass-panel cal-panel">
						<div class="cal-header">
							<button class="cal-nav-btn" id="cal-prev-btn" aria-label="Previous month">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
							</button>
							<span class="cal-month-label" id="cal-month-label"></span>
							<button class="cal-nav-btn" id="cal-next-btn" aria-label="Next month">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
							</button>
						</div>
						<div class="cal-weekdays">
							<span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
						</div>
						<div class="cal-grid" id="cal-grid"></div>
					</div>
					<!-- Day Orders Panel -->
					<div class="glass-panel cal-day-panel" id="cal-day-panel">
						<div class="cal-day-header" id="cal-day-header">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
							<span>Select a date to view orders</span>
						</div>
						<div id="cal-day-orders"></div>
					</div>
				</div>
			</div>

			<!-- SETTINGS VIEW -->
			<div id="view-settings" class="view-container" style="display:none">
				<div class="settings-grid">
					<div class="glass-panel settings-section">
						<div class="settings-section-title">Payment Methods</div>
						<div class="settings-field"><label>Maribank — Account Name</label><input type="text" id="s-maribank-name" /></div>
						<div class="settings-field"><label>Maribank — Account Number</label><input type="text" id="s-maribank-num" /></div>
						<div class="settings-field"><label>GCash — Account Name</label><input type="text" id="s-gcash-name" /></div>
						<div class="settings-field"><label>GCash — Account Number</label><input type="text" id="s-gcash-num" /></div>
						<button class="btn-save-settings" id="save-payment-btn">Save Payment Info</button>
					</div>
					<div class="glass-panel settings-section">
						<div class="settings-section-title">Default Downpayment</div>
						<div class="settings-field"><label>Default Downpayment %</label><input type="number" id="s-dp-pct" min="0" max="100" step="1" /></div>
						<button class="btn-save-settings" id="save-dp-btn">Save</button>
						<div class="settings-section-title" style="margin-top:24px">Data Management</div>
						<button class="btn-danger-settings" id="reset-orders-btn">Reset to Default Orders</button>
						<button class="btn-danger-settings" id="clear-orders-btn" style="margin-top:8px">Clear All Orders</button>
					</div>
				</div>
			</div>
		</main>

		<!-- Order Form (Slide-over Modal) -->
		<OrderForm />

		<!-- Customer Link Modal -->
		<div class="modal-overlay" id="link-modal-overlay">
			<div class="modal-container">
				<div class="modal-header">
					<div class="modal-title-group">
						<span class="modal-subtitle">Customer Details Pending</span>
						<h3>Customer Link Generated</h3>
					</div>
					<button class="close-btn" id="close-link-modal-btn" aria-label="Close modal">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
					</button>
				</div>
				<div class="modal-body">
					<p>
						The order ticket has been saved. Please copy the unique link below and send it to your customer so they can verify the details and complete their delivery/payment details.
					</p>
					
					<div class="form-group">
						<label>Customer Shareable Link</label>
						<div class="input-wrapper">
							<input type="text" id="shareable-link-input" readonly />
							<button type="button" class="btn btn-secondary" id="copy-shareable-link-btn">
								Copy Link
							</button>
						</div>
					</div>
					
					<div class="form-actions">
