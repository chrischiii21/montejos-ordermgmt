	// Premium Custom Toast Notification System
	function showToast(message: string) {
		let container = document.getElementById('toast-container');
		if (!container) {
			container = document.createElement('div');
			container.id = 'toast-container';
			container.style.position = 'fixed';
			container.style.bottom = '24px';
			container.style.right = '24px';
			container.style.zIndex = '9999';
			container.style.display = 'flex';
			container.style.flexDirection = 'column';
			container.style.gap = '8px';
			document.body.appendChild(container);
		}
		
		const toast = document.createElement('div');
		toast.className = 'glass-panel';
		toast.style.background = 'rgba(16, 185, 129, 0.15)';
		toast.style.border = '1px solid rgba(16, 185, 129, 0.4)';
		toast.style.color = '#10b981';
		toast.style.padding = '12px 20px';
		toast.style.borderRadius = '10px';
		toast.style.fontSize = '0.875rem';
		toast.style.fontWeight = '600';
		toast.style.boxShadow = '0 10px 25px -5px rgba(0, 0, 0, 0.3)';
		toast.style.backdropFilter = 'blur(10px)';
		toast.style.webkitBackdropFilter = 'blur(10px)';
		toast.style.transition = 'all 0.3s cubic-bezier(0.16, 1, 0.3, 1)';
		toast.style.opacity = '0';
		toast.style.transform = 'translateY(20px)';
		toast.textContent = message;
		
		container.appendChild(toast);
		
		// Force reflow
		toast.offsetHeight;
		
		toast.style.opacity = '1';
		toast.style.transform = 'translateY(0)';
		
		setTimeout(() => {
			toast.style.opacity = '0';
			toast.style.transform = 'translateY(-20px)';
			setTimeout(() => {
				toast.remove();
			}, 300);
		}, 3000);
	}

	// 6. Form Handlers & Live Calculation
	function setupFormListeners() {
		const form = document.getElementById('create-order-form') as HTMLFormElement;
		const foodItemSelect = document.getElementById('food-item') as HTMLSelectElement;
		const customItemNameGroup = document.getElementById('custom-item-name-group') as HTMLDivElement;
		const customItemName = document.getElementById('custom-item-name') as HTMLInputElement;
		const quantityInput = document.getElementById('item-quantity') as HTMLInputElement;
		const priceInput = document.getElementById('item-price') as HTMLInputElement;
		const addToTicketBtn = document.getElementById('add-to-ticket-btn');
		const orderDownpayment = document.getElementById('order-downpayment') as HTMLInputElement;
		const customerName = document.getElementById('customer-name') as HTMLInputElement;
		const customerContact = document.getElementById('customer-contact') as HTMLInputElement;
		const customerAddress = document.getElementById('customer-address') as HTMLTextAreaElement;
		const deliveryDateTime = document.getElementById('delivery-date-time') as HTMLInputElement;

		// Item Customization DOM Elements
		const customizeItemToggleGroup = document.getElementById('customize-item-toggle-group') as HTMLDivElement;
		const customizeItemCheckbox = document.getElementById('customize-item-checkbox') as HTMLInputElement;
		const itemCustomizationSection = document.getElementById('item-customization-section') as HTMLDivElement;
		const customInclusionsList = document.getElementById('custom-inclusions-list') as HTMLDivElement;
		const btnAddInclusion = document.getElementById('btn-add-inclusion') as HTMLButtonElement;

		let formCustomInclusions: string[] = [];
		let selectedTraySize: 'Full' | 'Half' = 'Full';

		const setTraySize = (val: 'Full' | 'Half') => {
			selectedTraySize = val;
			const fullRadio = document.querySelector('input[name="tray-size"][value="Full"]') as HTMLInputElement;
			const halfRadio = document.querySelector('input[name="tray-size"][value="Half"]') as HTMLInputElement;
			const toggleFullLabel = document.getElementById('toggle-size-full');
			const toggleHalfLabel = document.getElementById('toggle-size-half');
			
			toggleFullLabel?.classList.toggle('active', val === 'Full');
			toggleHalfLabel?.classList.toggle('active', val === 'Half');
			
			if (fullRadio) fullRadio.checked = val === 'Full';
			if (halfRadio) halfRadio.checked = val === 'Half';
			
			// Recalculate price if item is selected and is not a custom item
			const selectedOption = foodItemSelect.options[foodItemSelect.selectedIndex];
			if (selectedOption && selectedOption.value && selectedOption.value !== 'Custom Item') {
				const fullPrice = parseFloat(selectedOption.getAttribute('data-price') || '0');
				if (val === 'Half') {
					const halfPrice = (fullPrice / 2) + 50;
					priceInput.value = halfPrice.toFixed(2);
				} else {
					priceInput.value = fullPrice.toFixed(2);
				}
			}
		};

		const toggleFullLabel = document.getElementById('toggle-size-full');
		const toggleHalfLabel = document.getElementById('toggle-size-half');
		toggleFullLabel?.addEventListener('click', () => setTraySize('Full'));
		toggleHalfLabel?.addEventListener('click', () => setTraySize('Half'));


		const renderCustomInclusions = () => {
			if (!customInclusionsList) return;
			customInclusionsList.innerHTML = formCustomInclusions.map((inc, idx) => `
				<div class="inclusion-edit-row" style="display: flex; align-items: center; gap: 8px;">
					<input type="text" class="custom-inclusion-input" data-idx="${idx}" value="${inc.replace(/"/g, '&quot;')}" placeholder="Inclusion item description..." style="flex: 1; padding: 8px 12px; font-size: 0.85rem; border-radius: 6px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.3); color: var(--text-primary);" />
					<button type="button" class="btn-delete-inclusion" data-idx="${idx}" style="background: transparent; border: none; color: #ef4444; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 6px; transition: color 0.2s;" title="Remove Inclusion">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
					</button>
				</div>
			`).join('');

			customInclusionsList.querySelectorAll('.custom-inclusion-input').forEach(input => {
				input.addEventListener('input', (e) => {
					const idxStr = (e.currentTarget as HTMLInputElement).getAttribute('data-idx');
					if (idxStr !== null) {
						const idx = parseInt(idxStr);
						formCustomInclusions[idx] = (e.currentTarget as HTMLInputElement).value;
					}
				});
			});

			customInclusionsList.querySelectorAll('.btn-delete-inclusion').forEach(btn => {
				btn.addEventListener('click', (e) => {
					const idxStr = (e.currentTarget as HTMLButtonElement).getAttribute('data-idx');
					if (idxStr !== null) {
						const idx = parseInt(idxStr);
						formCustomInclusions.splice(idx, 1);
						renderCustomInclusions();
					}
				});
			});
		};

		btnAddInclusion?.addEventListener('click', () => {
			formCustomInclusions.push('');
			renderCustomInclusions();
		});

		customizeItemCheckbox?.addEventListener('change', () => {
			if (customizeItemCheckbox.checked) {
				if (itemCustomizationSection) itemCustomizationSection.style.display = 'block';
				if (formCustomInclusions.length === 0) {
					const selectedOption = foodItemSelect.options[foodItemSelect.selectedIndex];
					formCustomInclusions = getInclusionsForForm(selectedOption.value) || [];
				}
				renderCustomInclusions();
			} else {
				if (itemCustomizationSection) itemCustomizationSection.style.display = 'none';
			}
		});

		// Slip filler toggles
		const toggleOwnerLabel = document.getElementById('toggle-owner-label');
		const toggleCustomerLabel = document.getElementById('toggle-customer-label');
		const prefillCustomerCheckbox = document.getElementById('prefill-customer-checkbox') as HTMLInputElement;

		const setSlipFiller = (val: 'Owner' | 'Customer') => {
			slipFiller = val;
			updateSlipFillerUI();
		};

		toggleOwnerLabel?.addEventListener('click', () => setSlipFiller('Owner'));
		toggleCustomerLabel?.addEventListener('click', () => setSlipFiller('Customer'));
		prefillCustomerCheckbox?.addEventListener('change', () => {
			updateSlipFillerUI();
		});

		customerName?.addEventListener('input', () => {
			const val = customerName.value.trim().toLowerCase();
			if (!val) return;
			// Find unique customer matching name from orders array
			const match = orders.find(o => {
				const name = (o.customer || '').trim();
				return name.toLowerCase() === val && name !== 'Pending Customer Details';
			});
			if (match && customerContact) {
				customerContact.value = (match.contact || '').trim();
			}
		});

		customerContact?.addEventListener('input', () => {
			const val = customerContact.value.trim().toLowerCase();
			if (!val) return;
			// Find unique customer matching contact from orders array
			const match = orders.find(o => {
				const contact = (o.contact || '').trim();
				return contact.toLowerCase() === val;
			});
			if (match && customerName && match.customer && match.customer !== 'Pending Customer Details') {
				customerName.value = (match.customer || '').trim();
			}
		});

		// Fulfillment Type Toggles
		const togglePickupLabel = document.getElementById('toggle-pickup-label');
		const toggleMeetupLabel = document.getElementById('toggle-meetup-label');
		const toggleDeliveryLabel = document.getElementById('toggle-delivery-label');
		const deliveryFeeGroup = document.getElementById('delivery-fee-group') as HTMLDivElement;
		const deliveryFeeInput = document.getElementById('delivery-fee') as HTMLInputElement;

		const setFulfillment = (val: 'Pickup' | 'Meetup' | 'Delivery') => {
			selectedFulfillment = val;
			const pickupRadio = document.querySelector('input[name="fulfillment-type"][value="Pickup"]') as HTMLInputElement;
			const meetupRadio = document.querySelector('input[name="fulfillment-type"][value="Meetup"]') as HTMLInputElement;
			const deliveryRadio = document.querySelector('input[name="fulfillment-type"][value="Delivery"]') as HTMLInputElement;

			togglePickupLabel?.classList.toggle('active', val === 'Pickup');
			toggleMeetupLabel?.classList.toggle('active', val === 'Meetup');
			toggleDeliveryLabel?.classList.toggle('active', val === 'Delivery');

			if (pickupRadio) pickupRadio.checked = val === 'Pickup';
			if (meetupRadio) meetupRadio.checked = val === 'Meetup';
			if (deliveryRadio) deliveryRadio.checked = val === 'Delivery';

			if (val === 'Pickup') {
				if (deliveryFeeGroup) deliveryFeeGroup.style.display = 'none';
				if (deliveryFeeInput) deliveryFeeInput.value = '0.00';
			} else if (val === 'Meetup') {
				if (deliveryFeeGroup) deliveryFeeGroup.style.display = 'block';
				if (deliveryFeeInput) deliveryFeeInput.value = '50.00';
			} else {
				if (deliveryFeeGroup) deliveryFeeGroup.style.display = 'block';
				if (deliveryFeeInput) deliveryFeeInput.value = '100.00';
			}
			calculateFormTotals(true);
		};

		togglePickupLabel?.addEventListener('click', () => setFulfillment('Pickup'));
		toggleMeetupLabel?.addEventListener('click', () => setFulfillment('Meetup'));
		toggleDeliveryLabel?.addEventListener('click', () => setFulfillment('Delivery'));

		deliveryFeeInput?.addEventListener('input', () => {
			calculateFormTotals(false); // Do not overwrite downpayment with default 50% on manually typing delivery fee
		});

		// Food Item change handler (Auto Fill Price)
		foodItemSelect?.addEventListener('change', () => {
			const selectedOption = foodItemSelect.options[foodItemSelect.selectedIndex];
			const price = parseFloat(selectedOption.getAttribute('data-price') || '0');
			
			if (selectedOption.value === 'Custom Item') {
				customItemNameGroup.style.display = 'block';
				customItemName.setAttribute('required', 'required');
				priceInput.value = '0.00';
			} else {
				customItemNameGroup.style.display = 'none';
				customItemName.removeAttribute('required');
				customItemName.value = '';
				priceInput.value = price.toFixed(2);
			}

			// Dessert option toggle
			const selectedValue = foodItemSelect.value;
			const isBellyPackage = ['P1 Package (Bilao)', 'P2 Package (Bilao)', 'P3 Package (Bilao)', 'P4 Package (Bilao)', 'P5 Package (Bilao)', 'P6 Package (Bilao)'].includes(selectedValue);
			const bellyDessertGroup = document.getElementById('belly-dessert-group') as HTMLDivElement;
			const bellyDessertSelect = document.getElementById('belly-dessert') as HTMLSelectElement;

			if (bellyDessertGroup && bellyDessertSelect) {
				if (isBellyPackage) {
					bellyDessertGroup.style.display = 'block';
					bellyDessertSelect.setAttribute('required', 'required');
				} else {
					bellyDessertGroup.style.display = 'none';
					bellyDessertSelect.removeAttribute('required');
					bellyDessertSelect.selectedIndex = 0;
					bellyDessertGroup.classList.remove('invalid');
				}
			}

			// Customization toggle check
			const defaultInclusions = getInclusionsForForm(selectedOption.value);
			if (defaultInclusions && defaultInclusions.length > 0) {
				if (customizeItemToggleGroup) customizeItemToggleGroup.style.display = 'block';
				if (customizeItemCheckbox) customizeItemCheckbox.checked = false;
				if (itemCustomizationSection) itemCustomizationSection.style.display = 'none';
				formCustomInclusions = [...defaultInclusions];
				formCustomInclusions = [];
			}

			// Food Tray Size Toggle
			const parentOptgroup = selectedOption.parentElement as HTMLOptGroupElement;
			const isFoodTray = parentOptgroup && parentOptgroup.label && parentOptgroup.label.startsWith('Food Trays');
			const foodtraySizeGroup = document.getElementById('foodtray-size-group') as HTMLDivElement;

			if (foodtraySizeGroup) {
				if (isFoodTray) {
					foodtraySizeGroup.style.display = 'block';
					setTraySize('Full');
				} else {
					foodtraySizeGroup.style.display = 'none';
					setTraySize('Full');
				}
			}
		});

		// Staged add button event listener
		addToTicketBtn?.addEventListener('click', () => {
			if (!validateItemInputs()) return;

			const selectedOption = foodItemSelect.options[foodItemSelect.selectedIndex];
			const isCustom = selectedOption.value === 'Custom Item';
			let itemName = isCustom ? customItemName.value.trim() : selectedOption.value;
			
			// Append dessert choice if it is a belly package
			const isBellyPackage = ['P1 Package (Bilao)', 'P2 Package (Bilao)', 'P3 Package (Bilao)', 'P4 Package (Bilao)', 'P5 Package (Bilao)', 'P6 Package (Bilao)'].includes(selectedOption.value);
			const bellyDessertSelect = document.getElementById('belly-dessert') as HTMLSelectElement;
			if (isBellyPackage && bellyDessertSelect && bellyDessertSelect.value) {
				itemName = `${itemName} [Dessert: ${bellyDessertSelect.value}]`;
			}

			const parentOptgroup = selectedOption.parentElement as HTMLOptGroupElement;
			const isFoodTray = parentOptgroup && parentOptgroup.label && parentOptgroup.label.startsWith('Food Trays');
			if (isFoodTray) {
				const size = selectedTraySize === 'Half' ? 'Half Tray' : 'Full Tray';
				itemName = `${itemName} (${size})`;
			}

			const qty = parseInt(quantityInput.value) || 1;
			const price = parseFloat(priceInput.value) || 0;
			const total = qty * price;

			const customInclusions = (customizeItemCheckbox && customizeItemCheckbox.checked) 
				? formCustomInclusions.filter(inc => inc.trim() !== '') 
				: undefined;

			const newItem: OrderItem = {
				name: itemName,
				quantity: qty,
				price: price,
				total: parseFloat(total.toFixed(2)),
				customInclusions: customInclusions
			};

			tempOrderItems.push(newItem);
			renderTicketItems();
			calculateFormTotals(true); // Auto compute downpayment recommendations

			// Reset item builder inputs for subsequent additions
			foodItemSelect.selectedIndex = 0;
			customItemNameGroup.style.display = 'none';
			customItemName.value = '';
			quantityInput.value = '1';
			priceInput.value = '';

			const bellyDessertGroup = document.getElementById('belly-dessert-group') as HTMLDivElement;
			if (bellyDessertGroup && bellyDessertSelect) {
				bellyDessertGroup.style.display = 'none';
				bellyDessertSelect.removeAttribute('required');
				bellyDessertSelect.selectedIndex = 0;
				bellyDessertGroup.classList.remove('invalid');
			}

			// Reset customization
			if (customizeItemCheckbox) customizeItemCheckbox.checked = false;
			if (customizeItemToggleGroup) customizeItemToggleGroup.style.display = 'none';
			if (itemCustomizationSection) itemCustomizationSection.style.display = 'none';
			formCustomInclusions = [];

			// Reset foodtray size toggle
			const foodtraySizeGroup = document.getElementById('foodtray-size-group') as HTMLDivElement;
			if (foodtraySizeGroup) {
				foodtraySizeGroup.style.display = 'none';
				setTraySize('Full');
			}

			// Remove validation errors on item inputs if present
			foodItemSelect.parentElement?.parentElement?.classList.remove('invalid');
			customItemNameGroup.classList.remove('invalid');
			priceInput.parentElement?.parentElement?.classList.remove('invalid');
		});

		// Listen to user overrides on Downpayment Input
		orderDownpayment?.addEventListener('input', () => {
			calculateFormTotals(false); // Update balance without overwriting downpayment
		});

		// Form Submit
		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			
			if (!validateForm()) return;

			// Create next Order ID
			let maxIdNum = 0;
			orders.forEach(o => {
				const num = parseInt(o.id.replace('ORD-', ''));
				if (num > maxIdNum) maxIdNum = num;
			});
			const nextIdNum = maxIdNum + 1;
			const nextId = `ORD-${nextIdNum.toString().padStart(3, '0')}`;

			// Get selected status radio
			const statusRadios = document.getElementsByName('order-status') as NodeListOf<HTMLInputElement>;
			let initialStatus: 'Pending' | 'Preparing' | 'Completed' | 'Cancelled' = 'Pending';
			statusRadios.forEach(radio => {
				if (radio.checked) {
					initialStatus = radio.value as any;
				}
			});

			// Format current date
			const now = new Date();
			const dateStr = `${now.getFullYear()}-${(now.getMonth()+1).toString().padStart(2, '0')}-${now.getDate().toString().padStart(2, '0')} ${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;

			// Setup values based on filler mode
			const isCustomerFill = slipFiller === 'Customer';
			const prefillCustomerCheckbox = document.getElementById('prefill-customer-checkbox') as HTMLInputElement;
			const isPrefillChecked = isCustomerFill && prefillCustomerCheckbox ? prefillCustomerCheckbox.checked : false;

			const customerVal = isCustomerFill 
				? (isPrefillChecked ? (customerName.value.trim() || "Pending Customer Details") : "Pending Customer Details") 
				: customerName.value.trim();
			const contactVal = isCustomerFill
				? (isPrefillChecked ? customerContact.value.trim() : "")
				: customerContact.value.trim();
			const customerFb = document.getElementById('customer-fb') as HTMLInputElement;
			const fbNameVal = isCustomerFill ? "" : (customerFb ? customerFb.value.trim() : "");
			const addressVal = isCustomerFill ? "" : customerAddress.value.trim();
			const deliveryVal = isCustomerFill ? "" : deliveryDateTime.value;
			const formattedDelivery = deliveryVal ? deliveryVal.replace('T', ' ') : "";

			const deliveryFeeVal = deliveryFeeInput ? parseFloat(deliveryFeeInput.value) || 0 : 0;
			const total = tempOrderItems.reduce((sum, item) => sum + item.total, 0) + deliveryFeeVal;
			const downpayment = parseFloat(orderDownpayment.value) || 0;
			const balance = parseFloat((total - downpayment).toFixed(2));

			const newOrder: Order = {
				id: nextId,
				date: dateStr,
				customer: customerVal,
				address: addressVal,
				contact: contactVal,
				facebookName: fbNameVal,
				deliveryDateTime: formattedDelivery,
				items: [...tempOrderItems],
				total: parseFloat(total.toFixed(2)),
				downpayment: parseFloat(downpayment.toFixed(2)),
				balance: balance,
				status: initialStatus,
				fulfillmentType: selectedFulfillment,
				deliveryFee: deliveryFeeVal
			};

			// Save via serverless function to avoid exposing service role and to satisfy RLS
			try {
				const resp = await fetch('/api/create-order', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						order: {
							id: newOrder.id,
							date: newOrder.date,
							customer: newOrder.customer,
							address: newOrder.address,
							contact: newOrder.contact,
							facebook_name: newOrder.facebookName || null,
							deliveryDateTime: newOrder.deliveryDateTime || null,
							fulfillmentType: newOrder.fulfillmentType ?? 'Delivery',
							status: newOrder.status,
							total: newOrder.total,
							downpayment: newOrder.downpayment,
							balance: newOrder.balance,
							deliveryFee: newOrder.deliveryFee ?? 0
						},
						items: newOrder.items,
						isOwnerFill: !isCustomerFill
					})
				});

				const result = await resp.json().catch(() => ({}));
				if (!resp.ok) {
					console.error('Failed to save order (server):', result);
					showToast('Failed to save order.');
					return;
				}
			} catch (e) {
				console.error('Failed to save order:', e);
				showToast('Failed to save order.');
				return;
			}

			orders.unshift(newOrder);
			updateDashboard();

			// Close Form Drawer
			const overlay = document.getElementById('order-modal-overlay');
			overlay?.classList.remove('active');

			if (isCustomerFill) {
				// Show customer link copy modal
				openCustomerLinkModal(nextId);
			} else {
				showToast('Order created successfully!');
			}
			
			resetForm();
		});
	}

	function validateItemInputs(): boolean {
		let isValid = true;
		const foodItemSelect = document.getElementById('food-item') as HTMLSelectElement;
		const selectGroup = foodItemSelect?.parentElement?.parentElement;
		
		if (!foodItemSelect.value) {
			selectGroup?.classList.add('invalid');
			isValid = false;
		} else {
			selectGroup?.classList.remove('invalid');
		}

		const customItemNameGroup = document.getElementById('custom-item-name-group') as HTMLDivElement;
		const customItemName = document.getElementById('custom-item-name') as HTMLInputElement;
		if (customItemNameGroup && customItemNameGroup.style.display === 'block') {
			if (!customItemName.value.trim()) {
				customItemNameGroup.classList.add('invalid');
				isValid = false;
			} else {
				customItemNameGroup.classList.remove('invalid');
			}
		}

		// Validation for belly dessert
		const bellyDessertGroup = document.getElementById('belly-dessert-group') as HTMLDivElement;
		const bellyDessert = document.getElementById('belly-dessert') as HTMLSelectElement;
		if (bellyDessertGroup && bellyDessertGroup.style.display === 'block') {
			if (!bellyDessert.value) {
				bellyDessertGroup.classList.add('invalid');
				isValid = false;
			} else {
				bellyDessertGroup.classList.remove('invalid');
			}
		}

		const priceInput = document.getElementById('item-price') as HTMLInputElement;
		const priceGroup = priceInput?.parentElement?.parentElement;
		const price = parseFloat(priceInput.value);
		if (isNaN(price) || price < 0) {
			priceGroup?.classList.add('invalid');
			isValid = false;
		} else {
			priceGroup?.classList.remove('invalid');
		}

		return isValid;
	}

	function renderTicketItems() {
		const listContainer = document.getElementById('ticket-items-list');
		if (!listContainer) return;

		if (tempOrderItems.length === 0) {
			listContainer.innerHTML = `
				<div class="ticket-empty-state" id="ticket-empty-state">
					No items added to this ticket yet.
				</div>
			`;
			return;
		}

		listContainer.innerHTML = tempOrderItems.map((item, idx) => {
			const customInclusionsHtml = (item.customInclusions && item.customInclusions.length > 0) ? `
				<div class="ticket-item-customizations" style="margin-top: 4px; padding-left: 12px; font-size: 0.75rem; color: var(--accent-primary); border-left: 2px solid var(--accent-primary);">
					<div style="font-weight: 700; text-transform: uppercase; font-size: 0.65rem; margin-bottom: 2px;">Custom Inclusions:</div>
					<ul style="margin: 0; padding-left: 12px; list-style-type: disc; color: var(--text-secondary);">
						${item.customInclusions.map(inc => `<li>${inc}</li>`).join('')}
					</ul>
				</div>
			` : '';
			return `
				<div class="ticket-item-wrapper" style="border-bottom: 1px solid rgba(255, 255, 255, 0.03); padding-bottom: 8px; margin-bottom: 8px;">
					<div class="ticket-item-row" style="border-bottom: none; padding-bottom: 0;">
						<div class="ticket-item-info">
							<span class="ticket-item-name">${item.name}</span>
							<span class="ticket-item-meta">${item.quantity}x @ ₱${item.price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
						</div>
						<div class="ticket-item-right" style="display: flex; align-items: center; gap: 12px;">
							<span class="ticket-item-total">₱${item.total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
							<button type="button" class="btn-remove-item" data-idx="${idx}" title="Remove Item">
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
							</button>
						</div>
					</div>
					${customInclusionsHtml}
				</div>
			`;
		}).join('');

		// Bind event handlers for removing item
		listContainer.querySelectorAll('.btn-remove-item').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const idxStr = (e.currentTarget as HTMLButtonElement).getAttribute('data-idx');
				if (idxStr !== null) {
					const idx = parseInt(idxStr);
					tempOrderItems.splice(idx, 1);
					renderTicketItems();
					calculateFormTotals(true);
				}
			});
		});
	}

	function calculateFormTotals(autoSetDownpayment = true) {
		const orderDownpayment = document.getElementById('order-downpayment') as HTMLInputElement;
		const deliveryFeeInput = document.getElementById('delivery-fee') as HTMLInputElement;
		const totalVal = document.getElementById('total-val');
		const downpaymentVal = document.getElementById('downpayment-val');
		const balanceVal = document.getElementById('balance-val');

		if (!totalVal || !downpaymentVal || !balanceVal || !orderDownpayment) return;

		const itemsTotal = tempOrderItems.reduce((sum, item) => sum + item.total, 0);
		const deliveryFee = deliveryFeeInput ? parseFloat(deliveryFeeInput.value) || 0 : 0;
		const total = itemsTotal + deliveryFee;
		
		if (autoSetDownpayment) {
			const s = loadSettings();
			const factor = (s.dpPct !== undefined ? s.dpPct : 50) / 100;
			orderDownpayment.value = (total * factor).toFixed(2);
		}

		const downpayment = parseFloat(orderDownpayment.value) || 0;
		const balance = Math.max(0, total - downpayment);

		totalVal.textContent = `₱${total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		downpaymentVal.textContent = `₱${downpayment.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		balanceVal.textContent = `₱${balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
	}

	function validateForm(): boolean {
		let isValid = true;
		const isOwner = slipFiller === 'Owner';
		const prefillCustomerCheckbox = document.getElementById('prefill-customer-checkbox') as HTMLInputElement;
		const isPrefillChecked = !isOwner && prefillCustomerCheckbox ? prefillCustomerCheckbox.checked : false;
		
		if (isOwner || isPrefillChecked) {
			// 1. Customer Name
			const customerName = document.getElementById('customer-name') as HTMLInputElement;
			const nameGroup = customerName?.parentElement?.parentElement;
			if (customerName && !customerName.value.trim()) {
				nameGroup?.classList.add('invalid');
				isValid = false;
			} else {
				nameGroup?.classList.remove('invalid');
			}

			// 2. Customer Contact
			const customerContact = document.getElementById('customer-contact') as HTMLInputElement;
			const contactGroup = customerContact?.parentElement?.parentElement;
			if (customerContact && !customerContact.value.trim()) {
				contactGroup?.classList.add('invalid');
				isValid = false;
			} else {
				contactGroup?.classList.remove('invalid');
			}
		}

		if (isOwner) {
			// 3. Customer Address (only required for Meetup or Delivery)
			const customerAddress = document.getElementById('customer-address') as HTMLTextAreaElement;
			const addressGroup = customerAddress?.parentElement?.parentElement;
			const isPickup = selectedFulfillment === 'Pickup';
			if (customerAddress && !isPickup && !customerAddress.value.trim()) {
				addressGroup?.classList.add('invalid');
				isValid = false;
			} else {
				addressGroup?.classList.remove('invalid');
			}

			// 4. Delivery Date & Time
			const deliveryDateTime = document.getElementById('delivery-date-time') as HTMLInputElement;
			const deliveryGroup = deliveryDateTime?.parentElement?.parentElement;
			if (deliveryDateTime && !deliveryDateTime.value) {
				deliveryGroup?.classList.add('invalid');
				isValid = false;
			} else {
				deliveryGroup?.classList.remove('invalid');
			}
		}

		// 5. Delivery Fee validation (only when shown/not Pickup)
		const deliveryFeeInput = document.getElementById('delivery-fee') as HTMLInputElement;
		const deliveryFeeGroup = deliveryFeeInput?.parentElement?.parentElement;
		if (deliveryFeeInput && selectedFulfillment !== 'Pickup') {
			const feeVal = parseFloat(deliveryFeeInput.value);
			if (isNaN(feeVal) || feeVal < 0) {
				deliveryFeeGroup?.classList.add('invalid');
				isValid = false;
			} else {
				deliveryFeeGroup?.classList.remove('invalid');
			}
		}

		// 6. Downpayment input
		const orderDownpayment = document.getElementById('order-downpayment') as HTMLInputElement;
		const downpaymentGroup = orderDownpayment?.parentElement?.parentElement;
		const downpaymentVal = parseFloat(orderDownpayment?.value);
		if (orderDownpayment && (isNaN(downpaymentVal) || downpaymentVal < 0)) {
			downpaymentGroup?.classList.add('invalid');
			isValid = false;
		} else {
			downpaymentGroup?.classList.remove('invalid');
		}

		// 7. Ticket Items length (at least one item added)
		const ticketContainer = document.querySelector('.ticket-items-container');
		if (tempOrderItems.length === 0) {
			ticketContainer?.classList.add('invalid');
			isValid = false;
		} else {
			ticketContainer?.classList.remove('invalid');
		}

		return isValid;
	}

	function resetForm() {
		const form = document.getElementById('create-order-form') as HTMLFormElement;
		if (form) form.reset();
		
		// Hide custom option
		const customItemNameGroup = document.getElementById('custom-item-name-group') as HTMLDivElement;
		if (customItemNameGroup) customItemNameGroup.style.display = 'none';

		// Hide and reset tray size selection
		const foodtraySizeGroup = document.getElementById('foodtray-size-group') as HTMLDivElement;
		if (foodtraySizeGroup) {
			foodtraySizeGroup.style.display = 'none';
			const fullRadio = document.querySelector('input[name="tray-size"][value="Full"]') as HTMLInputElement;
			if (fullRadio) fullRadio.checked = true;
			const toggleFullLabel = document.getElementById('toggle-size-full');
			const toggleHalfLabel = document.getElementById('toggle-size-half');
			toggleFullLabel?.classList.add('active');
			toggleHalfLabel?.classList.remove('active');
		}

		// Hide and reset dessert choice
		const bellyDessertGroup = document.getElementById('belly-dessert-group') as HTMLDivElement;
		const bellyDessertSelect = document.getElementById('belly-dessert') as HTMLSelectElement;
		if (bellyDessertGroup && bellyDessertSelect) {
			bellyDessertGroup.style.display = 'none';
			bellyDessertSelect.removeAttribute('required');
			bellyDessertSelect.selectedIndex = 0;
		}

		// Reset staging list
		tempOrderItems = [];
		renderTicketItems();

		// Reset slip filler UI
		slipFiller = 'Owner';
		const prefillCustomerCheckbox = document.getElementById('prefill-customer-checkbox') as HTMLInputElement;
		if (prefillCustomerCheckbox) prefillCustomerCheckbox.checked = false;
		updateSlipFillerUI();

		// Reset validation styling
		document.querySelectorAll('.form-group').forEach(group => {
			group.classList.remove('invalid');
		});
		document.querySelector('.ticket-items-container')?.classList.remove('invalid');

		// Reset fulfillment selection
		const togglePickupLabel = document.getElementById('toggle-pickup-label');
		const toggleMeetupLabel = document.getElementById('toggle-meetup-label');
		const toggleDeliveryLabel = document.getElementById('toggle-delivery-label');
		const deliveryFeeGroup = document.getElementById('delivery-fee-group') as HTMLDivElement;
		const deliveryFeeInput = document.getElementById('delivery-fee') as HTMLInputElement;

		if (togglePickupLabel && toggleMeetupLabel && toggleDeliveryLabel && deliveryFeeGroup && deliveryFeeInput) {
			selectedFulfillment = 'Pickup';
			const pickupRadio = document.querySelector('input[name="fulfillment-type"][value="Pickup"]') as HTMLInputElement;
			if (pickupRadio) pickupRadio.checked = true;
			togglePickupLabel.classList.add('active');
			toggleMeetupLabel.classList.remove('active');
			toggleDeliveryLabel.classList.remove('active');
			deliveryFeeGroup.style.display = 'none';
			deliveryFeeInput.value = '0.00';
		}

		// Recalculate totals
		calculateFormTotals(true);
	}

	// ===== SPA NAVIGATION =====
	const VIEW_TITLES: Record<string, string> = {
		'dashboard': 'Order Dashboard',
		'order-history': 'Order History',
		'analytics': 'Analytics',
		'live-kitchen': 'Live Kitchen',
		'calendar': 'Order Calendar',
		'settings': 'Settings',
	};

	let kitchenRefreshInterval: ReturnType<typeof setInterval> | null = null;

	function navigateTo(view: string) {
		// Update hash to preserve view state on refresh
		if (window.location.hash.slice(1) !== view) {
			window.location.hash = view;
		}

		// Hide all views
		document.querySelectorAll<HTMLElement>('.view-container').forEach(v => v.style.display = 'none');
		const target = document.getElementById(`view-${view}`);
		if (target) target.style.display = 'flex';

		// Update nav active state
		document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
		document.querySelector(`.nav-item[data-view="${view}"]`)?.classList.add('active');

		// Update page title
		const titleEl = document.getElementById('page-title');
		if (titleEl) titleEl.textContent = VIEW_TITLES[view] || view;

		// Show/hide Add Order button
		const addBtn = document.getElementById('open-order-modal-btn');
		if (addBtn) addBtn.style.display = view === 'dashboard' ? '' : 'none';

		// Clear kitchen refresh if leaving that view
		if (view !== 'live-kitchen' && kitchenRefreshInterval) {
			clearInterval(kitchenRefreshInterval);
			kitchenRefreshInterval = null;
		}

		// Render view-specific content
		if (view === 'order-history') renderHistoryView();
		if (view === 'analytics') renderAnalyticsView();
		if (view === 'live-kitchen') {
			renderKitchenView();
			kitchenRefreshInterval = setInterval(renderKitchenView, 30000);
		}
		if (view === 'calendar') renderCalendarView();
		if (view === 'settings') renderSettingsView();
	}

	function setupNavigation() {
		document.querySelectorAll<HTMLAnchorElement>('.nav-item[data-view]').forEach(link => {
			link.addEventListener('click', (e) => {
				e.preventDefault();
				const view = link.getAttribute('data-view')!;
				navigateTo(view);
			});
		});

		// Listen for browser back/forward buttons (hash changes)
		window.addEventListener('hashchange', () => {
			const view = window.location.hash.slice(1) || 'dashboard';
			const validViews = ['dashboard', 'order-history', 'analytics', 'live-kitchen', 'calendar', 'settings'];
			if (validViews.includes(view)) {
				navigateTo(view);
			} else {
				navigateTo('dashboard');
			}
		});
	}

	// ===== ORDER HISTORY VIEW =====
	let historyFilter = 'All';
	let historySearch = '';
	let historyFrom = '';
	let historyTo = '';

	function renderHistoryView() {
		// Update counts
		const statuses = ['All','Pending','Preparing','Completed','Cancelled'] as const;
		statuses.forEach(s => {
			const el = document.getElementById(`hcount-${s.toLowerCase()}`);
			if (el) {
				if (s === 'All') el.textContent = orders.length.toString();
				else if (s === 'Pending') el.textContent = orders.filter(o => o.status === 'Pending' && ((o.customer || '').trim() !== 'Pending Customer Details' && (o.customer || '').trim() !== '' && !!o.deliveryDateTime)).length.toString();
				else el.textContent = orders.filter(o => o.status === s).length.toString();
			}
		});
		// Pending (Customer) special count
		const elPendingCust = document.getElementById('hcount-pending-customer');
		if (elPendingCust) elPendingCust.textContent = orders.filter(o => ((o.customer || '').trim() === 'Pending Customer Details' || (o.customer || '').trim() === '' || !o.deliveryDateTime) && o.status !== 'Completed' && o.status !== 'Cancelled').length.toString();

		// Filter
		let filtered = [...orders];
		if (historyFilter !== 'All') {
			if (historyFilter === 'PendingCustomer') {
				filtered = filtered.filter(o => ((o.customer || '').trim() === 'Pending Customer Details' || (o.customer || '').trim() === '' || !o.deliveryDateTime) && o.status !== 'Completed' && o.status !== 'Cancelled');
			} else if (historyFilter === 'Pending') {
				filtered = filtered.filter(o => o.status === 'Pending' && ((o.customer || '').trim() !== 'Pending Customer Details' && (o.customer || '').trim() !== '' && !!o.deliveryDateTime));
			} else {
				filtered = filtered.filter(o => o.status === historyFilter);
			}
		}
		if (historySearch.trim()) {
			const q = historySearch.toLowerCase();
			filtered = filtered.filter(o => {
				try {
					const idMatch = (o.id || '').toString().toLowerCase().includes(q);
					const custMatch = ((o.customer || '')).toString().toLowerCase().includes(q);
					return idMatch || custMatch;
				} catch (e) {
					console.error('History search filter error for order', o && o.id, e);
					return false;
				}
			});
		}
		if (historyFrom) filtered = filtered.filter(o => (o.deliveryDateTime || o.date) >= historyFrom);
		if (historyTo) filtered = filtered.filter(o => (o.deliveryDateTime || o.date) <= historyTo + 'T23:59');

		filtered.sort((a, b) => {
			const da = new Date((a.deliveryDateTime || a.date).replace(' ', 'T')).getTime() || 0;
			const db = new Date((b.deliveryDateTime || b.date).replace(' ', 'T')).getTime() || 0;
			return db - da; // Latest delivery/order date first
		});

		const tbody = document.getElementById('history-body');
		const empty = document.getElementById('history-empty');
		if (!tbody || !empty) return;

		if (filtered.length === 0) {
			tbody.innerHTML = '';
			empty.style.display = 'flex';
		} else {
			empty.style.display = 'none';
			tbody.innerHTML = filtered.map(o => {
				const sc = `badge-${o.status.toLowerCase()}`;
				return `<tr>
					<td style="font-weight:700;color:var(--accent-primary)">#${o.id.replace('ORD-','')}</td>
					<td class="customer-cell">
						<div class="customer-cell-inner">
							<span class="customer-name">${(o.customer && o.customer !== 'Pending Customer Details') ? escapeHtml(o.customer) : '<span class="text-muted">Pending Customer Details</span>'}</span>
							${(o.customer === 'Pending Customer Details' || !o.customer || !o.deliveryDateTime) ? '<span class="awaiting-badge">Awaiting customer details</span>' : ''}
						</div>
						${(o.contact && o.contact.trim()) ? `<div class="customer-contact" style="font-size:0.75rem;color:var(--text-muted);margin-top:2px;">${escapeHtml(o.contact)}</div>` : ''}
					</td>
					<td style="font-weight:700">₱${o.total.toLocaleString('en-US',{minimumFractionDigits:2})}</td>
					<td style="color:var(--status-preparing)">₱${o.downpayment.toLocaleString('en-US',{minimumFractionDigits:2})}</td>
					<td style="color:var(--accent-primary)">₱${o.balance.toLocaleString('en-US',{minimumFractionDigits:2})}${o.status === 'Completed' ? ' <span style="font-size:0.7rem;color:#10b981;font-weight:800;display:block;">Settled</span>' : ''}</td>
					<td style="color:var(--text-secondary);font-size:0.8rem">${o.deliveryDateTime ? formatDateTime12h(o.deliveryDateTime) : formatDateTime12h(o.date)}</td>
					<td><span class="status-badge ${sc}">${o.status}</span></td>
					<td><button class="action-btn btn-view-details" data-id="${o.id}" title="View Details" style="padding:6px">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0z"/><circle cx="12" cy="12" r="3"/></svg>
					</button></td>
				</tr>`;
			}).join('');
			// Bind detail buttons
			tbody.querySelectorAll('.btn-view-details').forEach(btn => {
				btn.addEventListener('click', e => {
					const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
					if (id) openDetailsModal(id);
				});
			});
		}

		// Setup tab listeners once
		const tabsEl = document.getElementById('history-tabs');
		if (tabsEl && !tabsEl.dataset.bound) {
			tabsEl.dataset.bound = '1';
			tabsEl.querySelectorAll('.filter-tab').forEach(tab => {
				tab.addEventListener('click', () => {
					tabsEl.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
					tab.classList.add('active');
					historyFilter = tab.getAttribute('data-status') || 'All';
					renderHistoryView();
				});
			});
		}

		const searchEl = document.getElementById('history-search') as HTMLInputElement;
		if (searchEl && !searchEl.dataset.bound) {
			searchEl.dataset.bound = '1';
			searchEl.addEventListener('input', () => { historySearch = searchEl.value; renderHistoryView(); });
		}
		const fromEl = document.getElementById('history-from') as HTMLInputElement;
		const toEl = document.getElementById('history-to') as HTMLInputElement;
		if (fromEl && !fromEl.dataset.bound) {
			fromEl.dataset.bound = '1';
			fromEl.addEventListener('change', () => { historyFrom = fromEl.value; renderHistoryView(); });
		}
		if (toEl && !toEl.dataset.bound) {
			toEl.dataset.bound = '1';
			toEl.addEventListener('change', () => { historyTo = toEl.value; renderHistoryView(); });
		}

		const csvBtn = document.getElementById('export-csv-btn');
		if (csvBtn && !csvBtn.dataset.bound) {
			csvBtn.dataset.bound = '1';
			csvBtn.addEventListener('click', () => exportCSV(filtered));
		}
	}

	function exportCSV(rows: Order[]) {
		const headers = ['Order #','Customer','Items','Total','Downpayment','Balance','Delivery Date','Status'];
		const csvRows = [headers.join(','), ...rows.map(o => [
			o.id, `"${o.customer}"`,
			`"${o.items.map(it => `${it.quantity}x ${it.name}`).join('; ')}"`,
			o.total, o.downpayment, o.balance,
			`"${o.deliveryDateTime || o.date}"`, o.status
		].join(','))];
		const blob = new Blob([csvRows.join('\n')], { type: 'text/csv' });
		const a = document.createElement('a');
		a.href = URL.createObjectURL(blob);
		a.download = `orders_${new Date().toISOString().slice(0,10)}.csv`;
		a.click();
	}

	// ===== ANALYTICS VIEW =====
	function renderAnalyticsView() {
		const valid = orders.filter(o => o.status !== 'Cancelled');
		const completed = valid.filter(o => o.status === 'Completed');
		const revenue = completed.reduce((s, o) => s + o.total, 0);
		const avg = completed.length ? revenue / completed.length : 0;
		const completionRate = orders.length ? Math.round((completed.length / orders.length) * 100) : 0;
		const topOrder = valid.length ? Math.max(...valid.map(o => o.total)) : 0;

		const summaryEl = document.getElementById('analytics-summary');
		if (summaryEl) {
			summaryEl.innerHTML = [
				{ label: 'Total Revenue', value: `₱${revenue.toLocaleString('en-US',{minimumFractionDigits:2, maximumFractionDigits:2})}`, sub: 'from completed orders' },
				{ label: 'Completion Rate', value: `${completionRate}%`, sub: `${completed.length} of ${orders.length} orders` },
				{ label: 'Avg Order Value', value: `₱${avg.toLocaleString('en-US',{minimumFractionDigits:2, maximumFractionDigits:2})}`, sub: 'completed orders' },
				{ label: 'Highest Order', value: `₱${topOrder.toLocaleString('en-US',{minimumFractionDigits:2, maximumFractionDigits:2})}`, sub: 'single order' },
			].map(c => `<div class="analytic-card"><span class="a-label">${c.label}</span><span class="a-value">${c.value}</span><span class="a-sub">${c.sub}</span></div>`).join('');
		}

		// Bar chart (Daily Revenue Trend)
		const barEl = document.getElementById('revenue-bar-chart');
		if (barEl) {
			const dailyRevenue: Record<string, number> = {};
			completed.forEach(o => {
				const dateKey = (o.deliveryDateTime || o.date).substring(0, 10);
				if (dateKey) {
					dailyRevenue[dateKey] = (dailyRevenue[dateKey] || 0) + o.total;
				}
			});

			const sortedDates = Object.keys(dailyRevenue).sort();
			const recentDates = sortedDates.slice(-12); // Last 12 days of revenue
			const maxRevenue = recentDates.length ? Math.max(...recentDates.map(d => dailyRevenue[d])) : 1;

			const formatShortDate = (dateStr: string) => {
				const d = new Date(dateStr + 'T00:00:00');
				if (isNaN(d.getTime())) return dateStr;
				return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
			};

			barEl.innerHTML = recentDates.map(dateKey => {
				const rev = dailyRevenue[dateKey];
				const pct = Math.max(4, Math.round((rev / maxRevenue) * 140)); // 140px max height
				return `<div class="bar-wrap" title="${dateKey}: ₱${rev.toLocaleString('en-US', { minimumFractionDigits: 2 })}">
					<div class="bar-fill" style="height:${pct}px;background:#10b981"></div>
					<span class="bar-id">${formatShortDate(dateKey)}</span>
				</div>`;
			}).join('') || '<span style="color:var(--text-muted);font-size:0.8rem;padding:16px">No completed orders yet.</span>';
		}

		// Donut chart
		const donutEl = document.getElementById('status-donut');
		const legendEl = document.getElementById('donut-legend');
		if (donutEl && legendEl) {
			const statusMap: Record<string, { count: number; color: string }> = {
				Pending: { count: 0, color: '#f59e0b' },
				Preparing: { count: 0, color: '#f97316' },
				Completed: { count: 0, color: '#10b981' },
				Cancelled: { count: 0, color: '#ef4444' },
			};
			orders.forEach(o => { if (statusMap[o.status]) statusMap[o.status].count++; });
			const total = orders.length || 1;
			let offset = 25;
			const r = 40, cx = 60, cy = 60, circ = 2 * Math.PI * r;
			const segments = Object.entries(statusMap).filter(([,v]) => v.count > 0).map(([label, v]) => {
				const pct = v.count / total;
				const dash = circ * pct;
				const seg = `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${v.color}" stroke-width="14" stroke-dasharray="${dash} ${circ - dash}" stroke-dashoffset="${-circ * (offset/100)}" style="transform-origin:center;transform:rotate(-90deg)"/>`;
				offset += pct * 100;
				return { seg, label, v };
			});
			donutEl.innerHTML = `<svg width="120" height="120" viewBox="0 0 120 120">${segments.map(s => s.seg).join('')}<circle cx="${cx}" cy="${cy}" r="26" fill="var(--bg-primary)"/><text x="${cx}" y="${cy+2}" text-anchor="middle" dominant-baseline="middle" fill="var(--text-primary)" font-size="13" font-weight="800">${orders.length}</text><text x="${cx}" y="${cy+16}" text-anchor="middle" dominant-baseline="middle" fill="var(--text-muted)" font-size="7">orders</text></svg>`;
			legendEl.innerHTML = segments.map(s => `<div class="legend-item"><div class="legend-dot" style="background:${s.v.color}"></div><span>${s.label}: <strong>${s.v.count}</strong></span></div>`).join('');
		}

		// Top items
		const topEl = document.getElementById('analytics-top-items');
		if (topEl) {
			const agg: Record<string, { qty: number; rev: number }> = {};
			valid.forEach(o => o.items.forEach(it => {
				if (it.price > 0 && isPackageOrTrayOrLechon(it.name)) {
					let normName = normalizeItemName(it.name);
					if (normName === '1 Whole Lechon Baboy') {
						if (it.price === 15999) {
							normName = 'Set A Lechon Package';
						} else if (it.price === 18675) {
							normName = 'Set B Lechon Package';
						} else if (it.price === 19999) {
							normName = 'Set C Lechon Package';
						}
					}
					if (!agg[normName]) agg[normName] = { qty: 0, rev: 0 };
					agg[normName].qty += it.quantity;
					agg[normName].rev += it.total;
				}
			}));
			const sorted = Object.entries(agg).sort((a,b) => b[1].qty - a[1].qty).slice(0, 6);
			topEl.innerHTML = sorted.map(([name, d], i) => `<div class="analytics-top-item">
				<span class="ati-rank">#${i+1}</span>
				<span class="ati-name">${name}</span>
				<span class="ati-qty">${d.qty} sold</span>
				<span class="ati-rev">₱${d.rev.toLocaleString('en-US',{minimumFractionDigits:2})}</span>
			</div>`).join('') || '<span style="color:var(--text-muted);font-size:0.8rem;padding:8px">No sales data.</span>';
		}
	}

	// ===== LIVE KITCHEN VIEW =====
	function renderKitchenView() {
		const active = getActiveOrders().sort((a,b) => a.date.localeCompare(b.date));

		const pendingCount = document.getElementById('kitchen-pending-count');
		const preparingCount = document.getElementById('kitchen-preparing-count');
		
		const pendingOrders = active.filter(o => o.status === 'Pending');
		const preparingOrders = active.filter(o => o.status === 'Preparing');

		if (pendingCount) pendingCount.textContent = `${pendingOrders.length} Pending`;
		if (preparingCount) preparingCount.textContent = `${preparingOrders.length} Preparing`;

		const kcolPendingCount = document.getElementById('kcol-pending-count');
		const kcolPreparingCount = document.getElementById('kcol-preparing-count');
		if (kcolPendingCount) kcolPendingCount.textContent = pendingOrders.length.toString();
		if (kcolPreparingCount) kcolPreparingCount.textContent = preparingOrders.length.toString();

		const pendingBody = document.getElementById('kds-pending-body');
		const preparingBody = document.getElementById('kds-preparing-body');
		const pendingEmpty = document.getElementById('kds-pending-empty');
		const preparingEmpty = document.getElementById('kds-preparing-empty');
		const board = document.querySelector('.kds-board') as HTMLElement;
		const empty = document.getElementById('kitchen-empty');

		if (!pendingBody || !preparingBody || !pendingEmpty || !preparingEmpty || !board || !empty) return;

		if (active.length === 0) {
			board.style.display = 'none';
			empty.style.display = 'flex';
		} else {
			board.style.display = 'grid';
			empty.style.display = 'none';

			// Render Pending Column
			if (pendingOrders.length === 0) {
				pendingBody.innerHTML = '';
				pendingEmpty.style.display = 'flex';
			} else {
				pendingEmpty.style.display = 'none';
				const now = new Date();
				pendingBody.innerHTML = pendingOrders.map(o => renderKitchenCard(o, now)).join('');
			}

			// Render Preparing Column
			if (preparingOrders.length === 0) {
				preparingBody.innerHTML = '';
				preparingEmpty.style.display = 'flex';
			} else {
				preparingEmpty.style.display = 'none';
				const now = new Date();
				preparingBody.innerHTML = preparingOrders.map(o => renderKitchenCard(o, now)).join('');
			}

			// Bind Action Listeners
			const bindActions = (container: HTMLElement) => {
				container.querySelectorAll('[data-action]').forEach(btn => {
					btn.addEventListener('click', e => {
						const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
						const action = (e.currentTarget as HTMLElement).getAttribute('data-action')!;
						if (action === 'details') { openDetailsModal(id); return; }
						if (action === 'prepare') updateOrderStatus(id, 'Preparing');
						if (action === 'complete') updateOrderStatus(id, 'Completed');
						if (action === 'cancel') updateOrderStatus(id, 'Cancelled');
						renderKitchenView();
						updateDashboard();
					});
				});
			};

			bindActions(pendingBody);
			bindActions(preparingBody);
		}

		const refreshBtn = document.getElementById('kitchen-refresh-btn');
		if (refreshBtn && !refreshBtn.dataset.bound) {
			refreshBtn.dataset.bound = '1';
			refreshBtn.addEventListener('click', async () => {
				await loadOrders();
				renderKitchenView();
			});
		}
	}

	function renderKitchenCard(o: Order, now: Date): string {
		const orderDate = new Date(o.date.replace(' ', 'T'));
		const mins = isNaN(orderDate.getTime()) ? 0 : Math.floor((now.getTime() - orderDate.getTime()) / 60000);
		const elapsed = mins < 60 ? `${mins}m ago` : `${Math.floor(mins/60)}h ${mins%60}m ago`;
		const itemsHTML = o.items.map(it => {
			const customInclusionsHtml = (it.customInclusions && it.customInclusions.length > 0) ? `
				<div class="kcard-item-inclusions" style="font-size: 0.7rem; color: var(--accent-primary); margin-top: 2px; padding-left: 8px; border-left: 1.5px solid var(--accent-primary); font-style: italic; opacity: 0.9;">
					+ ${it.customInclusions.join(', ')}
				</div>
			` : '';
			return `
				<div style="margin-bottom: 6px;">
					<div class="kcard-item" style="margin-bottom: 0;"><strong>${it.quantity}x</strong> ${it.name}</div>
					${customInclusionsHtml}
				</div>
			`;
		}).join('');
		const isPending = o.status === 'Pending';
		
		return `<div class="kitchen-card status-${o.status.toLowerCase()}">
			<div class="kcard-header">
				<span class="kcard-id">#${o.id.replace('ORD-','')}</span>
				<div style="display:flex;align-items:center;gap:8px">
					<span class="kcard-timer">${elapsed}</span>
					<button class="kcard-btn-details" data-id="${o.id}" data-action="details" title="View Full Details">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0z"/><circle cx="12" cy="12" r="3"/></svg>
					</button>
				</div>
			</div>
			<div class="kcard-customer">👤 ${o.customer === 'Pending Customer Details' ? 'Customer TBD' : o.customer}</div>
			<div class="kcard-items">${itemsHTML}</div>
			<div class="kcard-actions">
				${isPending ? `<button class="kcard-btn kcard-btn-prepare" data-id="${o.id}" data-action="prepare">▶ Prepare</button>` : ''}
				${!isPending ? `<button class="kcard-btn kcard-btn-complete" data-id="${o.id}" data-action="complete">✓ Complete</button>` : ''}
				<button class="kcard-btn kcard-btn-cancel" data-id="${o.id}" data-action="cancel">✕ Cancel</button>
			</div>
		</div>`;
	}

	// ===== SETTINGS VIEW =====
	const SETTINGS_KEY = 'flavorflow_settings';
	interface AppSettings { maribankName: string; maribankNum: string; gcashName: string; gcashNum: string; dpPct: number; }
	const DEFAULT_SETTINGS: AppSettings = { maribankName: 'Christy Montejo', maribankNum: '11953471393', gcashName: 'Christy Montejo', gcashNum: '09760721404', dpPct: 50 };

	function loadSettings(): AppSettings {
		try { return { ...DEFAULT_SETTINGS, ...JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}') }; }
		catch { return { ...DEFAULT_SETTINGS }; }
	}
	function saveSettings(s: AppSettings) { localStorage.setItem(SETTINGS_KEY, JSON.stringify(s)); }

	function getSettingsParam(): string {
		try {
			const s = loadSettings();
			if (
				s.maribankName === DEFAULT_SETTINGS.maribankName &&
				s.maribankNum === DEFAULT_SETTINGS.maribankNum &&
				s.gcashName === DEFAULT_SETTINGS.gcashName &&
				s.gcashNum === DEFAULT_SETTINGS.gcashNum &&
				s.dpPct === DEFAULT_SETTINGS.dpPct
			) {
				return '';
			}
			const parts = [
				s.maribankName || '',
				s.maribankNum || '',
				s.gcashName || '',
				s.gcashNum || '',
				s.dpPct !== undefined ? String(s.dpPct) : '50'
			];
			const rawStr = parts.join('|');
			const b64 = btoa(unescape(encodeURIComponent(rawStr)));
			return '&s=' + encodeURIComponent(b64);
		} catch (e) {
			return '';
		}
	}

	function getOrderSignature(orderId: string): string {
		const salt = 'montejo_order_security_salt_2026'; 
		let h1 = 0xdeadbeef, h2 = 0x41c6ce57;
		const str = orderId + salt;
		for (let i = 0, ch; i < str.length; i++) {
			ch = str.charCodeAt(i);
			h1 = Math.imul(h1 ^ ch, 2654435761);
			h2 = Math.imul(h2 ^ ch, 1597334903);
		}
		h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507);
		h1 ^= Math.imul(h2 ^ (h2 >>> 13), 3266489909);
		h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507);
		h2 ^= Math.imul(h1 ^ (h1 >>> 13), 3266489909);
		return ((h2 >>> 0).toString(16).padStart(8, '0') + (h1 >>> 0).toString(16).padStart(8, '0')).slice(0, 10);
	}

	function populatePastCustomersDatalists() {
		const namesDatalist = document.getElementById('past-customers-names');
		const contactsDatalist = document.getElementById('past-customers-contacts');
		if (!namesDatalist || !contactsDatalist) return;

		namesDatalist.innerHTML = '';
		contactsDatalist.innerHTML = '';

		const uniqueCustomersMap = new Map<string, {name: string, contact: string}>();
		orders.forEach(o => {
			const name = (o.customer || '').trim();
			const contact = (o.contact || '').trim();
			if (name && name !== 'Pending Customer Details' && contact) {
				const key = `${name.toLowerCase()}|||${contact.toLowerCase()}`;
				if (!uniqueCustomersMap.has(key)) {
					uniqueCustomersMap.set(key, { name, contact });
				}
			}
		});

		const uniqueCustomers = Array.from(uniqueCustomersMap.values());

		// Populate names datalist
		const uniqueNames = new Set(uniqueCustomers.map(c => c.name));
		uniqueNames.forEach(name => {
			const option = document.createElement('option');
			option.value = name;
			namesDatalist.appendChild(option);
		});

		// Populate contacts datalist
		const uniqueContacts = new Set(uniqueCustomers.map(c => c.contact));
		uniqueContacts.forEach(contact => {
			const option = document.createElement('option');
			option.value = contact;
			contactsDatalist.appendChild(option);
		});
	}

	function updateSlipFillerUI() {
		const toggleOwnerLabel = document.getElementById('toggle-owner-label');
		const toggleCustomerLabel = document.getElementById('toggle-customer-label');
		const prefillToggleGroup = document.getElementById('prefill-toggle-group');
		const prefillCustomerCheckbox = document.getElementById('prefill-customer-checkbox') as HTMLInputElement;
		const customerDetailsSection = document.getElementById('customer-details-section');
		const submitBtnText = document.getElementById('submit-btn-text');
		const customerName = document.getElementById('customer-name') as HTMLInputElement;
		const customerContact = document.getElementById('customer-contact') as HTMLInputElement;
		const customerAddress = document.getElementById('customer-address') as HTMLTextAreaElement;
		const deliveryDateTime = document.getElementById('delivery-date-time') as HTMLInputElement;

		const isOwner = slipFiller === 'Owner';
		const isPrefillChecked = prefillCustomerCheckbox ? prefillCustomerCheckbox.checked : false;

		if (isOwner) {
			toggleOwnerLabel?.classList.add('active');
			toggleCustomerLabel?.classList.remove('active');
			if (prefillToggleGroup) prefillToggleGroup.style.display = 'none';
			
			// Show all customer details fields
			if (customerDetailsSection) customerDetailsSection.style.display = 'block';
			
			const nameGroup = customerName?.closest('.form-group');
			const contactGroup = customerContact?.closest('.form-group');
			const addressGroup = customerAddress?.closest('.form-group');
			const datetimeGroup = deliveryDateTime?.closest('.form-group');
			
			if (nameGroup) (nameGroup as HTMLElement).style.display = 'flex';
			if (contactGroup) (contactGroup as HTMLElement).style.display = 'flex';
			if (addressGroup) (addressGroup as HTMLElement).style.display = 'flex';
			if (datetimeGroup) (datetimeGroup as HTMLElement).style.display = 'flex';

			if (submitBtnText) submitBtnText.textContent = 'Submit Order';
			customerName?.setAttribute('required', 'required');
			customerContact?.setAttribute('required', 'required');
			customerAddress?.setAttribute('required', 'required');
			deliveryDateTime?.setAttribute('required', 'required');
		} else {
			toggleOwnerLabel?.classList.remove('active');
			toggleCustomerLabel?.classList.add('active');
			if (prefillToggleGroup) prefillToggleGroup.style.display = 'flex';

			if (submitBtnText) submitBtnText.textContent = 'Generate Customer Link';
			
			// Hide address and delivery date-time (never pre-filled by owner in customer mode)
			const addressGroup = customerAddress?.closest('.form-group');
			const datetimeGroup = deliveryDateTime?.closest('.form-group');
			if (addressGroup) (addressGroup as HTMLElement).style.display = 'none';
			if (datetimeGroup) (datetimeGroup as HTMLElement).style.display = 'none';
			customerAddress?.removeAttribute('required');
			deliveryDateTime?.removeAttribute('required');

			if (isPrefillChecked) {
				// Show customer details container, but only show name and contact inputs
				if (customerDetailsSection) customerDetailsSection.style.display = 'block';
				
				const nameGroup = customerName?.closest('.form-group');
				const contactGroup = customerContact?.closest('.form-group');
				if (nameGroup) (nameGroup as HTMLElement).style.display = 'flex';
				if (contactGroup) (contactGroup as HTMLElement).style.display = 'flex';

				customerName?.setAttribute('required', 'required');
				customerContact?.setAttribute('required', 'required');
			} else {
				// Hide everything
				if (customerDetailsSection) customerDetailsSection.style.display = 'none';
				
				customerName?.removeAttribute('required');
				customerContact?.removeAttribute('required');
			}
		}
	}

	function updateFormPaymentDetails() {
		try {
			const s = loadSettings();
			document.querySelectorAll('.form-maribank-name').forEach(el => el.textContent = s.maribankName || '');
			document.querySelectorAll('.form-maribank-num').forEach(el => el.textContent = s.maribankNum || '');
			document.querySelectorAll('.form-gcash-name').forEach(el => el.textContent = s.gcashName || '');
			document.querySelectorAll('.form-gcash-num').forEach(el => el.textContent = s.gcashNum || '');
			
			const pct = s.dpPct !== undefined ? s.dpPct : 50;
			const noteEl = document.getElementById('form-payment-note');
			if (noteEl) {
				noteEl.textContent = `Note: To confirm your order, we are requesting ${pct}% downpayment of the total bill, then the rest will be paid upon pickup/delivery of orders.`;
			}
		} catch (e) {
			// ignore
		}
	}

	function renderSettingsView() {
		const s = loadSettings();
		const fields: [string, keyof AppSettings][] = [
			['s-maribank-name','maribankName'],['s-maribank-num','maribankNum'],
			['s-gcash-name','gcashName'],['s-gcash-num','gcashNum'],['s-dp-pct','dpPct']
		];
		fields.forEach(([id, key]) => {
			const el = document.getElementById(id) as HTMLInputElement;
			if (el && !el.dataset.bound) el.value = String(s[key]);
		});

		const savePayBtn = document.getElementById('save-payment-btn');
		if (savePayBtn && !savePayBtn.dataset.bound) {
			savePayBtn.dataset.bound = '1';
			savePayBtn.addEventListener('click', () => {
				const cur = loadSettings();
				cur.maribankName = (document.getElementById('s-maribank-name') as HTMLInputElement)?.value || cur.maribankName;
				cur.maribankNum = (document.getElementById('s-maribank-num') as HTMLInputElement)?.value || cur.maribankNum;
				cur.gcashName = (document.getElementById('s-gcash-name') as HTMLInputElement)?.value || cur.gcashName;
				cur.gcashNum = (document.getElementById('s-gcash-num') as HTMLInputElement)?.value || cur.gcashNum;
				saveSettings(cur);
				updateFormPaymentDetails();
				showToast('Payment info saved!');
			});
		}

		const saveDpBtn = document.getElementById('save-dp-btn');
		if (saveDpBtn && !saveDpBtn.dataset.bound) {
			saveDpBtn.dataset.bound = '1';
			saveDpBtn.addEventListener('click', () => {
				const cur = loadSettings();
				const pct = parseFloat((document.getElementById('s-dp-pct') as HTMLInputElement)?.value);
				if (!isNaN(pct) && pct >= 0 && pct <= 100) { 
					cur.dpPct = pct; 
					saveSettings(cur); 
					updateFormPaymentDetails();
					showToast(`Default downpayment set to ${pct}%`); 
				}
				else showToast('Enter a valid percentage (0–100)');
			});
		}

		const clearBtn = document.getElementById('clear-orders-btn');
		if (clearBtn && !clearBtn.dataset.bound) {
			clearBtn.dataset.bound = '1';
			clearBtn.addEventListener('click', async () => {
				if (await showConfirm('Clear ALL orders from the database? This cannot be undone.')) {
					const { error } = await supabase.from('orders').delete().neq('id', '');
					if (error) { showToast('Failed to clear orders.'); return; }
					orders = [];
					updateDashboard();
					showToast('All orders cleared.');
				}
			});
		}
	}

	// Theme Toggle Logic
	const themeToggleBtn = document.getElementById('theme-toggle-btn');
	const sunIcon = document.querySelector('.sun-icon') as HTMLElement;
	const moonIcon = document.querySelector('.moon-icon') as HTMLElement;

	function updateThemeIcons(theme: string) {
		if (theme === 'light') {
			if (sunIcon) sunIcon.style.display = 'none';
			if (moonIcon) moonIcon.style.display = 'block';
		} else {
			if (sunIcon) sunIcon.style.display = 'block';
			if (moonIcon) moonIcon.style.display = 'none';
		}
	}

	// Initialize theme icon display
	const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
	updateThemeIcons(currentTheme);

	themeToggleBtn?.addEventListener('click', () => {
		const current = document.documentElement.getAttribute('data-theme') || 'dark';
		const nextTheme = current === 'dark' ? 'light' : 'dark';
		document.documentElement.setAttribute('data-theme', nextTheme);
		localStorage.setItem('theme', nextTheme);
		updateThemeIcons(nextTheme);
	});

	// ===== CALENDAR VIEW =====
	let calYear = new Date().getFullYear();
	let calMonth = new Date().getMonth(); // 0-indexed
	let calSelectedDate: string | null = null;

	function renderCalendarView() {
		const grid = document.getElementById('cal-grid');
		const label = document.getElementById('cal-month-label');
		const prevBtn = document.getElementById('cal-prev-btn');
		const nextBtn = document.getElementById('cal-next-btn');
		if (!grid || !label) return;

		// Build order count map keyed by 'YYYY-MM-DD'
		const countMap: Record<string, { count: number; orders: Order[] }> = {};
		orders.forEach(o => {
			// Use delivery date if available, otherwise created date
			const raw = o.deliveryDateTime || o.date;
			const dateKey = raw ? raw.slice(0, 10) : null;
			if (!dateKey) return;
			if (!countMap[dateKey]) countMap[dateKey] = { count: 0, orders: [] };
			countMap[dateKey].count++;
			countMap[dateKey].orders.push(o);
		});

		// Month label
		label.textContent = new Date(calYear, calMonth, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

		// Wire up nav buttons (once)
		if (prevBtn && !prevBtn.dataset.calBound) {
			prevBtn.dataset.calBound = '1';
			prevBtn.addEventListener('click', () => {
				if (calMonth === 0) { calMonth = 11; calYear--; } else { calMonth--; }
				calSelectedDate = null;
				renderCalendarView();
			});
		}
		if (nextBtn && !nextBtn.dataset.calBound) {
			nextBtn.dataset.calBound = '1';
			nextBtn.addEventListener('click', () => {
				if (calMonth === 11) { calMonth = 0; calYear++; } else { calMonth++; }
				calSelectedDate = null;
				renderCalendarView();
			});
		}

		// Build calendar grid
		const firstDay = new Date(calYear, calMonth, 1).getDay(); // 0=Sun
		const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
		const todayStr = new Date().toISOString().slice(0, 10);

		let html = '';
		// Blank cells for offset
		for (let i = 0; i < firstDay; i++) {
			html += `<div class="cal-cell cal-cell-empty"></div>`;
		}
		// Day cells
		for (let d = 1; d <= daysInMonth; d++) {
			const mm = String(calMonth + 1).padStart(2, '0');
			const dd = String(d).padStart(2, '0');
			const dateKey = `${calYear}-${mm}-${dd}`;
			const info = countMap[dateKey];
			const isToday = dateKey === todayStr;
			const isSelected = dateKey === calSelectedDate;
			const hasOrders = info && info.count > 0;

			let cls = 'cal-cell';
			if (isToday) cls += ' cal-today';
			if (isSelected) cls += ' cal-selected';
			if (hasOrders) cls += ' cal-has-orders';

			const badge = hasOrders
				? `<span class="cal-order-badge">${info.count}</span>`
				: '';

			html += `<div class="${cls}" data-date="${dateKey}" tabindex="0" role="button" aria-label="${dateKey}">
				<span class="cal-day-num">${d}</span>
				${badge}
			</div>`;
		}
		grid.innerHTML = html;

		// Click listeners on day cells
		grid.querySelectorAll<HTMLElement>('.cal-cell[data-date]').forEach(cell => {
			cell.addEventListener('click', () => {
				const date = cell.getAttribute('data-date')!;
				calSelectedDate = date;
				// Update selected highlight
				grid.querySelectorAll('.cal-cell').forEach(c => c.classList.remove('cal-selected'));
				cell.classList.add('cal-selected');
				// Render day orders panel
				renderCalendarDayPanel(date, countMap[date]?.orders || []);
			});
			cell.addEventListener('keydown', (e: KeyboardEvent) => {
				if (e.key === 'Enter' || e.key === ' ') cell.click();
			});
		});

		// If a date was already selected, re-render its panel
		if (calSelectedDate) {
			renderCalendarDayPanel(calSelectedDate, countMap[calSelectedDate]?.orders || []);
		} else {
			renderCalendarDayPanel(null, []);
		}
	}

	function renderCalendarDayPanel(dateKey: string | null, dayOrders: Order[]) {
		const header = document.getElementById('cal-day-header');
		const body = document.getElementById('cal-day-orders');
		if (!header || !body) return;

		if (!dateKey) {
			header.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="3" x2="21" y1="10" y2="10"/></svg><span>Select a date to view orders</span>`;
			body.innerHTML = '';
			return;
		}

		const formatted = new Date(dateKey + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
		header.innerHTML = `
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
			<div>
				<div class="cal-day-title">${formatted}</div>
				<div class="cal-day-count">${dayOrders.length} order${dayOrders.length !== 1 ? 's' : ''}</div>
			</div>`;

		if (dayOrders.length === 0) {
			body.innerHTML = `<div class="cal-no-orders">
				<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/></svg>
				<p>No orders on this day</p>
			</div>`;
			return;
		}

		const statusClass: Record<string, string> = {
			Pending: 'status-pending',
			Preparing: 'status-preparing',
			Completed: 'status-completed',
			Cancelled: 'status-cancelled'
		};

		body.innerHTML = dayOrders.map(o => `
			<div class="cal-order-card">
				<div class="cal-order-top">
					<div>
						<div class="cal-order-customer">${o.customer}</div>
						<div class="cal-order-id">#${o.id}</div>
					</div>
					<span class="status-badge ${statusClass[o.status] || ''} cal-order-status">${o.status}</span>
				</div>
				<div class="cal-order-items">${o.items.map(it => `<span class="cal-order-item-pill">${it.quantity}× ${it.name}</span>`).join('')}</div>
				<div class="cal-order-footer">
					<span class="cal-order-total">₱${o.total.toLocaleString('en-US', { minimumFractionDigits: 2 })}</span>
					${o.deliveryDateTime ? `<span class="cal-order-time">${formatTime12h(o.deliveryDateTime)}</span>` : ''}
				</div>
			</div>`).join('');
	}
</script>
