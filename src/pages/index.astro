	function bindEditSectionListeners() {
		const modal = document.getElementById('details-modal-body');
		if (!modal) return;

		// Section Edit buttons click
		modal.querySelectorAll('.btn-edit-section').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const section = (e.currentTarget as HTMLButtonElement).getAttribute('data-section');
				if (section) {
					activeEditSection = section as any;
					if (section === 'items') {
						const order = orders.find(o => o.id === currentEditingOrderId);
						if (order) {
							editItemsStaged = order.items.map(it => ({
								name: it.name,
								quantity: it.quantity,
								price: it.price,
								total: it.total,
								customInclusions: it.customInclusions ? [...it.customInclusions] : []
							}));
						}
					}
					renderDetailsModalContent();
				}
			});
		});

		// Cancel Edit buttons click
		modal.querySelectorAll('.btn-cancel-edit').forEach(btn => {
			btn.addEventListener('click', () => {
				activeEditSection = null;
				renderDetailsModalContent();
			});
		});

		// 1. Save Customer Info Form
		const customerForm = document.getElementById('edit-customer-form');
		customerForm?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const id = currentEditingOrderId;
			if (!id) return;
			const order = orders.find(o => o.id === id);
			if (!order) return;

			const name = (document.getElementById('edit-customer-name') as HTMLInputElement).value.trim();
			const fulfillmentType = (document.getElementById('edit-fulfillment-type') as HTMLSelectElement).value;
			const status = (document.getElementById('edit-order-status') as HTMLSelectElement).value;
			const address = (document.getElementById('edit-customer-address') as HTMLInputElement).value.trim();
			const contact = (document.getElementById('edit-customer-contact') as HTMLInputElement).value.trim();
			const facebookName = (document.getElementById('edit-facebook-name') as HTMLInputElement).value.trim();
			const deliveryDateTime = (document.getElementById('edit-delivery-datetime') as HTMLInputElement).value;
			const formattedDelivery = deliveryDateTime ? deliveryDateTime.replace('T', ' ') : '';

			const orderUpdates = {
				customer: name,
				fulfillment_type: fulfillmentType,
				status: status,
				address: address,
				contact: contact,
				facebook_name: facebookName || null,
				delivery_date_time: formattedDelivery || null
			};

			try {
				const resp = await fetch('/api/update-order', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id, orderUpdates })
				});
				if (!resp.ok) {
					showToast('Failed to update customer details.');
					return;
				}
				// Update local state
				order.customer = name;
				order.fulfillmentType = fulfillmentType as any;
				order.status = status as any;
				order.address = address;
				order.contact = contact;
				order.facebookName = facebookName;
				order.deliveryDateTime = formattedDelivery;

				activeEditSection = null;
				updateDashboard();
				renderDetailsModalContent();
				showToast('Customer details updated!');
			} catch (err) {
				console.error(err);
				showToast('Error updating customer details.');
			}
		});

		// 2. Save Payment Form
		const paymentForm = document.getElementById('edit-payment-form');
		paymentForm?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const id = currentEditingOrderId;
			if (!id) return;
			const order = orders.find(o => o.id === id);
			if (!order) return;

			const deliveryFee = parseFloat((document.getElementById('edit-delivery-fee') as HTMLInputElement).value) || 0;
			const downpayment = parseFloat((document.getElementById('edit-downpayment') as HTMLInputElement).value) || 0;

			const itemsTotal = order.items.reduce((s, it) => s + it.total, 0);
			const total = parseFloat((itemsTotal + deliveryFee).toFixed(2));
			const balance = parseFloat((total - downpayment).toFixed(2));

			const orderUpdates = {
				delivery_fee: deliveryFee,
				downpayment: downpayment,
				total: total,
				balance: balance
			};

			try {
				const resp = await fetch('/api/update-order', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id, orderUpdates })
				});
				if (!resp.ok) {
					showToast('Failed to update payment details.');
					return;
				}
				// Update local state
				order.deliveryFee = deliveryFee;
				order.downpayment = downpayment;
				order.total = total;
				order.balance = balance;

				activeEditSection = null;
				updateDashboard();
				renderDetailsModalContent();
				showToast('Payment breakdown updated!');
			} catch (err) {
				console.error(err);
				showToast('Error updating payments.');
			}
		});

		// 3. Save Items Form
		const itemsForm = document.getElementById('edit-items-form');
		itemsForm?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const id = currentEditingOrderId;
			if (!id) return;
			const order = orders.find(o => o.id === id);
			if (!order) return;

			// Extract list of items from inputs
			const rows = modal.querySelectorAll('.edit-item-row');
			const updatedItems: OrderItem[] = [];
			
			rows.forEach(row => {
				const qty = parseInt((row.querySelector('.edit-item-qty') as HTMLInputElement).value) || 1;
				const name = (row.querySelector('.edit-item-name') as HTMLInputElement).value.trim();
				const price = parseFloat((row.querySelector('.edit-item-price') as HTMLInputElement).value) || 0;
				const total = parseFloat((qty * price).toFixed(2));
				
				const inclusionsStr = (row.querySelector('.edit-item-inclusions') as HTMLInputElement).value;
				const customInclusions = inclusionsStr.split(',')
					.map(s => s.trim())
					.filter(s => s.length > 0);

				updatedItems.push({
					name,
					quantity: qty,
					price,
					total,
					customInclusions
				});
			});

			if (updatedItems.length === 0) {
				showToast('An order must have at least one item.');
				return;
			}

			// Recompute order totals
			const itemsTotal = updatedItems.reduce((s, it) => s + it.total, 0);
			const deliveryFee = order.deliveryFee || 0;
			const total = parseFloat((itemsTotal + deliveryFee).toFixed(2));
			const balance = parseFloat((total - order.downpayment).toFixed(2));

			const orderUpdates = {
				total: total,
				balance: balance
			};

			try {
				const resp = await fetch('/api/update-order', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id, orderUpdates, items: updatedItems })
				});
				if (!resp.ok) {
					showToast('Failed to update items.');
					return;
				}
				// Update local state
				order.items = updatedItems;
				order.total = total;
				order.balance = balance;

				activeEditSection = null;
				updateDashboard();
				renderDetailsModalContent();
				showToast('Items breakdown updated!');
			} catch (err) {
				console.error(err);
				showToast('Error updating items.');
			}
		});

		// Dynamic list actions for Items Edit Mode
		const btnAddEditItem = document.getElementById('btn-add-edit-item');
		btnAddEditItem?.addEventListener('click', () => {
			editItemsStaged.push({
				name: '',
				quantity: 1,
				price: 0,
				total: 0,
				customInclusions: []
			});
			renderDetailsModalContent();
			// Focus new item name input
			const inputs = modal.querySelectorAll('.edit-item-name');
			if (inputs.length > 0) {
				(inputs[inputs.length - 1] as HTMLInputElement).focus();
			}
		});

		modal.querySelectorAll('.btn-remove-edit-item').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const idxStr = (e.currentTarget as HTMLButtonElement).getAttribute('data-idx');
				if (idxStr !== null) {
					const idx = parseInt(idxStr);
					editItemsStaged.splice(idx, 1);
					renderDetailsModalContent();
				}
			});
		});

		// Sync changes from inputs back to stage list
		modal.querySelectorAll('.edit-item-qty, .edit-item-price, .edit-item-name, .edit-item-inclusions').forEach(input => {
			input.addEventListener('change', (e) => {
				const row = (e.currentTarget as HTMLElement).closest('.edit-item-row');
				if (!row) return;
				const idxStr = row.getAttribute('data-idx');
				if (idxStr !== null) {
					const idx = parseInt(idxStr);
					const qty = parseInt((row.querySelector('.edit-item-qty') as HTMLInputElement).value) || 1;
					const name = (row.querySelector('.edit-item-name') as HTMLInputElement).value.trim();
					const price = parseFloat((row.querySelector('.edit-item-price') as HTMLInputElement).value) || 0;
					const inclusionsStr = (row.querySelector('.edit-item-inclusions') as HTMLInputElement).value;
					const customInclusions = inclusionsStr.split(',')
						.map(s => s.trim())
						.filter(s => s.length > 0);

					editItemsStaged[idx] = {
						name,
						quantity: qty,
						price,
						total: parseFloat((qty * price).toFixed(2)),
						customInclusions
					};
				}
			});
		});
	}

	function bindModalActionButtons() {
		const modal = document.getElementById('details-modal-body');
		if (!modal) return;

		// Prepare Button
		modal.querySelectorAll('.btn-prepare').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (!id) return;
				const confirmed = await showConfirm(`Are you sure you want to mark Order #${id.replace('ORD-', '')} as Preparing?`);
				if (confirmed) {
					await updateOrderStatus(id, 'Preparing');
					renderDetailsModalContent();
				}
			});
		});

		// Complete Button
		modal.querySelectorAll('.btn-complete').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (!id) return;
				const confirmed = await showConfirm(`Are you sure you want to mark Order #${id.replace('ORD-', '')} as Completed?`);
				if (confirmed) {
					await updateOrderStatus(id, 'Completed');
					const detailsModalOverlay = document.getElementById('details-modal-overlay');
					detailsModalOverlay?.classList.remove('active');
				}
			});
		});

		// Cancel Button
		modal.querySelectorAll('.btn-cancel').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (!id) return;
				const confirmed = await showConfirm(`Are you sure you want to cancel Order #${id.replace('ORD-', '')}?`);
				if (confirmed) {
					await updateOrderStatus(id, 'Cancelled');
					const detailsModalOverlay = document.getElementById('details-modal-overlay');
					detailsModalOverlay?.classList.remove('active');
				}
			});
		});

		// Delete Button
		modal.querySelectorAll('.btn-delete').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (!id) return;
				const confirmed = await showConfirm(`Are you sure you want to delete the record for Order #${id.replace('ORD-', '')}?`);
				if (confirmed) {
					await deleteOrder(id);
					const detailsModalOverlay = document.getElementById('details-modal-overlay');
					detailsModalOverlay?.classList.remove('active');
				}
			});
		});

		// Copy Confirmation Slip Button
		modal.querySelectorAll('.btn-copy-slip').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (id) {
					copyConfirmationSlip(id, e.currentTarget as HTMLButtonElement);
				}
			});
		});

		// Get Customer Share Link Button
		modal.querySelectorAll('.btn-get-link').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (id) {
					const sig = getOrderSignature(id);
					const settingsParam = getSettingsParam();
					const uniqueLink = window.location.origin + '/order?id=' + id + '&t=' + sig + settingsParam;
					navigator.clipboard.writeText(uniqueLink).then(() => {
						const target = e.currentTarget as HTMLButtonElement;
						target.classList.add('copied');
						const oldHTML = target.innerHTML;
						target.innerHTML = `
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
							<span>Copied!</span>
						`;
						showToast('Customer share link copied to clipboard!');
						// persist copied state
						try { localStorage.setItem('copied_link_' + id, '1'); } catch (e) {}
						// also update the table action button if present
						const tableBtn = document.querySelector('.btn-get-link[data-id="' + id + '"]') as HTMLButtonElement;
						if (tableBtn) {
							const old = tableBtn.innerHTML;
							tableBtn.classList.add('copied');
							tableBtn.innerHTML = `\n\t\t\t\t<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>\n\t\t\t\t<span>Copied!</span>\n\t\t\t`;
							setTimeout(() => {
								tableBtn.classList.remove('copied');
								tableBtn.innerHTML = old;
							}, 2000);
						}
						setTimeout(() => {
							target.classList.remove('copied');
							target.innerHTML = oldHTML;
						}, 2000);
					}).catch(err => {
						console.error('Could not copy link to clipboard: ', err);
					});
				}
			});
		});

		// Download Receipt Button
		modal.querySelectorAll('.btn-download-receipt').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (id) {
					downloadReceipt(id);
				}
			});
		});

		// Save Owner Note (localStorage) - visible only to owner/admin in UI
		const saveNoteBtn = modal.querySelector('#save-note-btn') as HTMLButtonElement | null;
		if (saveNoteBtn) {
			saveNoteBtn.addEventListener('click', async (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id') || currentEditingOrderId;
				if (!id) return;
				const ta = modal.querySelector('#owner-note') as HTMLTextAreaElement | null;
				if (!ta) return;
				const val = ta.value.trim();
				// Persist to backend via existing update-order API
				try {
					const resp = await fetch('/api/update-order', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ id, orderUpdates: { note: val } })
					});
					if (!resp.ok) { showToast('Failed to save note.'); return; }
					// Update local state
					const ord = orders.find(o => o.id === id);
					if (ord) ord.note = val;
					showToast('Note saved (owner only).');
					updateDashboard();
					renderDetailsModalContent();
				} catch (err) {
					console.error('Failed to save note:', err);
					showToast('Failed to save note.');
				}
			});
		}
	}

	function getActionButtonsHTML(order: Order) {
		let actionButtons = '';
		
		// Contextual action buttons based on status
		if (order.status === 'Pending') {
			actionButtons += `
				<button class="action-btn btn-prepare" data-id="${order.id}" title="Start Preparing">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"/><rect width="12" height="8" x="6" y="14" rx="1"/></svg>
					<span>Prepare Order</span>
				</button>
			`;
		} else if (order.status === 'Preparing') {
			actionButtons += `
				<button class="action-btn btn-complete" data-id="${order.id}" title="Complete Order">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
					<span>Complete Order</span>
				</button>
			`;
		}

		// Add Cancel button if not Completed/Cancelled
		if (order.status === 'Pending' || order.status === 'Preparing') {
			actionButtons += `
				<button class="action-btn btn-cancel" data-id="${order.id}" title="Cancel Order">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
					<span>Cancel</span>
				</button>
			`;
		}

		// Add Delete button for cancelled or completed orders
		actionButtons += `
			<button class="action-btn btn-delete" data-id="${order.id}" title="Delete Record">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
				<span>Delete</span>
			</button>
		`;

		// Prepend Get Link button if details are pending from customer or delivery date-time is missing
		if (order.customer === 'Pending Customer Details' || !order.deliveryDateTime) {
			let copied = false;
			try { copied = !!localStorage.getItem('copied_link_' + order.id); } catch (e) {}
			if (copied) {
				actionButtons = `
					<button class="action-btn btn-get-link copied" data-id="${order.id}" title="Customer Share Link (copied)">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
						<span>Copied!</span>
					</button>
				` + actionButtons;
			} else {
				actionButtons = `
					<button class="action-btn btn-get-link" data-id="${order.id}" title="Copy Customer Share Link">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
						<span>Copy Link</span>
					</button>
				` + actionButtons;
			}
		}

		// Prepend Copy Confirmation Slip button to all action buttons
		actionButtons = `
			<button class="action-btn btn-copy-slip" data-id="${order.id}" title="Copy Confirmation Slip">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
				<span>Copy Slip</span>
			</button>
		` + actionButtons;

		// Prepend Download Receipt button
		actionButtons = `
			<button class="action-btn btn-download-receipt" data-id="${order.id}" title="Download Receipt" style="background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.25); color: #10b981;">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
				<span>Receipt</span>
			</button>
		` + actionButtons;

		return actionButtons;
	}

	async function updateOrderStatus(id: string, newStatus: 'Pending' | 'Preparing' | 'Completed' | 'Cancelled') {
		try {
			const resp = await fetch('/api/update-order', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					id,
					orderUpdates: { status: newStatus }
				})
			});
			if (!resp.ok) {
				const body = await resp.json().catch(() => ({}));
				console.error('Failed to update status (server):', body);
				showToast('Failed to update order status.');
				return;
			}
			const orderIdx = orders.findIndex(o => o.id === id);
			if (orderIdx > -1) orders[orderIdx].status = newStatus;
			updateDashboard();
			showToast(`Order status updated to ${newStatus}!`);
		} catch (e) {
			console.error('Failed to update status:', e);
			showToast('Failed to update order status.');
		}
	}

	async function deleteOrder(id: string) {
		try {
			const resp = await fetch('/api/delete-order', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ id })
			});
			const body = await resp.json().catch(() => ({}));
			if (!resp.ok) { console.error('Failed to delete order (server):', body); showToast('Failed to delete order.'); return; }
			// remove from UI
			orders = orders.filter(o => o.id !== id);
			updateDashboard();
			showToast('Order deleted successfully!');
		} catch (e) {
			console.error('Failed to delete order:', e);
			showToast('Failed to delete order.');
		}
	}

	function openCustomerLinkModal(id: string) {
		const linkModalOverlay = document.getElementById('link-modal-overlay');
		const shareableLinkInput = document.getElementById('shareable-link-input') as HTMLInputElement;
		const openShareableLinkBtn = document.getElementById('open-shareable-link-btn') as HTMLAnchorElement;
		const sig = getOrderSignature(id);
		const settingsParam = getSettingsParam();
		const uniqueLink = window.location.origin + '/order?id=' + id + '&t=' + sig + settingsParam;
		if (shareableLinkInput) shareableLinkInput.value = uniqueLink;
		if (openShareableLinkBtn) openShareableLinkBtn.href = uniqueLink;
		
		linkModalOverlay?.classList.add('active');
	}

	// Clipboard Copy Confirmation Slip Helper
	function copyConfirmationSlip(id: string, btn: HTMLButtonElement) {
		const order = orders.find(o => o.id === id);
		if (!order) return;

		const itemsText = order.items.map(it => {
			let text = `${it.quantity}x ${it.name}`;
			if (it.customInclusions && it.customInclusions.length > 0) {
				text += `\n  (Custom Inclusions:\n` + it.customInclusions.map(inc => `   - ${inc}`).join('\n') + `)`;
			}
			return text;
		}).join('\n');
		const subtotal = order.total - (order.deliveryFee || 0);
		const deliveryFee = order.deliveryFee || 0;
		
		const slipText = `C O N F I R M A T I O N   S L I P
Please fill up the following.

Name: ${order.customer}
Fulfillment: ${order.fulfillmentType || 'Delivery'}
Exact Address: ${order.address}
Contact Number of the Receiver/s: ${order.contact}
Time & Date: ${order.deliveryDateTime ? formatDateTime12h(order.deliveryDateTime) : 'Pending Customer Input'}
List of Order/s:
${itemsText}

