	// ── Supabase helpers ──────────────────────────────────────
	function mapRow(row: any): Order {
		return {
			id: row.id,
			date: row.date,
			customer: row.customer,
			note: row.note ?? '',
			address: row.address,
			contact: row.contact,
			deliveryDateTime: row.delivery_date_time ?? '',
			fulfillmentType: row.fulfillment_type ?? 'Delivery',
			status: row.status,
			total: parseFloat(row.total),
			downpayment: parseFloat(row.downpayment),
			balance: parseFloat(row.balance),
			deliveryFee: parseFloat(row.delivery_fee ?? 0),
			facebookName: row.facebook_name ?? '',
			items: (row.order_items ?? []).map((it: any) => ({
				name: it.name,
				quantity: it.quantity,
				price: parseFloat(it.price),
				total: parseFloat(it.total),
				customInclusions: it.custom_inclusions ?? []
			}))
		};
	}

	function checkAndTransitionOrderStatus(order: Order): string {
		if (order.status === 'Completed' || order.status === 'Cancelled') {
			return order.status;
		}
		const deliveryStr = order.deliveryDateTime;
		if (!deliveryStr) return order.status;

		const deliveryTime = new Date(deliveryStr.replace(' ', 'T'));
		if (isNaN(deliveryTime.getTime())) return order.status;

		const now = new Date();
		const diffMs = deliveryTime.getTime() - now.getTime();
		const diffHours = diffMs / (1000 * 60 * 60);

		let newStatus = order.status;
		if (now >= deliveryTime) {
			newStatus = 'Completed';
		} else if (diffHours <= 4) {
			newStatus = 'Preparing';
		}

		if (newStatus !== order.status) {
			order.status = newStatus as 'Pending' | 'Preparing' | 'Completed' | 'Cancelled';
			
			// Fire-and-forget update to Supabase
			supabase
				.from('orders')
				.update({ status: newStatus })
				.eq('id', order.id)
				.then(({ error }) => {
					if (error) {
						console.error(`Error auto-updating status for ${order.id}:`, error.message);
					} else {
						console.log(`Auto-updated order ${order.id} status to ${newStatus} based on schedule.`);
					}
				});
		}

		return newStatus;
	}

	async function loadOrders(): Promise<void> {
		const { data, error } = await supabase
			.from('orders')
			.select('*, order_items(*)')
			.order('created_at', { ascending: false });
		if (error) { console.error('Error loading orders:', error.message); return; }
		orders = (data ?? []).map(mapRow);

		// Auto-transition statuses based on schedule
		orders.forEach(checkAndTransitionOrderStatus);
	}

	async function saveState(): Promise<void> {
		// No-op: individual mutations now go directly to Supabase.
		// Kept for call-site compatibility — callers simply await this.
	}

	// Initialize the Dashboard
	document.addEventListener('DOMContentLoaded', async () => {
		// Set current date
		updateDateDisplay();

		// Set default payment and downpayment details in the order form from settings
		updateFormPaymentDetails();

		// Load orders from Supabase
		await loadOrders();

		// Initial render and calculations
		updateDashboard();

		// Set up event listeners
		setupEventListeners();
		setupFormListeners();
		setupNavigation();

		// Mobile Sidebar Toggle
		const mobileMenuBtn = document.getElementById('mobile-menu-btn');
		const sidebar = document.querySelector('.sidebar');
		const sidebarOverlay = document.getElementById('sidebar-overlay');

		if (mobileMenuBtn && sidebar && sidebarOverlay) {
			mobileMenuBtn.addEventListener('click', () => {
				sidebar.classList.add('active');
				sidebarOverlay.classList.add('active');
			});

			sidebarOverlay.addEventListener('click', () => {
				sidebar.classList.remove('active');
				sidebarOverlay.classList.remove('active');
			});

			sidebar.querySelectorAll('.nav-item').forEach(link => {
				link.addEventListener('click', () => {
					sidebar.classList.remove('active');
					sidebarOverlay.classList.remove('active');
				});
			});
		}

		// Initial view routing based on URL hash to preserve view state on refresh
		const initialView = window.location.hash.slice(1) || 'dashboard';
		const validViews = ['dashboard', 'order-history', 'analytics', 'live-kitchen', 'calendar', 'settings'];
		if (validViews.includes(initialView)) {
			navigateTo(initialView);
		} else {
			navigateTo('dashboard');
		}
	});

	function updateDateDisplay() {
		const dateEl = document.getElementById('current-date');
		if (dateEl) {
			const options: Intl.DateTimeFormatOptions = { 
				weekday: 'long', 
				year: 'numeric', 
				month: 'long', 
				day: 'numeric' 
			};
			dateEl.textContent = new Date().toLocaleDateString('en-US', options);
		}
	}

	function updateDashboard() {
		calculateStats();
		calculateBestSellers();
		renderOrdersTable();
		updateTabCounts();
	}

	// 1. Calculations & Metrics
	function calculateStats() {
		// Filter out cancelled orders for revenue & sold item calculations
		const validOrders = orders.filter(o => o.status !== 'Cancelled');
		
		// Total Revenue (only Completed or Preparing)
		const revenue = validOrders
			.filter(o => o.status === 'Completed' || o.status === 'Preparing')
			.reduce((sum, o) => sum + o.total, 0);
		
		// Active Orders (Pending + Preparing) but exclude orders missing customer details
		const activeCount = getActiveOrders().length;
		
		// Total Items Sold
		const itemsSold = validOrders.reduce((sum, o) => sum + o.items.reduce((itemSum, item) => itemSum + item.quantity, 0), 0);

		// Average Order Value
		const completedAndPreparingCount = validOrders.filter(o => o.status === 'Completed' || o.status === 'Preparing').length;
		const avgOrderVal = completedAndPreparingCount > 0 ? revenue / completedAndPreparingCount : 0;

		// Update DOM elements
		updateVal('revenue-val', `₱${revenue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
		updateVal('active-orders-val', activeCount.toString());
		updateVal('avg-order-val', `₱${avgOrderVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
		updateVal('items-sold-val', itemsSold.toString());

		// Optional: Trend badges calculation simulated based on order count
		updateTrendBadge('revenue-trend', revenue > 5000 ? '+14.2%' : '+0%', revenue > 5000);
		updateTrendBadge('active-trend', activeCount > 2 ? '+25%' : '+0%', activeCount > 2);
		updateTrendBadge('avg-trend', avgOrderVal > 300 ? '+4.8%' : '+0%', avgOrderVal > 300);
		updateTrendBadge('items-trend', itemsSold > 5 ? '+18%' : '+0%', itemsSold > 5);
	}

	// Helper: return active orders excluding placeholder customer rows
	function getActiveOrders() {
		return orders.filter(o => (o.status === 'Pending' || o.status === 'Preparing') && ((o.customer || '').toString().trim() !== 'Pending Customer Details' && (o.customer || '').toString().trim() !== '' && !!o.deliveryDateTime));
	}

	function updateVal(id: string, value: string) {
		const el = document.getElementById(id);
		if (el) el.textContent = value;
	}

	function updateTrendBadge(id: string, text: string, isPositive: boolean) {
		const badge = document.getElementById(id);
		if (badge) {
			const textEl = badge.querySelector('.trend-text');
			if (textEl) textEl.textContent = text;
			
			badge.className = `trend-badge ${isPositive ? 'trend-up' : 'trend-down'}`;
			const svg = badge.querySelector('.trend-icon');
			if (svg) {
				svg.innerHTML = isPositive 
					? `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 5v14"/></svg>`
					: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>`;
			}
		}
	}

	// 2. Best Sellers Detection System
	function calculateBestSellers() {
		const listContainer = document.getElementById('best-sellers-list');
		if (!listContainer) return;

		// Filter out cancelled orders for analytics
		const activeSales = orders.filter(o => o.status !== 'Cancelled');

		const categories = [
			{ label: 'Whole Lechon' },
			{ label: 'Lechon Belly' },
			{ label: 'Lechon Packages' },
			{ label: 'Lechon Belly Packages' },
			{ label: 'Food Trays (Pork)' },
			{ label: 'Food Trays (Chicken)' },
			{ label: 'Food Trays (Seafood)' },
			{ label: 'Combo Meals' }
		];

		const categoryAggregation: { [catName: string]: { [itemName: string]: { quantity: number; revenue: number } } } = {};
		categories.forEach(cat => {
			categoryAggregation[cat.label] = {};
		});

		activeSales.forEach(order => {
			order.items.forEach(item => {
				if (item.price > 0) {
					const cat = getItemCategory(item.name);
					if (cat && categoryAggregation[cat]) {
						let name = normalizeItemName(item.name);
						if (name === '1 Whole Lechon Baboy') {
							if (item.price === 15999) {
								name = 'Set A Lechon Package';
							} else if (item.price === 18675) {
								name = 'Set B Lechon Package';
							} else if (item.price === 19999) {
								name = 'Set C Lechon Package';
							}
						}
						if (!categoryAggregation[cat][name]) {
							categoryAggregation[cat][name] = { quantity: 0, revenue: 0 };
						}
						categoryAggregation[cat][name].quantity += item.quantity;
						categoryAggregation[cat][name].revenue += item.total;
					}
				}
			});
		});

		const categoryBestSellers = categories.map(cat => {
			const items = categoryAggregation[cat.label];
			const sortedItems = Object.keys(items).map(name => ({
				name,
				quantity: items[name].quantity,
				revenue: items[name].revenue
			})).sort((a, b) => b.quantity - a.quantity);
			
			const topSeller = sortedItems[0] || null;
			return {
				categoryLabel: cat.label,
				bestSeller: topSeller
			};
		});

		// Check if we have any sales at all
		const hasAnySales = categoryBestSellers.some(c => c.bestSeller !== null);

		if (!hasAnySales) {
			listContainer.innerHTML = `
				<div class="empty-state">
					<div class="empty-state-icon">🍖</div>
					<p class="empty-state-title">No data yet</p>
					<p class="empty-state-sub">Best sellers will appear here once orders are recorded.</p>
				</div>
			`;
			return;
		}

		const formatCompactRevenue = (val: number) => {
			if (val >= 1000000) {
				return (val / 1000000).toFixed(1).replace('.0', '') + 'M';
			}
			if (val >= 1000) {
				return (val / 1000).toFixed(1).replace('.0', '') + 'k';
			}
			return val.toString();
		};

		listContainer.innerHTML = categoryBestSellers.map(cat => {
			if (!cat.bestSeller) {
				return `
					<div class="category-seller-card" style="opacity: 0.5">
						<div class="category-header">
							<span class="category-label" title="${cat.categoryLabel}">${cat.categoryLabel}</span>
						</div>
						<div class="seller-name" style="color:var(--text-muted); font-size:0.75rem; font-style:italic;">No sales</div>
						<div class="seller-details">
							<span class="seller-qty">-</span>
							<span class="seller-revenue">-</span>
						</div>
					</div>
				`;
			}
			
			return `
				<div class="category-seller-card">
					<div class="category-header">
						<span class="category-label" title="${cat.categoryLabel}">${cat.categoryLabel}</span>
					</div>
					<div class="seller-name" title="${cat.bestSeller.name}">${cat.bestSeller.name}</div>
					<div class="seller-details">
						<span class="seller-qty">${cat.bestSeller.quantity} sold</span>
						<span class="seller-revenue">₱${formatCompactRevenue(cat.bestSeller.revenue)}</span>
					</div>
				</div>
			`;
		}).join('');
	}

	// 3. Render Orders Table (dashboard preview)
	function renderOrdersTable() {
		const tableBody = document.getElementById('order-table-body');
		const emptyState = document.getElementById('table-empty-state');
		if (!tableBody || !emptyState) return;

		// Filter orders
		let filteredOrders = orders;

		// 1. Status Filter
		if (currentFilter !== 'All') {
			if (currentFilter === 'PendingCustomer') {
				// show orders that still have placeholder customer details or no delivery details
				filteredOrders = filteredOrders.filter(o => ((o.customer || '').trim() === 'Pending Customer Details' || (o.customer || '').trim() === '' || !o.deliveryDateTime) && o.status !== 'Completed' && o.status !== 'Cancelled');
			} else if (currentFilter === 'Pending') {
				// Pending tab should only show pending orders that already have customer details and delivery details
				filteredOrders = filteredOrders.filter(o => o.status === 'Pending' && ((o.customer || '').trim() !== 'Pending Customer Details' && (o.customer || '').trim() !== '' && !!o.deliveryDateTime));
			} else {
				filteredOrders = filteredOrders.filter(o => o.status === currentFilter);
			}
		}

		// 2. Search query filter
		const isSearching = searchQuery.trim() !== '';
		if (isSearching) {
			const query = searchQuery.toLowerCase().trim();
			filteredOrders = filteredOrders.filter(o => {
				try {
					const idMatch = (o.id || '').toString().toLowerCase().includes(query);
					const custMatch = ((o.customer || '')).toString().toLowerCase().includes(query);
					const itemsMatch = Array.isArray(o.items) && o.items.some(item => ((item.name || '')).toString().toLowerCase().includes(query));
					return idMatch || custMatch || itemsMatch;
				} catch (e) {
					console.error('Search filter error for order', o && o.id, e);
					return false;
				}
			});
		}

		// 3. Sort: upcoming (future delivery) first by soonest, then past orders newest-first
		const now = new Date();
		const upcoming = filteredOrders
			.filter(o => {
				const dt = new Date((o.deliveryDateTime || o.date).replace(' ', 'T'));
				return !isNaN(dt.getTime()) && dt > now;
			})
			.sort((a, b) => {
				const da = new Date((a.deliveryDateTime || a.date).replace(' ', 'T')).getTime();
				const db = new Date((b.deliveryDateTime || b.date).replace(' ', 'T')).getTime();
				return da - db; // soonest first
			});

		const past = filteredOrders
			.filter(o => {
				const dt = new Date((o.deliveryDateTime || o.date).replace(' ', 'T'));
				return isNaN(dt.getTime()) || dt <= now;
			})
			.sort((a, b) => {
				const da = new Date((a.deliveryDateTime || a.date).replace(' ', 'T')).getTime();
				const db = new Date((b.deliveryDateTime || b.date).replace(' ', 'T')).getTime();
				return db - da; // newest first
			});

		const sorted = [...upcoming, ...past];

		// 4. Limit to 5 rows in default (no search, no active status filter)
		const PREVIEW_LIMIT = 5;
		const isLimited = !isSearching && currentFilter === 'All' && sorted.length > PREVIEW_LIMIT;
		const displayed = isLimited ? sorted.slice(0, PREVIEW_LIMIT) : sorted;

		// Show/hide empty state
		try {
			if (displayed.length === 0) {
				tableBody.innerHTML = '';
				emptyState.style.display = 'flex';
				return;
			} else {
				emptyState.style.display = 'none';
			}
		} catch (err) {
			console.error('Error rendering orders table empty state:', err);
		}

		// Render rows
		tableBody.innerHTML = displayed.map(order => {
			// owner note for pending-customer orders (from DB `note` field)
			let noteHtml = '';
			try {
				const note = (order.note || '').toString();
				if (note && (order.customer === 'Pending Customer Details' || (order.customer || '').trim() === '')) {
					noteHtml = `<div class="owner-note" style="font-size:0.75rem;color:var(--text-secondary);margin-top:4px;">FB: ${escapeHtml(note)}</div>`;
				}
			} catch (e) { }
			const statusClass = `badge-${order.status.toLowerCase()}`;
			const isUpcoming = upcoming.includes(order);

			return `
				<tr data-order-id="${order.id}"${isUpcoming ? ' class="row-upcoming"' : ''}>
					<td>
						<button class="action-btn btn-view-details" data-id="${order.id}" title="View Details">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0z"/><circle cx="12" cy="12" r="3"/></svg>
						</button>
					</td>
					<td class="order-id-cell">#${order.id.replace('ORD-', '')}</td>
					<td class="customer-cell">
						<div class="customer-cell-inner">
							<span class="customer-name">${(order.customer && order.customer !== 'Pending Customer Details') ? escapeHtml(order.customer) : '<span class="text-muted">Pending Customer Details</span>'}</span>
							${(order.customer === 'Pending Customer Details' || !order.customer || !order.deliveryDateTime) ? '<span class="awaiting-badge">Awaiting customer details</span>' : ''}
						</div>
						${(order.contact && order.contact.trim()) ? `<div class="customer-contact" style="font-size:0.75rem;color:var(--text-muted);margin-top:2px;">${escapeHtml(order.contact)}</div>` : ''}
						${noteHtml}
					</td>
					<td class="date-cell">${order.deliveryDateTime ? formatDateTime12h(order.deliveryDateTime) : '<span class="text-muted">Pending Customer Input</span>'}</td>
					<td><span class="status-badge ${statusClass}">${order.status}</span></td>
				</tr>
			`;
		}).join('');

		// Re-bind click event listeners to table action buttons
		bindTableActionButtons();
	}

	// 4. Counts in Tabs
	function updateTabCounts() {
		const countAll = document.getElementById('hcount-all');
		const countPending = document.getElementById('hcount-pending');
		const countPendingCustomer = document.getElementById('hcount-pending-customer');
		const countPreparing = document.getElementById('hcount-preparing');
		const countCompleted = document.getElementById('hcount-completed');
		const countCancelled = document.getElementById('hcount-cancelled');

		if (countAll) countAll.textContent = orders.length.toString();
		if (countPending) countPending.textContent = orders.filter(o => o.status === 'Pending' && ((o.customer || '').trim() !== 'Pending Customer Details' && (o.customer || '').trim() !== '' && !!o.deliveryDateTime)).length.toString();
		if (countPendingCustomer) countPendingCustomer.textContent = orders.filter(o => ((o.customer || '').trim() === 'Pending Customer Details' || (o.customer || '').trim() === '' || !o.deliveryDateTime) && o.status !== 'Completed' && o.status !== 'Cancelled').length.toString();
		if (countPreparing) countPreparing.textContent = orders.filter(o => o.status === 'Preparing').length.toString();
		if (countCompleted) countCompleted.textContent = orders.filter(o => o.status === 'Completed').length.toString();
		if (countCancelled) countCancelled.textContent = orders.filter(o => o.status === 'Cancelled').length.toString();

		// Dashboard OrderTable counts (IDs used in the dashboard component)
		const d_countAll = document.getElementById('count-all');
		const d_countPending = document.getElementById('count-pending');
		const d_countPreparing = document.getElementById('count-preparing');
		const d_countCompleted = document.getElementById('count-completed');
		const d_countCancelled = document.getElementById('count-cancelled');

		if (d_countAll) d_countAll.textContent = orders.length.toString();
		if (d_countPending) d_countPending.textContent = orders.filter(o => o.status === 'Pending' && ((o.customer || '').trim() !== 'Pending Customer Details' && (o.customer || '').trim() !== '' && !!o.deliveryDateTime)).length.toString();
		if (d_countPreparing) d_countPreparing.textContent = orders.filter(o => o.status === 'Preparing').length.toString();
		if (d_countCompleted) d_countCompleted.textContent = orders.filter(o => o.status === 'Completed').length.toString();
		if (d_countCancelled) d_countCancelled.textContent = orders.filter(o => o.status === 'Cancelled').length.toString();
	}

	// 5. Actions / Event Listeners
	function setupEventListeners() {
		// Modal Toggle
		const openBtn = document.getElementById('open-order-modal-btn');
		const closeBtn = document.getElementById('close-order-modal-btn');
		const cancelBtn = document.getElementById('cancel-order-btn');
		const overlay = document.getElementById('order-modal-overlay');

		const openModal = () => {
			overlay?.classList.add('active');
			populatePastCustomersDatalists();
		};
		const closeModal = () => {
			overlay?.classList.remove('active');
			resetForm();
		};

		openBtn?.addEventListener('click', openModal);
		closeBtn?.addEventListener('click', closeModal);
		cancelBtn?.addEventListener('click', closeModal);
		overlay?.addEventListener('click', (e) => {
			if (e.target === overlay) closeModal();
		});

		// Search Input
		const searchInput = document.getElementById('order-search');
		searchInput?.addEventListener('input', (e) => {
			searchQuery = (e.target as HTMLInputElement).value;
			renderOrdersTable();
		});

		// Tab view-all button
		const tabViewAllBtn = document.getElementById('tab-view-all-btn');
		if (tabViewAllBtn && !tabViewAllBtn.dataset.bound) {
			tabViewAllBtn.dataset.bound = '1';
			tabViewAllBtn.addEventListener('click', () => navigateTo('order-history'));
		}

		// Filter Tabs
		const tabContainer = document.getElementById('order-status-tabs');
		const tabs = tabContainer?.querySelectorAll('.filter-tab');
		tabs?.forEach(tab => {
			tab.addEventListener('click', () => {
				tabs.forEach(t => t.classList.remove('active'));
				tab.classList.add('active');
				currentFilter = tab.getAttribute('data-status') || 'All';
				renderOrdersTable();
			});
		});

		// Link Modal Toggle Handlers
		const linkModalOverlay = document.getElementById('link-modal-overlay');
		const closeLinkModalBtn = document.getElementById('close-link-modal-btn');
		const closeLinkModalActionBtn = document.getElementById('close-link-modal-action-btn');
		
		const closeLinkModal = () => {
			linkModalOverlay?.classList.remove('active');
		};
		closeLinkModalBtn?.addEventListener('click', closeLinkModal);
		closeLinkModalActionBtn?.addEventListener('click', closeLinkModal);
		linkModalOverlay?.addEventListener('click', (e) => {
			if (e.target === linkModalOverlay) closeLinkModal();
		});

		// Details Modal Toggle Handlers
		const detailsModalOverlay = document.getElementById('details-modal-overlay');
		const closeDetailsModalBtn = document.getElementById('close-details-modal-btn');
		
		const closeDetailsModal = () => {
			detailsModalOverlay?.classList.remove('active');
		};
		closeDetailsModalBtn?.addEventListener('click', closeDetailsModal);
		detailsModalOverlay?.addEventListener('click', (e) => {
			if (e.target === detailsModalOverlay) closeDetailsModal();
		});

		// Copy link button handler
		const copyShareableLinkBtn = document.getElementById('copy-shareable-link-btn');
		const shareableLinkInput = document.getElementById('shareable-link-input') as HTMLInputElement;
		copyShareableLinkBtn?.addEventListener('click', () => {
			if (shareableLinkInput && shareableLinkInput.value) {
				navigator.clipboard.writeText(shareableLinkInput.value).then(() => {
					showToast('Shareable link copied to clipboard!');
					const oldText = copyShareableLinkBtn.textContent;
					copyShareableLinkBtn.textContent = 'Copied!';
					// persist copied state for this order and update table button if present
					try {
						const u = new URL(shareableLinkInput.value);
						const id = u.searchParams.get('id');
						if (id) {
							localStorage.setItem('copied_link_' + id, '1');
							const tableBtn = document.querySelector('.btn-get-link[data-id="' + id + '"]') as HTMLButtonElement;
							if (tableBtn) {
								const old = tableBtn.innerHTML;
								tableBtn.classList.add('copied');
								tableBtn.innerHTML = `\n\t\t\t\t<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>\n\t\t\t\t<span>Copied!</span>\n\t\t\t`;
								setTimeout(() => {
									tableBtn.classList.remove('copied');
									tableBtn.innerHTML = old;
								}, 2000);
							}
						}
					} catch (e) {}
					setTimeout(() => {
						copyShareableLinkBtn.textContent = oldText;
					}, 2000);
				});
			}
		});
	}

	function bindTableActionButtons() {
		// View Details Button
		document.querySelectorAll('.btn-view-details').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (id) {
					openDetailsModal(id);
				}
			});
		});

		// Table Copy Link Button (same behavior as copy-slip)
		document.querySelectorAll('.btn-get-link').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (!id) return;
				// Embed current admin settings into the shareable link so the customer view matches
				const sig = getOrderSignature(id);
				const settingsParam = getSettingsParam();
				const uniqueLink = window.location.origin + '/order?id=' + id + '&t=' + sig + settingsParam;
				navigator.clipboard.writeText(uniqueLink).then(() => {
					const target = e.currentTarget as HTMLButtonElement;
					target.classList.add('copied');
					const oldHTML = target.innerHTML;
					target.innerHTML = `
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
						<span>Copied!</span>
					`;
					try { localStorage.setItem('copied_link_' + id, '1'); } catch (e) {}
					showToast('Customer share link copied to clipboard!');
					setTimeout(() => {
						target.classList.remove('copied');
						target.innerHTML = oldHTML;
					}, 2000);
				}).catch(err => {
					console.error('Could not copy link to clipboard: ', err);
				});
			});
		});
	}

	let currentEditingOrderId: string | null = null;
	let activeEditSection: 'items' | 'customer' | 'payment' | null = null;
	let editItemsStaged: OrderItem[] = [];

	function openDetailsModal(id: string) {
		currentEditingOrderId = id;
		activeEditSection = null;
		editItemsStaged = [];
		const detailsModalOverlay = document.getElementById('details-modal-overlay');
		detailsModalOverlay?.classList.add('active');
		renderDetailsModalContent();
	}

	function renderDetailsModalContent() {
		const id = currentEditingOrderId;
		if (!id) return;
		const order = orders.find(o => o.id === id);
		if (!order) return;

		const detailsTitle = document.getElementById('details-title');
		if (detailsTitle) detailsTitle.textContent = `Order #${id.replace('ORD-', '')}`;

		const existingOwnerNote = (() => { try { const o = orders.find(x => x.id === id); return (o && o.note) ? o.note : ''; } catch (e) { return ''; } })();

		// 1. ITEMS BREAKDOWN SECTION
		let itemsHTML = '';
		if (activeEditSection === 'items') {
			itemsHTML = `
				<form id="edit-items-form" style="display: flex; flex-direction: column; gap: 12px; margin-top: 4px;">
					<div id="edit-items-list-container" style="display: flex; flex-direction: column; gap: 10px; max-height: 250px; overflow-y: auto; padding-right: 4px;">
						${editItemsStaged.map((it, idx) => `
							<div class="edit-item-row" data-idx="${idx}" style="display: flex; flex-direction: column; gap: 6px; padding: 10px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 8px;">
								<div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
