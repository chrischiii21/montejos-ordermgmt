	function isPackageOrTrayOrLechon(name: string): boolean {
		const n = name.toLowerCase();
		
		// 1. Packages & Combos
		if (
			n.includes('package') || 
			n.includes('set ') || 
			n.includes('combo') || 
			n.includes('meal') || 
			n.includes('bilao') || 
			n.startsWith('p1') || 
			n.startsWith('p2') || 
			n.startsWith('p3') || 
			n.startsWith('p4') || 
			n.startsWith('p5') || 
			n.startsWith('p6') ||
			n.includes('seapork') ||
			n.includes('all-in-one') ||
			n.includes('bam-i + lumpia')
		) {
			return true;
		}
		
		// 2. Trays
		if (n.includes('tray')) {
			return true;
		}
		
		// 3. Whole Lechon or Lechon Belly
		if (
			n.includes('whole lechon') || 
			n.includes('lechon belly') || 
			n.includes('lechon baboy') ||
			n.includes('family lechon') ||
			n.includes('barkada lechon') ||
			n.includes('jumbo lechon') ||
			n.includes('fiesta lechon') ||
			n.includes('grande lechon')
		) {
			return true;
		}
		
		return false;
	}

	function normalizeItemName(name: string): string {
		let n = name.trim();
		// Replace multiple spaces
		n = n.replace(/\s+/g, ' ');
		// Convert "Kilos" to "kilos", etc.
		n = n.replace(/\bKilos\b/gi, 'kilos');
		n = n.replace(/\bKls\b/gi, 'kilos');
		n = n.replace(/\bKilo\b/gi, 'kilo');
		
		// Normalize casing of words
		n = n.split(' ').map(w => {
			const lower = w.toLowerCase();
			if (lower === 'kilos' || lower === 'kilo') {
				return 'kilos'; // unify to "kilos"
			}
			return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase();
		}).join(' ');
		
		// Fix minor differences like "Lechonbelly" to "Lechon Belly"
		n = n.replace(/Lechonbelly/gi, 'Lechon Belly');
		n = n.replace(/Lechon Belly (\d+) kilos/gi, 'Lechon Belly ($1 kilos)');
		n = n.replace(/Lechon Belly (\d+) Kilos/gi, 'Lechon Belly ($1 kilos)');
		
		return n;
	}

	function getItemCategory(name: string): string | null {
		const n = name.toLowerCase();
		
		// 1. Lechon Packages
		if (n.includes('1 whole lechon baboy') || (n.includes('set ') && n.includes('package'))) {
			return 'Lechon Packages';
		}
		
		// 2. Lechon Belly Packages
		if (
			(n.startsWith('p1') || n.startsWith('p2') || n.startsWith('p3') || n.startsWith('p4') || n.startsWith('p5') || n.startsWith('p6')) && 
			(n.includes('package') || n.includes('bilao'))
		) {
			return 'Lechon Belly Packages';
		}
		
		// 3. Combo Meals
		if (
			n.includes('seapork') || 
			n.includes('chixseapork') || 
			n.includes('bam-i + lumpia') || 
			n.includes('all-in-one') || 
			n.includes('family meal')
		) {
			return 'Combo Meals';
		}

		// 4. Whole Lechon alone
		if (
			n.includes('whole lechon') || 
			n.includes('lechon baboy') ||
			n.includes('family lechon') ||
			n.includes('barkada lechon') ||
			n.includes('jumbo lechon') ||
			n.includes('fiesta lechon') ||
			n.includes('grande lechon') ||
			n.includes('el\' grande lechon')
		) {
			return 'Whole Lechon';
		}
		
		// 5. Lechon Belly alone
		if (n.includes('lechon belly')) {
			return 'Lechon Belly';
		}
		
		// 6. Food Trays
		// A. Chicken
		if (
			n.includes('chicken') || 
			n.includes('cordon') || 
			n.includes('teriyaki') || 
			n.includes('buffalo') || 
			n.includes('adobo') || 
			n.includes('ala king')
		) {
			return 'Food Trays (Chicken)';
		}
		
		// B. Seafood
		if (
			n.includes('shrimp') || 
			n.includes('calamares') || 
			n.includes('tempura') || 
			n.includes('escabeche') || 
			n.includes('fish fillet')
		) {
			return 'Food Trays (Seafood)';
		}
		
		// C. Pork
		if (
			n.includes('lumpia') || 
			n.includes('shanghai') || 
			n.includes('pork chop') || 
			n.includes('tonkatsu') || 
			n.includes('menudo') || 
			n.includes('sweet & sour pork') ||
			n.includes('sweet and sour pork')
		) {
			return 'Food Trays (Pork)';
		}
		
		// D. Pasta/Noodles
		if (n.includes('bam-i') || n.includes('bam-e') || n.includes('spaghetti') || n.includes('carbonara')) {
			return 'Food Trays (Noodles/Pasta)';
		}
		
		// E. Veggie/Dessert
		if (
			n.includes('salad') || 
			n.includes('pandan') || 
			n.includes('float') || 
			n.includes('maja') || 
			n.includes('jelly') || 
			n.includes('fruta') || 
			n.includes('chopseuy')
		) {
			return 'Food Trays (Veggie/Desserts)';
		}
		
		return null;
	}

	function formatDateTime12h(dateTimeStr: string): string {
		if (!dateTimeStr) return '';
		const d = new Date(dateTimeStr.replace(' ', 'T'));
		if (isNaN(d.getTime())) return dateTimeStr;
		return d.toLocaleString('en-US', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
			hour: 'numeric',
			minute: '2-digit',
			hour12: true
		});
	}

	function escapeHtml(unsafe: string) {
		if (!unsafe) return '';
		return unsafe
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#039;');
	}

	function formatTime12h(dateTimeStr: string): string {
		if (!dateTimeStr) return '';
		const d = new Date(dateTimeStr.replace(' ', 'T'));
		if (isNaN(d.getTime())) return dateTimeStr;
		return d.toLocaleString('en-US', {
			hour: 'numeric',
			minute: '2-digit',
			hour12: true
		});
	}

