		font-size: 0.8rem;
		color: var(--text-secondary);
	}
	.legend-item strong { color: var(--text-primary); }
	.legend-dot {
		width: 10px;
		height: 10px;
		border-radius: var(--radius);
		flex-shrink: 0;
	}

	/* === Analytics: top items === */
	.analytics-top-item {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 0;
		border-bottom: 1px solid var(--border-color);
		font-size: 0.875rem;
	}
	.analytics-top-item:last-child { border-bottom: none; }
	.ati-rank { font-weight: 800; color: var(--accent-primary); min-width: 28px; }
	.ati-name { flex: 1; color: var(--text-primary); font-weight: 500; }
	.ati-qty { color: var(--text-muted); font-size: 0.78rem; }
	.ati-rev { font-weight: 700; color: var(--text-primary); }

	/* === Order History: injected row content === */
	.history-items-list {
		display: flex;
		flex-direction: column;
		gap: 3px;
		max-width: 200px;
	}
	.history-item-pill {
		font-size: 0.75rem;
		color: var(--text-secondary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* === Live Kitchen: KDS Layout & Header === */
	.kds-top-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 16px 20px;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: var(--radius);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		margin-bottom: 24px;
		flex-wrap: wrap;
		gap: 12px;
	}

	.kds-live-indicator {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.live-pulse {
		width: 8px;
		height: 8px;
		background-color: #10b981;
		border-radius: var(--radius);
		box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
		animation: pulse-green 2s infinite;
	}

	@keyframes pulse-green {
		0% {
			transform: scale(0.95);
			box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
		}
		70% {
			transform: scale(1);
			box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
		}
		100% {
			transform: scale(0.95);
			box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
		}
	}

	.live-label {
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--text-primary);
	}

	.kds-counts {
		display: flex;
		gap: 10px;
	}

	.kitchen-badge {
		padding: 6px 14px;
		border-radius: var(--radius-pill);
		font-size: 0.8rem;
		font-weight: 700;
	}
	.kitchen-badge.badge-pending {
		background: rgba(245, 158, 11, 0.15);
		color: #f59e0b;
		border: 1px solid rgba(245, 158, 11, 0.3);
	}
	.kitchen-badge.badge-preparing {
		background: rgba(214, 54, 31, 0.15);
		color: var(--status-preparing);
		border: 1px solid rgba(214, 54, 31, 0.3);
	}

	/* Customer link progress, next to the awaiting badge */
	:global(.draft-badge) {
		padding: 4px 8px;
		border-radius: var(--radius-pill);
		font-size: 0.7rem;
		font-weight: 800;
		margin-left: 6px;
		display: inline-block;
		color: #2563eb;
		background: rgba(37, 99, 235, 0.08);
		border: 1px solid rgba(37, 99, 235, 0.2);
	}
	:global(.draft-badge.is-filling) { color: var(--status-completed); background: var(--status-completed-light); border-color: rgba(4, 120, 87, 0.25); }

	/* Small awaiting badge for orders missing customer details */
	.awaiting-badge {
		padding: 4px 8px;
		border-radius: var(--radius-pill);
		font-size: 0.7rem;
		font-weight: 800;
		color: #f59e0b;
		background: rgba(245, 158, 11, 0.08);
		border: 1px solid rgba(245, 158, 11, 0.18);
		margin-left: 10px;
		display: inline-block;
	}

	.btn-refresh {
		display: flex;
		align-items: center;
		gap: 6px;
		background: transparent;
		border: 1px solid var(--border-color);
		color: var(--text-secondary);
		padding: 8px 14px;
		border-radius: var(--radius-pill);
		font-family: var(--font-family);
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		transition: var(--transition-smooth);
	}
	.btn-refresh:hover {
		background: rgba(var(--tint-rgb), 0.05);
		color: var(--text-primary);
		border-color: var(--text-secondary);
	}

	.kds-board {
		display: grid;
		grid-template-columns: 1fr;
		gap: 28px;
		align-items: start;
	}

	@media (min-width: 768px) {
		.kds-board {
			grid-template-columns: 1fr 1fr;
		}
	}

	.kds-column {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: var(--radius);
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 20px;
		min-height: 500px;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.kds-col-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 12px;
		border-bottom: 1px solid rgba(var(--hairline-rgb), 0.05);
	}

	.kds-col-header-left {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.kds-col-icon {
		font-size: 1.1rem;
	}

	.kds-col-title {
		font-size: 0.85rem;
		font-weight: 800;
		letter-spacing: 0.05em;
	}

	.kds-col-pending .kds-col-title {
		color: #f59e0b;
	}

	.kds-col-preparing .kds-col-title {
		color: var(--status-preparing);
	}

	.kds-col-count {
		font-size: 0.75rem;
		font-weight: 700;
		padding: 2px 8px;
		border-radius: var(--radius);
	}

	.kds-col-pending .kds-col-count {
		background: rgba(245, 158, 11, 0.15);
		color: #f59e0b;
	}

	.kds-col-preparing .kds-col-count {
		background: rgba(214, 54, 31, 0.15);
		color: var(--status-preparing);
	}

	.kds-col-body {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.kds-col-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		color: var(--text-muted);
		font-size: 0.85rem;
		padding: 60px 20px;
		flex-grow: 1;
	}

	.kds-col-empty svg {
		color: var(--text-muted);
		opacity: 0.4;
	}

	.kds-all-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		padding: 80px 20px;
		text-align: center;
	}

	.kds-all-empty-icon {
		font-size: 3rem;
		filter: drop-shadow(0 0 10px rgba(214, 54, 31, 0.2));
	}

	.kds-all-empty-title {
		font-size: 1.25rem;
		font-weight: 800;
		color: var(--text-primary);
	}

	.kds-all-empty-sub {
		font-size: 0.875rem;
		color: var(--text-muted);
		max-width: 360px;
	}

	/* === Live Kitchen: KDS cards === */
	.kitchen-card {
		background: rgba(var(--tint-rgb), 0.03);
		border: 1px solid rgba(var(--hairline-rgb), 0.08);
		border-left-width: 4px;
		border-radius: var(--radius);
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 16px;
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.kitchen-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0,0,0,0.3);
	}
	.kitchen-card.status-pending { border-left-color: #f59e0b; }
	.kitchen-card.status-preparing { border-left-color: #d6361f; }

	.kcard-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
	}
	.kcard-id {
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--text-primary);
		letter-spacing: -0.02em;
	}
	.kcard-timer {
		font-size: 0.72rem;
		color: var(--text-muted);
		background: var(--bg-well);
		padding: 3px 8px;
		border-radius: var(--radius);
	}
	.kcard-customer {
		font-size: 0.875rem;
		color: var(--text-secondary);
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.kcard-items {
		display: flex;
		flex-direction: column;
		gap: 5px;
		padding: 10px 12px;
		background: var(--bg-well);
		border-radius: var(--radius);
		border: 1px solid var(--border-color);
	}
	.kcard-item {
		font-size: 0.82rem;
		color: var(--text-secondary);
		line-height: 1.4;
	}
	.kcard-item strong {
		color: var(--text-primary);
		font-weight: 700;
	}
	.kcard-actions {
		display: flex;
		gap: 8px;
		margin-top: 2px;
	}
	.kcard-btn {
		flex: 1;
		padding: 9px 8px;
		border-radius: var(--radius-pill);
		font-size: 0.78rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.2s;
		text-align: center;
	}
	.kcard-btn-prepare {
		background: rgba(214, 54, 31,0.12);
		color: var(--status-preparing);
		border: 1px solid rgba(214, 54, 31,0.5) !important;
	}
	.kcard-btn-prepare:hover {
		background: var(--status-preparing);
		color: white;
		border-color: var(--status-preparing) !important;
	}
	.kcard-btn-complete {
		background: rgba(16,185,129,0.12);
		color: #10b981;
		border: 1px solid rgba(16,185,129,0.5) !important;
	}
	.kcard-btn-complete:hover {
		background: #10b981;
		color: white;
		border-color: #10b981 !important;
	}
	.kcard-btn-cancel {
		background: transparent;
		color: #ef4444;
		border: 1px solid rgba(239,68,68,0.4) !important;
	}
	.kcard-btn-cancel:hover {
		background: rgba(239,68,68,0.12);
		border-color: #ef4444 !important;
	}

	/* === Calendar: view details button === */
	.kcard-btn-details {
		background: var(--bg-card-hover);
		border: 1px solid var(--border-color);
		color: var(--text-muted);
		border-radius: var(--radius-pill);
		width: 28px;
		height: 28px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.2s;
		flex-shrink: 0;
	}
	.kcard-btn-details:hover {
		background: var(--accent-primary-light);
		border-color: var(--border-color-hover);
		color: var(--accent-primary);
	}

	/* ===== CALENDAR VIEW ===== */
	.cal-layout {
		display: grid;
		grid-template-columns: 1fr 340px;
		gap: 24px;
		align-items: start;
	}
	@media (max-width: 900px) { .cal-layout { grid-template-columns: 1fr; } }

	.cal-panel { padding: 24px; }

	/* Header: month nav */
	.cal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 20px;
	}
	.cal-month-label {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-primary);
	}
	.cal-nav-btn {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		color: var(--text-secondary);
		width: 32px; height: 32px;
		border-radius: var(--radius-pill);
		cursor: pointer;
		display: flex; align-items: center; justify-content: center;
		transition: all 0.2s;
	}
	.cal-nav-btn:hover {
		background: var(--accent-primary-light);
		border-color: var(--accent-primary);
		color: var(--accent-primary);
	}

	/* Weekday row */
	.cal-weekdays {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		margin-bottom: 8px;
		gap: 4px;
	}
	.cal-weekdays span {
		text-align: center;
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		padding: 4px 0;
	}

	/* Calendar grid */
	.cal-grid {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 4px;
	}
	.cal-cell {
		position: relative;
		min-height: 60px;
		border-radius: var(--radius);
		padding: 8px 6px 6px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		cursor: pointer;
		border: 1px solid transparent;
		background: transparent;
		transition: background 0.15s, border-color 0.15s;
	}
	.cal-cell-empty { cursor: default; pointer-events: none; }
	.cal-cell:not(.cal-cell-empty):hover {
		background: var(--bg-card);
		border-color: var(--border-color);
	}
	.cal-day-num {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-secondary);
		line-height: 1;
	}
	.cal-cell.cal-today { border-color: var(--accent-primary); }
	.cal-cell.cal-today .cal-day-num { color: var(--accent-primary); font-weight: 800; }
	.cal-cell.cal-selected { background: var(--accent-gradient); border-color: transparent; box-shadow: var(--glow-effect); }
	.cal-cell.cal-selected .cal-day-num { color: #fff; }
	.cal-cell.cal-selected .cal-order-badge { background: rgba(255,255,255,0.25); color: #fff; }

	/* Order count badge on a day cell */
	.cal-order-badge {
		font-size: 0.62rem;
		font-weight: 800;
		background: var(--accent-primary);
		color: #fff;
		padding: 1px 5px;
		border-radius: var(--radius-pill);
		line-height: 1.5;
		min-width: 18px;
		text-align: center;
	}
	.cal-cell.cal-has-orders:not(.cal-selected) .cal-order-badge {
		background: var(--accent-primary);
		color: #fff;
	}

	/* Day detail panel */
	.cal-day-panel {
		padding: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		max-height: calc(100vh - 180px);
	}
	.cal-day-header {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 18px 20px;
		border-bottom: 1px solid var(--border-color);
		color: var(--text-primary);
		flex-shrink: 0;
	}
	.cal-day-header svg { color: var(--accent-primary); flex-shrink: 0; }
	.cal-day-title { font-size: 0.9rem; font-weight: 700; color: var(--text-primary); }
	.cal-day-count { font-size: 0.72rem; color: var(--text-muted); margin-top: 2px; }

	#cal-day-orders {
		overflow-y: auto;
		flex: 1;
		padding: 12px 16px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.cal-no-orders {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 40px 20px;
		color: var(--text-muted);
		text-align: center;
		font-size: 0.85rem;
	}

	/* Order card inside the day panel */
	.cal-order-card {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: var(--radius);
		padding: 12px 14px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		transition: border-color 0.2s;
	}
	.cal-order-card:hover { border-color: var(--border-color-hover); }
	.cal-order-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 8px;
	}
	.cal-order-who { min-width: 0; }
	.cal-order-customer { font-size: 0.85rem; font-weight: 700; color: var(--text-primary); overflow-wrap: anywhere; }
	.cal-order-id { font-size: 0.7rem; color: var(--text-muted); margin-top: 2px; font-family: monospace; overflow-wrap: anywhere; }
	.cal-order-items {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
	}
	.cal-order-item-pill {
		font-size: 0.7rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		color: var(--text-secondary);
		padding: 2px 8px;
		border-radius: var(--radius-pill);
	}
	.cal-order-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
	}
	.cal-order-total { font-size: 0.88rem; font-weight: 800; color: var(--accent-primary); }
	.cal-order-time { font-size: 0.7rem; color: var(--text-muted); }

	/* Clickable order card → opens the Order Details modal */
	.cal-order-card[data-id] { cursor: pointer; }
	.cal-order-card[data-id]:hover,
	.cal-order-card[data-id]:focus-visible {
		border-color: var(--accent-primary);
		background: var(--bg-card-hover);
		outline: none;
	}
	.cal-order-view {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 5px;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		color: var(--text-muted);
		border-top: 1px dashed var(--border-color);
		padding-top: 8px;
		transition: color 0.2s;
	}
	.cal-order-card[data-id]:hover .cal-order-view,
	.cal-order-card[data-id]:focus-visible .cal-order-view { color: var(--accent-primary); }

	/* === Order History: phone card list (hidden until the table is dropped) === */
	.history-cards {
		display: none;
		flex-direction: column;
		gap: 12px;
		padding: 12px;
	}
	.history-card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 14px;
		border-radius: var(--radius);
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
	}
	.history-card.is-upcoming { border-color: var(--accent-primary); background: var(--accent-primary-light); }

	.hcard-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
	.hcard-id {
		font-size: 1rem; font-weight: 800;
		color: var(--accent-primary);
		letter-spacing: -0.01em;
		font-variant-numeric: tabular-nums;
	}

	.hcard-who { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
	.hcard-name { font-size: 0.92rem; font-weight: 700; color: var(--text-primary); overflow-wrap: anywhere; }
	.hcard-name .text-muted { font-weight: 600; color: var(--text-muted); }
	.hcard-contact { font-size: 0.75rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
	.hcard-who .awaiting-badge { align-self: flex-start; margin-left: 0; margin-top: 2px; }

	.hcard-date {
		display: flex; align-items: center; gap: 7px;
		font-size: 0.78rem;
		color: var(--text-secondary);
		padding: 8px 10px;
		border-radius: var(--radius);
		background: var(--bg-card);
		border: 1px solid var(--border-color);
	}
	.hcard-date svg { color: var(--accent-primary); flex-shrink: 0; }

	/* Total / Downpayment / Balance read as one figures strip */
	.hcard-figures {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
		padding-top: 12px;
		border-top: 1px solid var(--border-color);
	}
	.hcard-fig { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
	.hcard-fig-label {
		font-size: 0.6rem; font-weight: 700;
		text-transform: uppercase; letter-spacing: 0.05em;
		color: var(--text-muted);
	}
	.hcard-fig-value {
		font-size: 0.82rem; font-weight: 700;
		color: var(--text-primary);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		overflow-wrap: normal;
	}
	.hcard-fig-value.is-dp { color: var(--status-preparing); }
	.hcard-fig-value.is-balance { color: var(--accent-primary); }
	.hcard-settled { display: block; font-size: 0.62rem; font-weight: 800; color: var(--status-completed); }

	.hcard-btn {
		display: flex; align-items: center; justify-content: center; gap: 7px;
		width: 100%;
		padding: 10px;
		border-radius: var(--radius-pill);
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		color: var(--text-secondary);
		font-family: var(--font-family);
		font-size: 0.78rem; font-weight: 700;
		cursor: pointer;
		transition: var(--transition-smooth);
	}
	.hcard-btn:hover, .hcard-btn:active {
		background: var(--accent-primary-light);
		border-color: var(--accent-primary);
		color: var(--accent-primary);
	}

	/* === Order History Pagination === */
	.history-pagination {
