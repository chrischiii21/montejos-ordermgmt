	// Clipboard Copy Confirmation Slip Helper
	function copyConfirmationSlip(id: string, btn: HTMLButtonElement) {
		const order = orders.find(o => o.id === id);
		if (!order) return;

		const itemsText = order.items.map(it => {
			let text = `${it.quantity}x ${it.name}`;
			if (it.customInclusions && it.customInclusions.length > 0) {
				text += `\n  (Custom Inclusions:\n` + it.customInclusions.map(inc => `   - ${inc}`).join('\n') + `)`;
			}
			return text;
		}).join('\n');
		const subtotal = order.total - (order.deliveryFee || 0);
		const deliveryFee = order.deliveryFee || 0;
		
		const slipText = `C O N F I R M A T I O N   S L I P
Please fill up the following.

Name: ${order.customer}
Fulfillment: ${order.fulfillmentType || 'Customer chooses'}
Exact Address: ${order.address}
Contact Number of the Receiver/s: ${order.contact}
Time & Date: ${order.deliveryDateTime ? formatDateTime12h(order.deliveryDateTime) : 'Pending Customer Input'}
List of Order/s:
${itemsText}

Subtotal: ₱${subtotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
Delivery/Meetup Fee: ₱${deliveryFee.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
TOTAL: ₱${order.total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
DOWNPAYMENT: ₱${order.downpayment.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
BALANCE: ₱${order.balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}${order.status === 'Completed' ? ' (Settled)' : ''}

Note: To confirm your order, we are requesting 50% downpayment of the total bill, then the rest will be paid upon pickup/delivery of orders.

M O D E   O F   P A Y M E N T S

Maribank Details
Christy Montejo
11953471393

Gcash Details
Christy Montejo
09760721404`;

		navigator.clipboard.writeText(slipText).then(() => {
			btn.classList.add('copied');
			const oldHTML = btn.innerHTML;
			btn.innerHTML = `
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
				<span>Copied!</span>
			`;
			showToast('Confirmation slip copied to clipboard!');
			setTimeout(() => {
				btn.classList.remove('copied');
				btn.innerHTML = oldHTML;
			}, 2000);
		}).catch(err => {
			console.error('Could not copy confirmation slip to clipboard: ', err);
		});
	}

