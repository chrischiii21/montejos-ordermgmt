		display: flex;
		flex-direction: column;
		gap: 6px;
		flex-grow: 1;
	}

	.nav-item {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 13px 18px;
		border-radius: var(--radius-pill);
		color: var(--text-secondary);
		text-decoration: none;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		transition: var(--transition-smooth);
	}

	.nav-item svg {
		color: var(--accent-gold);
		transition: var(--transition-smooth);
	}

	.nav-item:hover {
		background: rgba(255, 255, 255, 0.06);
		color: var(--text-primary);
	}

	/* Active item is a tab cut from the page: it paints the page's own fixed background,
	   so its pixels match exactly, and runs flush off the panel's right edge */
	.nav-item.active,
	.nav-item.active::before,
	.nav-item.active::after {
		background-color: var(--bg-primary);
		background-image: var(--page-glow);
		background-attachment: fixed;
	}

	.nav-item.active {
		position: relative;
		color: #4a0d0a;
		margin-right: -24px;
		border-radius: var(--radius-pill) 0 0 var(--radius-pill);
	}

	/* Inverted corners above and below the tab, curving the panel edge into it */
	.nav-item.active::before,
	.nav-item.active::after {
		content: '';
		position: absolute;
		right: 0;
		width: 20px;
		height: 20px;
		pointer-events: none;
	}

	.nav-item.active::before {
		bottom: 100%;
		-webkit-mask: radial-gradient(circle at 0 0, transparent 19.5px, #000 20px);
		mask: radial-gradient(circle at 0 0, transparent 19.5px, #000 20px);
	}

	.nav-item.active::after {
		top: 100%;
		-webkit-mask: radial-gradient(circle at 0 100%, transparent 19.5px, #000 20px);
		mask: radial-gradient(circle at 0 100%, transparent 19.5px, #000 20px);
	}

	.nav-item.active svg {
		color: var(--accent-primary);
	}

	:root[data-theme="dark"] .nav-item.active {
		color: var(--text-primary);
	}

	.nav-divider {
		height: 1px;
		background: var(--border-color);
		margin: 12px 0;
	}

	.sidebar-user {
		display: flex;
		align-items: center;
		gap: 12px;
		border-top: 1px solid var(--border-color);
		padding-top: 20px;
		margin-top: auto;
	}

	.user-avatar {
		width: 38px;
		height: 38px;
		border-radius: var(--radius);
		background: var(--accent-gold);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.85rem;
		font-weight: 700;
		color: #4a0d0a;
		box-shadow: 0 0 10px rgba(214, 54, 31, 0.3);
	}

	.user-info {
		display: flex;
		flex-direction: column;
	}

	.user-name {
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.user-role {
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	/* Main Content Styles */
	.main-content {
		flex-grow: 1;
		padding: 24px 32px;
		display: flex;
		flex-direction: column;
		gap: 24px;
		max-width: 100%;
		overflow-x: hidden;
	}

	@media (min-width: 768px) {
		.main-content {
			padding: 40px 56px;
		}
	}

	@media (min-width: 1024px) {
		.main-content {
			margin-left: 276px;
		}
	}

	/* Header */
	.dashboard-header {
		display: flex;
		flex-direction: column;
		gap: 16px;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 24px;
	}

	@media (min-width: 640px) {
		.dashboard-header {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}
	}

	.date-display {
		font-size: 0.7rem;
		font-weight: 500;
		color: var(--accent-primary);
		text-transform: uppercase;
		letter-spacing: 0.18em;
	}

	.dashboard-header h1 {
		font-family: var(--font-display);
		font-size: 2.4rem;
		font-weight: 600;
		letter-spacing: 0.015em;
		line-height: 1.15;
		margin-top: 2px;
	}

	.btn-primary-dashboard {
		background: var(--accent-gradient);
		border: none;
		color: white;
		font-family: var(--font-family);
		font-weight: 700;
		font-size: 0.875rem;
		padding: 12px 20px;
		border-radius: var(--radius-pill);
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 8px;
		box-shadow: 0 4px 15px rgba(214, 54, 31, 0.3);
		transition: var(--transition-smooth);
	}

	.btn-primary-dashboard:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(214, 54, 31, 0.45), 0 0 15px rgba(214, 54, 31, 0.2);
	}

	.btn-primary-dashboard:active {
		transform: translateY(1px);
	}

	/* Dashboard Main Grid Layout */
	.dashboard-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 32px;
		align-items: start;
	}

	@media (min-width: 1200px) {
		.dashboard-grid {
			grid-template-columns: 8fr 4fr;
		}
	}

	.grid-table-area {
		width: 100%;
		overflow: hidden;
	}

	/* ===== AT A GLANCE (Today / Tomorrow / Balance to collect) ===== */
	.glance-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: 24px;
	}
	@media (min-width: 1200px) {
		.glance-grid { grid-template-columns: 1fr 1fr 1.4fr; }
	}
	.glance-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 4px;
		padding: 20px 22px;
		min-width: 0;
		text-align: left;
		font-family: var(--font-family);
		color: var(--text-primary);
		border: 1px solid var(--border-color);
	}
	button.glance-card { cursor: pointer; transition: var(--transition-smooth); }
	button.glance-card:hover { border-color: var(--border-color-hover); transform: translateY(-2px); }
	button.glance-card.is-selected { border-color: var(--accent-primary); box-shadow: 0 0 0 3px var(--accent-primary-light); }
	.glance-label {
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--accent-primary);
	}
	.glance-date { font-size: 0.8rem; color: var(--text-muted); }
	.glance-big { font-size: 1.7rem; font-weight: 800; line-height: 1.2; margin-top: 4px; }
	.glance-split { font-size: 0.82rem; color: var(--text-secondary); }
	.glance-next {
		margin-top: 8px;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--text-primary);
		overflow-wrap: anywhere;
	}
	.glance-next:empty { display: none; }
	.glance-collect-list { list-style: none; margin: 8px 0 0; padding: 0; width: 100%; display: flex; flex-direction: column; gap: 4px; }
	.glance-collect-list:empty { display: none; }
	:global(.glance-collect-row) {
		width: 100%;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 6px 8px;
		margin: 0 -8px;
		border: none;
		border-radius: var(--radius);
		background: none;
		font-family: var(--font-family);
		font-size: 0.82rem;
		color: var(--text-secondary);
		text-align: left;
		cursor: pointer;
	}
	:global(.glance-collect-row:hover) { background: var(--accent-primary-light); }
	:global(.glance-collect-name) { flex: 1; min-width: 0; font-weight: 600; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	:global(.glance-collect-when) { flex-shrink: 0; color: var(--text-muted); }
	:global(.glance-collect-amt) { flex-shrink: 0; font-weight: 800; color: var(--status-pending); }
	:global(.glance-collect-more) { font-size: 0.78rem; color: var(--text-muted); padding-top: 2px; }

	/* Amount column in the dashboard order list */
	:global(.amount-cell) { white-space: nowrap; }
	:global(.amt-total) { font-weight: 700; color: var(--text-primary); }
	:global(.amt-sub) { font-size: 0.75rem; color: var(--text-muted); margin-top: 2px; }
	:global(.amt-sub .is-due) { color: var(--status-pending); font-weight: 700; }
	:global(.amt-sub .is-paid) { color: var(--status-completed); font-weight: 700; }
	:global(.unpaid-dp-badge) {
		display: inline-block;
		margin-top: 4px;
		font-size: 0.68rem;
		font-weight: 800;
		padding: 2px 8px;
		border-radius: var(--radius-pill);
		background: var(--status-pending-light);
		color: var(--status-pending);
	}

	.grid-analytics-area {
		width: 100%;
	}

	/* Link Modal Centered Popup Styles */
	#link-modal-overlay.modal-overlay,
	#details-modal-overlay.modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(10, 10, 10, 0.85);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		z-index: 1000;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.3s ease, visibility 0.3s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	#link-modal-overlay.modal-overlay.active,
	#details-modal-overlay.modal-overlay.active {
		opacity: 1;
		visibility: visible;
	}

	#link-modal-overlay .modal-container,
	#details-modal-overlay .modal-container {
		width: 90%;
		max-width: 480px;
		background: var(--bg-modal);
		border: 1px solid var(--border-color);
		border-radius: var(--radius);
		padding: 24px;
		box-shadow: var(--card-shadow), var(--glow-effect);
		transform: scale(0.9);
		transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
		display: flex;
		flex-direction: column;
		gap: 0;
		color: var(--text-primary);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	#details-modal-overlay .modal-container {
		max-width: min(1240px, 94vw);
		max-height: 92vh;
	}

	#link-modal-overlay.modal-overlay.active .modal-container,
	#details-modal-overlay.modal-overlay.active .modal-container {
		transform: scale(1);
	}

	#link-modal-overlay .modal-header,
	#details-modal-overlay .modal-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 16px;
		margin-bottom: 16px;
	}

	#link-modal-overlay .modal-title-group,
	#details-modal-overlay .modal-title-group {
		text-align: left;
	}

	#link-modal-overlay .modal-title-group h3,
	#details-modal-overlay .modal-title-group h3 {
		font-size: 1.25rem;
		font-weight: 800;
		margin: 0;
		color: var(--text-primary);
		line-height: 1.2;
	}

	#link-modal-overlay .modal-title-group .modal-subtitle,
	#details-modal-overlay .modal-title-group .modal-subtitle {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: 700;
		color: var(--accent-primary);
		display: block;
		margin-bottom: 4px;
	}

	#link-modal-overlay .close-btn,
	#details-modal-overlay .close-btn {
		background: transparent;
		border: none;
		color: var(--text-secondary);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: var(--radius-pill);
		border: 1px solid var(--border-color);
		transition: var(--transition-smooth);
	}

	#link-modal-overlay .close-btn:hover,
	#details-modal-overlay .close-btn:hover {
		color: var(--text-primary);
		background: rgba(var(--tint-rgb), 0.05);
		border-color: rgba(var(--hairline-rgb), 0.2);
	}

	#link-modal-overlay .modal-body {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 0;
	}

	#details-modal-overlay .modal-body {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 4px 8px 8px 0;
		overflow-y: auto;
		flex-grow: 1;
	}

	#details-modal-overlay .modal-body::-webkit-scrollbar {
		width: 6px;
	}
	#details-modal-overlay .modal-body::-webkit-scrollbar-track {
		background: rgba(var(--tint-rgb), 0.02);
		border-radius: var(--radius);
	}
	#details-modal-overlay .modal-body::-webkit-scrollbar-thumb {
		background: rgba(var(--tint-rgb), 0.15);
		border-radius: var(--radius);
	}
	#details-modal-overlay .modal-body::-webkit-scrollbar-thumb:hover {
		background: var(--accent-primary);
	}

	#link-modal-overlay p {
		font-size: 0.875rem;
		color: var(--text-secondary);
		line-height: 1.5;
		margin-bottom: 0;
		text-align: left;
	}

	#link-modal-overlay .form-group {
		display: flex;
		flex-direction: column;
		gap: 8px;
		text-align: left;
	}

	#link-modal-overlay label {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--text-secondary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	#link-modal-overlay .input-wrapper {
		display: flex;
		align-items: center;
		background: rgba(var(--tint-rgb), 0.03);
		border: 1px solid var(--border-color);
		border-radius: var(--radius);
		padding: 8px 12px;
		gap: 10px;
		transition: var(--transition-smooth);
	}

	#link-modal-overlay .input-wrapper:focus-within {
		border-color: var(--accent-primary);
		box-shadow: 0 0 10px rgba(214, 54, 31, 0.15);
		background: rgba(var(--tint-rgb), 0.05);
	}

	#link-modal-overlay #shareable-link-input {
		flex: 1;
		background: transparent;
		border: none;
		outline: none;
		color: var(--text-primary);
		font-family: monospace;
		font-size: 0.85rem;
		width: 100%;
		padding: 0;
	}

	#link-modal-overlay .btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 10px 18px;
		border-radius: var(--radius-pill);
		font-family: var(--font-family);
		font-weight: 700;
		font-size: 0.875rem;
		cursor: pointer;
		transition: var(--transition-smooth);
		border: none;
		outline: none;
		text-decoration: none;
		min-height: unset;
	}

	#link-modal-overlay .btn-secondary {
		background: rgba(var(--tint-rgb), 0.04);
		border: 1px solid var(--border-color);
		color: var(--text-primary);
	}

	#link-modal-overlay .btn-secondary:hover {
		background: rgba(var(--tint-rgb), 0.08);
		border-color: var(--text-secondary);
	}

	#link-modal-overlay .btn-primary {
		background: var(--accent-gradient);
		color: white;
		box-shadow: 0 4px 15px rgba(214, 54, 31, 0.35);
	}

	#link-modal-overlay .btn-primary:hover {
		transform: translateY(-1px);
		box-shadow: 0 6px 20px rgba(214, 54, 31, 0.45);
	}


	#link-modal-overlay .form-actions {
		display: flex;
		gap: 12px;
		margin-top: 8px;
	}

	/* ===== VIEW CONTAINERS ===== */
	.view-container { display: flex; flex-direction: column; gap: 32px; animation: fadeSlideIn 0.25s ease; }
	@keyframes fadeSlideIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

	/* Upcoming order row — subtle left accent */
	/* Upcoming orders styled globally in <style is:global> */

	/* ===== ORDER HISTORY ===== */
	.view-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; min-width: 0; }
	.toolbar-left { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; min-width: 0; flex: 1 1 260px; }
	.search-box { display: flex; align-items: center; gap: 8px; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-pill); padding: 8px 14px; flex: 1 1 220px; min-width: 0; max-width: 100%; }
	.search-box svg { color: var(--text-muted); flex-shrink: 0; }
	.search-box input { background: transparent; border: none; outline: none; color: var(--text-primary); font-family: var(--font-family); font-size: 0.875rem; width: 100%; min-width: 0; }
	.date-range-group { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--text-muted); flex-wrap: wrap; min-width: 0; }
	.date-range-group input[type="date"] { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius); padding: 8px 10px; color: var(--text-primary); font-family: var(--font-family); font-size: 0.8rem; outline: none; flex: 1 1 130px; min-width: 0; }
	.btn-export { background: transparent; border: 1px solid var(--border-color); color: var(--text-secondary); padding: 8px 16px; border-radius: var(--radius-pill); font-family: var(--font-family); font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: var(--transition-smooth); }
	.btn-export:hover { background: var(--bg-card-hover); color: var(--text-primary); }
	.history-tabs { display: flex; gap: 4px; flex-wrap: wrap; }

	/* Order history table styles moved to <style is:global> to support dynamic rows. */

	/* ===== ANALYTICS ===== */
	.analytics-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: 24px; }
	.analytic-card { background: rgba(var(--tint-rgb), 0.03); border: 1px solid var(--border-color); border-radius: var(--radius); padding: 20px; display: flex; flex-direction: column; gap: 6px; container-type: inline-size; }
	.analytic-card .a-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
	/* Peso amounts must never wrap mid-number — scale the type down instead */
	.analytic-card .a-value {
		font-size: 1.5rem;
		font-weight: 800;
		color: var(--text-primary);
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
		overflow-wrap: normal;
		white-space: nowrap;
	}
	@container (max-width: 210px) { .analytic-card .a-value { font-size: 1.3rem; } }
	@container (max-width: 175px) { .analytic-card .a-value { font-size: 1.1rem; } }
	.analytic-card .a-sub { font-size: 0.75rem; color: var(--text-muted); }
	.analytics-charts-row { display: grid; grid-template-columns: 1fr 300px; gap: 28px; }
	@media (max-width: 900px) { .analytics-charts-row { grid-template-columns: 1fr; } }
	.chart-card { padding: 24px; min-width: 0; }
	.chart-card-sm { padding: 20px; }
	.chart-label { font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.18em; color: var(--accent-primary); margin-bottom: 16px; }
	.bar-chart-container { display: flex; align-items: flex-end; gap: 12px; height: 160px; padding-top: 8px; overflow-x: auto; }
	.bar-wrap { display: flex; flex-direction: column; align-items: center; gap: 4px; flex-shrink: 0; }
	.bar-fill { width: 36px; border-radius: var(--radius); transition: height 0.4s ease; cursor: pointer; }
	.bar-fill:hover { filter: brightness(1.2); }
	.bar-id { font-size: 0.6rem; color: var(--text-muted); }
	.donut-container { display: flex; justify-content: center; align-items: center; margin: 8px 0; }
	.donut-legend { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
	.legend-item { display: flex; align-items: center; gap: 8px; font-size: 0.78rem; color: var(--text-secondary); }
	.legend-dot { width: 10px; height: 10px; border-radius: var(--radius); flex-shrink: 0; }
	.analytics-top-item { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid rgba(var(--hairline-rgb), 0.04); font-size: 0.85rem; }
	.analytics-top-item:last-child { border-bottom: none; }
	.ati-rank { font-weight: 700; color: var(--accent-primary); min-width: 28px; }
	.ati-name { flex: 1; color: var(--text-primary); }
	.ati-qty { color: var(--text-muted); font-size: 0.78rem; }
	.ati-rev { font-weight: 700; color: var(--text-primary); }

	/* ===== LIVE KITCHEN ===== */
	/* Scoped styles removed. Live Kitchen layouts and styles are fully defined globally under <style is:global> to ensure compatibility with dynamically rendered content. */

	/* ===== SETTINGS ===== */
	/* Two stacked columns on wide screens (Payment + Data | Downpayment + Family link),
	   so neither side leaves a gap. On narrow screens the columns dissolve into one list,
	   with the danger zone moved to the end. */
	.settings-grid {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.settings-col { display: contents; }
	.settings-section-danger { order: 1; }
	@media (min-width: 1100px) {
		.settings-grid {
			display: grid;
			grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
			align-items: start;
		}
		.settings-col { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
		.settings-section-danger { order: 0; }
		.settings-section-full { grid-column: 1 / -1; }
	}

	/* Telegram Alerts */
	.tg-status { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.82rem; color: var(--text-secondary); }
	:global(.tg-chip) {
