		`;

		const modalBody = document.getElementById('details-modal-body');
		if (modalBody) {
			modalBody.innerHTML = `
				<div class="detail-grid" style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; text-align: left; align-items: start;">
