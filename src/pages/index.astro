						<!-- Items breakdown card -->
						<div class="detail-section glass-panel" style="padding: 16px; border-radius: var(--radius); background: rgba(var(--tint-rgb), 0.02); border: 1px solid rgba(var(--hairline-rgb), 0.05);">
							<div class="detail-header-row" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
								<div class="detail-section-title" style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--accent-primary); letter-spacing: 0.05em;">Items Breakdown</div>
								${editItemsBtnHTML}
							</div>
							${itemsHTML}
						</div>
						
						<!-- Payment breakdown card -->
						<div class="detail-section glass-panel" style="padding: 16px; border-radius: var(--radius); background: rgba(var(--tint-rgb), 0.02); border: 1px solid rgba(var(--hairline-rgb), 0.05);">
							<div class="detail-header-row" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
								<div class="detail-section-title" style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--accent-primary); letter-spacing: 0.05em;">Payment Breakdown</div>
								${editPaymentBtnHTML}
							</div>
							${paymentHTML}
						</div>
					</div>
					
					<!-- Right Column: Delivery Info, Status & Manage buttons -->
					<div class="detail-right-column" style="display: flex; flex-direction: column; gap: 20px; min-width: 0;">
						<!-- Customer & Delivery details card -->
						<div class="detail-section glass-panel" style="padding: 16px; border-radius: var(--radius); background: rgba(var(--tint-rgb), 0.02); border: 1px solid rgba(var(--hairline-rgb), 0.05);">
							<div class="detail-header-row" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
								<div class="detail-section-title" style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--accent-primary); letter-spacing: 0.05em;">Delivery & Contact Details</div>
								${editCustomerBtnHTML}
							</div>
							${customerHTML}
						</div>

						<!-- Manage Order card (Moved from bottom to right column) -->
						<div class="detail-section glass-panel" style="padding: 16px; border-radius: var(--radius); background: rgba(var(--tint-rgb), 0.02); border: 1px solid rgba(var(--hairline-rgb), 0.05);">
							<div class="detail-section-title" style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--accent-primary); margin-bottom: 12px; letter-spacing: 0.05em;">Manage Order</div>
							<div class="detail-actions-buttons" style="display: flex; flex-direction: column; gap: 10px; width: 100%;">
								${actionsHTML}
							</div>
						</div>
					</div>
				</div>
			`;
			
			// Rebind listeners
			bindModalActionButtons();
			bindEditSectionListeners();
		}
	}

	function bindEditSectionListeners() {
		const modal = document.getElementById('details-modal-body');
		if (!modal) return;

		// Section Edit buttons click
		modal.querySelectorAll('.btn-edit-section').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const section = (e.currentTarget as HTMLButtonElement).getAttribute('data-section');
				if (section) {
					activeEditSection = section as any;
					if (section === 'items') {
						const order = orders.find(o => o.id === currentEditingOrderId);
						if (order) {
							editItemsStaged = order.items.map(it => ({
								name: it.name,
								quantity: it.quantity,
								price: it.price,
								total: it.total,
								customInclusions: it.customInclusions ? [...it.customInclusions] : []
							}));
						}
					}
					renderDetailsModalContent();
				}
			});
		});

		// Cancel Edit buttons click
		modal.querySelectorAll('.btn-cancel-edit').forEach(btn => {
			btn.addEventListener('click', () => {
				activeEditSection = null;
				renderDetailsModalContent();
			});
		});

		// 1. Save Customer Info Form
		const customerForm = document.getElementById('edit-customer-form');
		customerForm?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const id = currentEditingOrderId;
			if (!id) return;
			const order = orders.find(o => o.id === id);
			if (!order) return;

			const name = (document.getElementById('edit-customer-name') as HTMLInputElement).value.trim();
			const fulfillmentType = (document.getElementById('edit-fulfillment-type') as HTMLSelectElement).value;
			const status = (document.getElementById('edit-order-status') as HTMLSelectElement).value;
			const address = (document.getElementById('edit-customer-address') as HTMLInputElement).value.trim();
			const rawContact = (document.getElementById('edit-customer-contact') as HTMLInputElement).value.trim();
			const contact = rawContact ? normalizePhMobile(rawContact) : '';
			if (contact && !isValidPhMobile(contact)) {
				showToast('Contact number must be an 11-digit mobile number starting with 09 (e.g. 09171234567).');
				return;
			}
			const facebookName = (document.getElementById('edit-facebook-name') as HTMLInputElement).value.trim();
			const deliveryDateTime = (document.getElementById('edit-delivery-datetime') as HTMLInputElement).value;
			const formattedDelivery = deliveryDateTime ? deliveryDateTime.replace('T', ' ') : '';

			const orderUpdates = {
				customer: name,
				fulfillment_type: fulfillmentType || null, // empty = customer chooses
				status: status,
				address: address,
				contact: contact,
				facebook_name: facebookName || null,
				delivery_date_time: formattedDelivery || null
			};

			try {
				const resp = await fetch('/api/update-order', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id, orderUpdates })
				});
				if (!resp.ok) {
					showToast('Failed to update customer details.');
					return;
				}
				// Update local state
				order.customer = name;
				order.fulfillmentType = (fulfillmentType || undefined) as any;
				order.status = status as any;
				order.address = address;
				order.contact = contact;
				order.facebookName = facebookName;
				order.deliveryDateTime = formattedDelivery;

				activeEditSection = null;
				updateDashboard();
				renderDetailsModalContent();
				showToast('Customer details updated!');
			} catch (err) {
				console.error(err);
				showToast('Error updating customer details.');
			}
		});

		// 2. Save Payment Form
		const paymentForm = document.getElementById('edit-payment-form');
		paymentForm?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const id = currentEditingOrderId;
			if (!id) return;
			const order = orders.find(o => o.id === id);
			if (!order) return;

			const deliveryFee = parseFloat((document.getElementById('edit-delivery-fee') as HTMLInputElement).value) || 0;
			const downpayment = parseFloat((document.getElementById('edit-downpayment') as HTMLInputElement).value) || 0;

			const itemsTotal = order.items.reduce((s, it) => s + it.total, 0);
			const total = parseFloat((itemsTotal + deliveryFee).toFixed(2));
			const balance = parseFloat((total - downpayment).toFixed(2));

			const orderUpdates = {
				delivery_fee: deliveryFee,
				downpayment: downpayment,
				total: total,
				balance: balance
			};

			try {
				const resp = await fetch('/api/update-order', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id, orderUpdates })
				});
				if (!resp.ok) {
					showToast('Failed to update payment details.');
					return;
				}
				// Update local state
				order.deliveryFee = deliveryFee;
				order.downpayment = downpayment;
				order.total = total;
				order.balance = balance;

				activeEditSection = null;
				updateDashboard();
				renderDetailsModalContent();
				showToast('Payment breakdown updated!');
			} catch (err) {
				console.error(err);
				showToast('Error updating payments.');
			}
		});

		// 3. Save Items Form
		const itemsForm = document.getElementById('edit-items-form');
		itemsForm?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const id = currentEditingOrderId;
			if (!id) return;
			const order = orders.find(o => o.id === id);
			if (!order) return;

			// Extract list of items from staged items directly
			const updatedItems: OrderItem[] = editItemsStaged.map(it => ({
				name: it.name,
				quantity: it.quantity,
				price: it.price,
				total: parseFloat((it.quantity * it.price).toFixed(2)),
				customInclusions: it.customInclusions || []
			}));

			if (updatedItems.length === 0) {
				showToast('An order must have at least one item.');
				return;
			}

			// Recompute order totals
			const itemsTotal = updatedItems.reduce((s, it) => s + it.total, 0);
			const deliveryFee = order.deliveryFee || 0;
			const total = parseFloat((itemsTotal + deliveryFee).toFixed(2));

			// While awaiting customer details, the downpayment is still the requested default %
			// (not yet paid), so keep it in sync with the new total.
			const isPendingCustomer = (order.customer || '').trim() === 'Pending Customer Details' ||
				(order.customer || '').trim() === '' ||
				!order.deliveryDateTime;
			let downpayment = order.downpayment;
			if (isPendingCustomer) {
				const s = loadSettings();
				const factor = (s.dpPct !== undefined ? s.dpPct : 50) / 100;
				downpayment = parseFloat((total * factor).toFixed(2));
			}
			const balance = parseFloat((total - downpayment).toFixed(2));

			const orderUpdates = {
				total: total,
				downpayment: downpayment,
				balance: balance
			};

			try {
				const resp = await fetch('/api/update-order', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id, orderUpdates, items: updatedItems })
				});
				if (!resp.ok) {
					showToast('Failed to update items.');
					return;
				}
				// Update local state
				order.items = updatedItems;
				order.total = total;
				order.downpayment = downpayment;
				order.balance = balance;

				activeEditSection = null;
				updateDashboard();
				renderDetailsModalContent();
				showToast('Items breakdown updated!');
			} catch (err) {
				console.error(err);
				showToast('Error updating items.');
			}
		});

		// Dynamic list actions for Items Edit Mode
		const btnAddEditItem = document.getElementById('btn-add-edit-item');
		btnAddEditItem?.addEventListener('click', () => {
			editItemsStaged.push({
				name: '',
				quantity: 1,
				price: 0,
				total: 0,
				customInclusions: []
			});
			renderDetailsModalContent();
			// Focus new item select
			const selects = modal.querySelectorAll('.edit-item-select');
			if (selects.length > 0) {
				(selects[selects.length - 1] as HTMLSelectElement).focus();
			}
		});

		modal.querySelectorAll('.btn-remove-edit-item').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const idxStr = (e.currentTarget as HTMLButtonElement).getAttribute('data-idx');
				if (idxStr !== null) {
					const idx = parseInt(idxStr);
					editItemsStaged.splice(idx, 1);
					renderDetailsModalContent();
				}
			});
		});

		// Sync changes from inputs back to stage list (on input to preserve focus)
		modal.querySelectorAll('.edit-item-qty').forEach(input => {
			input.addEventListener('input', (e) => {
				const row = (e.currentTarget as HTMLElement).closest('.edit-item-row');
				if (!row) return;
				const idx = parseInt(row.getAttribute('data-idx') || '0');
				const qty = parseInt((e.currentTarget as HTMLInputElement).value) || 1;
				editItemsStaged[idx].quantity = qty;
				editItemsStaged[idx].total = parseFloat((qty * editItemsStaged[idx].price).toFixed(2));
			});
		});

		modal.querySelectorAll('.edit-item-price').forEach(input => {
			input.addEventListener('input', (e) => {
				const row = (e.currentTarget as HTMLElement).closest('.edit-item-row');
				if (!row) return;
				const idx = parseInt(row.getAttribute('data-idx') || '0');
				const price = parseFloat((e.currentTarget as HTMLInputElement).value) || 0;
				editItemsStaged[idx].price = price;
				editItemsStaged[idx].total = parseFloat((editItemsStaged[idx].quantity * price).toFixed(2));
			});
		});

		modal.querySelectorAll('.edit-item-name').forEach(input => {
			input.addEventListener('input', (e) => {
				const row = (e.currentTarget as HTMLElement).closest('.edit-item-row');
				if (!row) return;
				const idx = parseInt(row.getAttribute('data-idx') || '0');
				editItemsStaged[idx].name = (e.currentTarget as HTMLInputElement).value.trim();
			});
		});

		// Dropdown select change handler
		modal.querySelectorAll('.edit-item-select').forEach(select => {
			select.addEventListener('change', (e) => {
				const target = e.currentTarget as HTMLSelectElement;
				const idx = parseInt(target.getAttribute('data-idx') || '0');
				const selectedValue = target.value;
				
				if (selectedValue === 'Custom Item') {
					editItemsStaged[idx].name = '';
					editItemsStaged[idx].price = 0;
					editItemsStaged[idx].customInclusions = [];
				} else {
					editItemsStaged[idx].name = selectedValue;
					const selectedOption = target.options[target.selectedIndex];
					const price = parseFloat(selectedOption.getAttribute('data-price') || '0');
					editItemsStaged[idx].price = price;
					// Fetch standard inclusions
					const stdInclusions = getInclusionsForForm(selectedValue);
					editItemsStaged[idx].customInclusions = stdInclusions ? [...stdInclusions] : [];
				}
				editItemsStaged[idx].total = parseFloat((editItemsStaged[idx].quantity * editItemsStaged[idx].price).toFixed(2));
				
				renderDetailsModalContent();
			});
		});

		// Inclusion inputs change (on input to preserve focus)
		modal.querySelectorAll('.edit-inclusion-input').forEach(input => {
			input.addEventListener('input', (e) => {
				const target = e.currentTarget as HTMLInputElement;
				const itemIdx = parseInt(target.getAttribute('data-item-idx') || '0');
				const incIdx = parseInt(target.getAttribute('data-inc-idx') || '0');
				if (editItemsStaged[itemIdx] && editItemsStaged[itemIdx].customInclusions) {
					editItemsStaged[itemIdx].customInclusions[incIdx] = target.value;
				}
			});
		});

		// Add Inclusion from the menu dropdown
		modal.querySelectorAll('.edit-inclusion-picker').forEach(select => {
			select.addEventListener('change', (e) => {
				const target = e.currentTarget as HTMLSelectElement;
				const itemIdx = parseInt(target.getAttribute('data-item-idx') || '0');
				const value = target.value;
				target.value = '';
				if (!value || !editItemsStaged[itemIdx]) return;
				if (!editItemsStaged[itemIdx].customInclusions) {
					editItemsStaged[itemIdx].customInclusions = [];
				}
				editItemsStaged[itemIdx].customInclusions.push(value);
				renderDetailsModalContent();
			});
		});

		// Add Inclusion Click Handler (blank row the owner types into)
		modal.querySelectorAll('.btn-add-edit-inclusion').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const target = e.currentTarget as HTMLButtonElement;
				const itemIdx = parseInt(target.getAttribute('data-item-idx') || '0');
				if (!editItemsStaged[itemIdx].customInclusions) {
					editItemsStaged[itemIdx].customInclusions = [];
				}
				editItemsStaged[itemIdx].customInclusions.push('');
				
				renderDetailsModalContent();
				
				// Focus the new inclusion input
				const newIncIdx = editItemsStaged[itemIdx].customInclusions.length - 1;
				const inputToFocus = modal.querySelector(`.edit-inclusion-input[data-item-idx="${itemIdx}"][data-inc-idx="${newIncIdx}"]`) as HTMLInputElement;
				inputToFocus?.focus();
			});
		});

		// Remove Inclusion Click Handler
		modal.querySelectorAll('.btn-remove-edit-inclusion').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const target = e.currentTarget as HTMLButtonElement;
				const itemIdx = parseInt(target.getAttribute('data-item-idx') || '0');
				const incIdx = parseInt(target.getAttribute('data-inc-idx') || '0');
				if (editItemsStaged[itemIdx] && editItemsStaged[itemIdx].customInclusions) {
					editItemsStaged[itemIdx].customInclusions.splice(incIdx, 1);
				}
				renderDetailsModalContent();
			});
		});
	}

	function bindModalActionButtons() {
		const modal = document.getElementById('details-modal-body');
		if (!modal) return;

		// Prepare Button
		modal.querySelectorAll('.btn-prepare').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (!id) return;
				const confirmed = await showConfirm(`Are you sure you want to mark Order #${id.replace('ORD-', '')} as Preparing?`);
				if (confirmed) {
					await updateOrderStatus(id, 'Preparing');
					renderDetailsModalContent();
				}
			});
		});

		// Complete Button
		modal.querySelectorAll('.btn-complete').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (!id) return;
				const confirmed = await showConfirm(`Are you sure you want to mark Order #${id.replace('ORD-', '')} as Completed?`);
				if (confirmed) {
					await updateOrderStatus(id, 'Completed');
					const detailsModalOverlay = document.getElementById('details-modal-overlay');
					detailsModalOverlay?.classList.remove('active');
				}
			});
		});

		// Cancel Button
		modal.querySelectorAll('.btn-cancel').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (!id) return;
				const confirmed = await showConfirm(`Are you sure you want to cancel Order #${id.replace('ORD-', '')}?`);
				if (confirmed) {
					await updateOrderStatus(id, 'Cancelled');
					const detailsModalOverlay = document.getElementById('details-modal-overlay');
					detailsModalOverlay?.classList.remove('active');
				}
			});
		});

		// Delete Button
		modal.querySelectorAll('.btn-delete').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (!id) return;
				const confirmed = await showConfirm(`Are you sure you want to delete the record for Order #${id.replace('ORD-', '')}?`);
				if (confirmed) {
					await deleteOrder(id);
					const detailsModalOverlay = document.getElementById('details-modal-overlay');
					detailsModalOverlay?.classList.remove('active');
				}
			});
		});

		// Copy Confirmation Slip Button
		modal.querySelectorAll('.btn-copy-slip').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (id) {
					copyConfirmationSlip(id, e.currentTarget as HTMLButtonElement);
				}
			});
		});

		// Get Customer Share Link Button
		modal.querySelectorAll('.btn-get-link').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (id) {
					const sig = getOrderSignature(id);
					const settingsParam = getSettingsParam();
					const uniqueLink = window.location.origin + '/order?id=' + id + '&t=' + sig + settingsParam;
					const messageText = getCustomerCopyMessage(uniqueLink);
					navigator.clipboard.writeText(messageText).then(() => {
						const target = e.currentTarget as HTMLButtonElement;
						target.classList.add('copied');
						const oldHTML = target.innerHTML;
						target.innerHTML = `
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
							<span>Copied!</span>
						`;
						showToast('Customer share link copied to clipboard!');
						// persist copied state
						try { localStorage.setItem('copied_link_' + id, '1'); } catch (e) {}
						// also update the table action button if present
						const tableBtn = document.querySelector('.btn-get-link[data-id="' + id + '"]') as HTMLButtonElement;
						if (tableBtn) {
							const old = tableBtn.innerHTML;
							tableBtn.classList.add('copied');
							tableBtn.innerHTML = `\n\t\t\t\t<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>\n\t\t\t\t<span>Copied!</span>\n\t\t\t`;
							setTimeout(() => {
								tableBtn.classList.remove('copied');
								tableBtn.innerHTML = old;
							}, 2000);
						}
						setTimeout(() => {
							target.classList.remove('copied');
							target.innerHTML = oldHTML;
						}, 2000);
					}).catch(err => {
						console.error('Could not copy link to clipboard: ', err);
					});
				}
			});
		});

		// Download Receipt Button
		modal.querySelectorAll('.btn-download-receipt').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id');
				if (id) {
					downloadReceipt(id);
				}
			});
		});

		// Save Owner Note (localStorage) - visible only to owner/admin in UI
		const saveNoteBtn = modal.querySelector('#save-note-btn') as HTMLButtonElement | null;
		if (saveNoteBtn) {
			saveNoteBtn.addEventListener('click', async (e) => {
				const id = (e.currentTarget as HTMLButtonElement).getAttribute('data-id') || currentEditingOrderId;
				if (!id) return;
				const ta = modal.querySelector('#owner-note') as HTMLTextAreaElement | null;
				if (!ta) return;
				const val = ta.value.trim();
				// Persist to backend via existing update-order API
				try {
					const resp = await fetch('/api/update-order', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ id, orderUpdates: { note: val } })
					});
					if (!resp.ok) { showToast('Failed to save note.'); return; }
					// Update local state
					const ord = orders.find(o => o.id === id);
					if (ord) ord.note = val;
					showToast('Note saved (owner only).');
					updateDashboard();
					renderDetailsModalContent();
				} catch (err) {
					console.error('Failed to save note:', err);
					showToast('Failed to save note.');
				}
			});
		}
	}

	function getActionButtonsHTML(order: Order) {
		let actionButtons = '';
		
		// Contextual action buttons based on status
		if (order.status === 'Pending') {
			actionButtons += `
				<button class="action-btn btn-prepare" data-id="${order.id}" title="Start Preparing">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"/><rect width="12" height="8" x="6" y="14" rx="1"/></svg>
					<span>Prepare Order</span>
				</button>
			`;
		} else if (order.status === 'Preparing') {
			actionButtons += `
				<button class="action-btn btn-complete" data-id="${order.id}" title="Complete Order">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
					<span>Complete Order</span>
				</button>
			`;
