// showConfirm: displays the custom confirmation modal and resolves true/false
function showConfirm(message) {
	return new Promise((resolve) => {
		const overlay = document.getElementById('confirm-modal-overlay');
		const msg = document.getElementById('confirm-modal-message');
		const okBtn = document.getElementById('confirm-ok-btn');
		const cancelBtn = document.getElementById('confirm-cancel-btn');
		const closeBtn = document.getElementById('close-confirm-modal-btn');
		if (!overlay || !msg || !okBtn || !cancelBtn) return resolve(false);
		msg.textContent = message || 'Are you sure?';
		overlay.classList.add('active');

		// Accessibility: focus and keyboard handlers
		const prevActive = document.activeElement;
		okBtn.focus();

		const onKey = (e) => {
			if (e.key === 'Escape') { e.preventDefault(); doCancel(); }
			if (e.key === 'Enter') { e.preventDefault(); doOk(); }
		};

		const onOverlayClick = (e) => {
			if (e.target === overlay) doCancel();
		};

		const cleanup = () => {
			overlay.classList.remove('active');
			okBtn.removeEventListener('click', doOk);
			cancelBtn.removeEventListener('click', doCancel);
			closeBtn?.removeEventListener('click', doCancel);
			overlay.removeEventListener('click', onOverlayClick);
			document.removeEventListener('keydown', onKey);
			try { prevActive?.focus(); } catch (e) {}
		};

		const doOk = () => { cleanup(); resolve(true); };
		const doCancel = () => { cleanup(); resolve(false); };

		okBtn.addEventListener('click', doOk);
		cancelBtn.addEventListener('click', doCancel);
		closeBtn?.addEventListener('click', doCancel);
		overlay.addEventListener('click', onOverlayClick);
		document.addEventListener('keydown', onKey);
	});
}

